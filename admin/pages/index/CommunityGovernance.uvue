<template>
  <view class="governance">
    <view class="tools categories">
      <button :class="{ active: category === 'content' }" :disabled="busy" @click="selectCategory('content', 'pending')">帖子与评论<view v-if="hasPending('pending') || hasPending('comments')" class="review-dot" aria-label="有待审内容" /></button>
      <button :class="{ active: category === 'reports' }" :disabled="busy" @click="selectCategory('reports', 'reports')">举报<view v-if="hasPending('reports')" class="review-dot" aria-label="有待处理举报" /></button>
      <button :class="{ active: category === 'records' }" :disabled="busy" @click="selectCategory('records', 'policy')">规则与记录</button>
    </view>
    <view class="tools tabs">
      <button v-for="tab in currentTabs" :key="tab.id" :class="{ selected: group === tab.id }" :disabled="busy" @click="switchTo(tab.id)">{{ tab.label }}<view v-if="hasPending(tab.id)" class="review-dot" aria-label="有待处理事项" /></button>
    </view>
    <view v-if="targetUid.length > 0" class="tools"><text class="muted">当前筛选用户 {{ targetLabel }}</text><button :disabled="busy" @click="clearUser">清除筛选</button></view>
    <view class="tools"><text class="heading">{{ groupName() }}</text><button :disabled="busy" @click="reload">{{ group === 'policy' ? '重新读取规则' : '刷新队列' }}</button></view>
    <text v-if="busy" class="muted">正在处理…</text>
    <text v-if="receipt.length > 0" class="status">{{ receipt }}</text>
    <text v-if="message.length > 0" class="status">{{ message }}</text>
    <view v-if="group === 'policy' && policy != null" class="panel">
      <text class="heading">{{ policy?.canEdit ? '可编辑' : '仅查看' }} · 规则版本 {{ policy?.revision }}</text>
      <view class="tools">
        <view><text>最短间隔（秒）</text><input v-model="minSeconds" type="number" :disabled="busy || !policy?.canEdit" /></view>
        <view><text>每 10 分钟上限</text><input v-model="maxPerWindow" type="number" :disabled="busy || !policy?.canEdit" /></view>
        <view><text>相同内容去重（秒）</text><input v-model="duplicateSeconds" type="number" :disabled="busy || !policy?.canEdit" /></view>
      </view>
      <text class="muted">词库用于评论。拒绝词条阻止发送，待审词条转人工审核。帖子仍逐篇审核。</text>
      <view v-for="(rule, i) in rules" :key="i" class="tools">
        <input v-model="rule.word" placeholder="词条" :maxlength="80" :disabled="busy || !policy?.canEdit" />
        <picker v-if="policy?.canEdit" mode="selector" :range="ruleLabels" :value="policyIndex(rule.action)" :disabled="busy" @change="setRuleAction(i, Number($event.detail.value))">
          <view class="rule-mode">{{ ruleName(rule.action) }} ▾</view>
        </picker>
        <text v-else>{{ ruleName(rule.action) }}</text>
        <button v-if="policy?.canEdit" :disabled="busy" @click="removeRule(i)">删除词条</button>
      </view>
      <view v-if="policy?.canEdit" class="tools">
        <button :disabled="busy" @click="seedPolicy">保存并补充基础屏蔽词</button><button :disabled="busy" @click="addRule">新增词条</button><button :disabled="busy" @click="savePolicy">保存规则</button>
      </view>
    </view>
    <template v-else-if="group !== 'policy'">
      <view class="workspace">
        <view class="panel results">
          <text v-if="!busy && queueState === 'ready' && rows.length === 0 && next.length === 0" class="muted">当前没有记录。</text>
          <button v-for="row in rows" :key="row.id" class="result" :class="{ 'selected-row': selected?.id === row.id }"
            role="button" :tabindex="busy ? -1 : 0" :aria-pressed="selected?.id === row.id" :disabled="busy" @click="select(row)"
            @keydown="activate($event, () => select(row))">
            <text class="heading">{{ row.title || row.action || row.author || (row.commentId ? '评论举报' : '帖子举报') }}</text>
            <text v-if="group !== 'audit' && group !== 'mutes'" class="muted">{{ objectLabel(row) }} · {{ statusName(row.status ?? '') }} · {{ timeLabel(row.createdAt ?? 0) }}<template v-if="row.imageCount != null || row.hasImage"> · {{ row.imageCount ?? 1 }} 张图片</template></text>
            <text class="excerpt">{{ row.body ?? row.reason ?? '' }}</text>
            <text v-if="group === 'audit'" class="muted">{{ timeLabel(row.at ?? 0) }} · 操作人 {{ row.actor }} · 对象 {{ row.target }}</text>
          </button>
          <button v-if="queueState === 'failed'" :disabled="busy" @click="reload">重试读取队列</button>
          <button v-if="next.length > 0 && queueState !== 'failed'" :disabled="busy" @click="more">{{ queueState === 'moreFailed' ? '重试加载更多' : '加载更多' }}</button>
        </view>
        <view v-if="selected != null" class="panel inspector" :class="{ 'review-inspector': reviewQueue }">
          <view class="inspector-content" :key="selected?.id" :tabindex="reviewQueue ? 0 : -1">
          <template v-if="group === 'audit'">
            <text class="heading">{{ selected?.action }}</text>
            <text class="muted">{{ timeLabel(selected?.at ?? 0) }} · 操作人 {{ selected?.actor }}</text>
            <text class="record">对象：{{ selected?.target }}</text>
            <text v-if="selected?.revisionId" class="record">版本：{{ selected?.revisionId }}</text>
            <text v-if="selected?.reason" class="record">原因：{{ selected?.reason }}</text>
            <text v-if="selected?.action === 'policy.save' || selected?.action === 'policy.seed'" class="record">{{ auditText }}</text>
          </template>
          <template v-else>
            <template v-if="group === 'mutes'">
              <text class="heading">{{ selected?.author }} · {{ selected?.status === 'muted' ? '禁言中' : '已到期或解除' }}</text>
              <text v-if="selected?.status === 'muted'" class="record">到期时间 {{ new Date(selected?.until ?? 0).toLocaleString() }}</text>
              <text class="record">{{ selected?.reason }}</text>
            </template>
            <template v-if="group === 'reports' || group === 'resolvedReports'">
              <text class="heading">举报原因</text><text class="record">{{ selected?.reason }}</text>
              <text v-if="selected?.resolution" class="record">处理结果 · {{ selected?.resolution }}</text>
            </template>
            <view v-if="detailFailed" class="tools"><text class="muted">未能读取详情。</text><button :disabled="busy" @click="retryDetail">重试详情</button></view>
            <template v-if="detail != null">
              <text class="heading">{{ detail?.author }} · {{ statusName(detail?.status ?? '') }}</text>
              <text v-if="isReportGroup() && !detail?.reportedRevisionId" class="muted">旧举报未记录版本，无法确认当时的帖子内容。以下版本仅供参考。</text>
              <text v-if="isReportGroup() && currentVersion == null" class="muted">帖子当前无公开版本。</text>
              <view class="versions">
                <view v-if="currentVersion != null && currentVersion?.id !== selectedVersion?.id" class="version">
                  <text class="heading">当前公开版</text>
                  <template v-if="currentVersion != null">
                    <text class="muted">{{ currentVersion?.id }}</text>
                    <text>{{ currentVersion?.title }}</text><text class="record">{{ currentVersion?.body }}</text>
                    <ReviewGallery :key="(detail?.postId ?? '') + '/' + (currentVersion?.id ?? '')"
                      :post-id="detail?.postId ?? ''" :revision-id="currentVersion?.id ?? ''" :image-count="countImages(currentVersion)" />
                  </template>
                </view>
                <view class="version">
                  <text class="heading">{{ selectedVersionLabel }}</text>
                  <text class="muted">{{ statusName(selectedVersion?.status ?? '') }}</text>
                  <text class="muted">{{ selectedVersion?.id }}</text>
                  <text>{{ selectedVersion?.title }}</text><text class="record">{{ selectedVersion?.body }}</text>
                  <text v-if="selectedVersion?.reason" class="muted">{{ selectedVersion?.reason }}</text>
                  <ReviewGallery :key="(detail?.postId ?? '') + '/' + (selectedVersion?.id ?? '')"
                    :post-id="detail?.postId ?? ''" :revision-id="selectedVersion?.id ?? ''" :image-count="countImages(selectedVersion)" />
                </view>
              </view>
            </template>
            <template v-if="comment != null">
              <text class="heading">评论 · {{ comment?.author }} · {{ statusName(comment?.status ?? '') }}</text>
              <text class="record">{{ comment?.body }}</text>
            </template>
            <view v-if="hasContentActions" class="high-impact">
              <text class="heading">内容处置</text>
              <textarea v-model="reason" :disabled="busy" :maxlength="300" placeholder="填写内容处置原因" />
              <view class="tools">
                <button v-if="currentVersion != null" :disabled="busy" @click="reviewPost('remove')">下架当前公开版</button>
                <button v-if="comment?.status === 'public'" :disabled="busy" @click="reviewComment('remove')">移除评论</button>
              </view>
            </view>
            <view v-if="detail?.reportStatus === 'open'" class="high-impact">
              <text class="heading">举报结案</text>
              <text class="muted">结案只记录处理结果及原因。</text>
              <textarea v-model="resolutionReason" :disabled="busy" :maxlength="300" placeholder="填写结案原因" />
              <view class="tools"><button :disabled="busy" @click="resolveReport">{{ resolveLabel }}</button></view>
            </view>
            <view v-if="target().length > 0 && !detailFailed" class="high-impact">
              <text class="heading">账户处罚</text>
              <text class="muted">{{ group === 'mutes' ? '针对账户' : comment != null ? '针对评论作者' : '针对帖子作者' }} · {{ targetName() }}</text>
              <textarea v-model="accountReason" :disabled="busy" :maxlength="300" placeholder="填写账户处罚原因" />
              <view class="tools">
                <view class="duration"><text class="muted">禁言时长（分钟）</text><input v-model="minutes" type="number" :disabled="busy" /></view>
                <button :disabled="busy" @click="mute(false)">{{ group === 'mutes' ? '更新禁言时长' : comment != null ? '禁言评论作者' : '禁言帖子作者' }}</button>
                <button :disabled="busy" @click="mute(true)">解除禁言</button>
              </view>
            </view>
          </template>
          </view>
          <view v-if="canReviewPost || canReviewComment" class="decision-bar">
            <textarea v-if="rejecting" v-model="rejectionReason" :disabled="busy" :maxlength="300" placeholder="填写驳回原因" />
            <view v-if="rejecting" class="tools decision-buttons">
              <button role="button" :tabindex="busy ? -1 : 0" :disabled="busy" @click="cancelReject"
                @keydown="activate($event, cancelReject)">取消</button>
              <button class="danger" role="button" :tabindex="busy ? -1 : 0" :disabled="busy" @click="submitReview('reject')"
                @keydown="activate($event, () => submitReview('reject'))">确认驳回</button>
            </view>
            <view v-else class="tools decision-buttons">
              <button role="button" :tabindex="busy ? -1 : 0" :disabled="busy" @click="beginReject"
                @keydown="activate($event, beginReject)">{{ canReviewPost ? '驳回所选版本' : '驳回评论' }}</button>
              <button class="primary" role="button" :tabindex="canApprove ? 0 : -1" :disabled="!canApprove" @click="submitReview('approve')"
                @keydown="activate($event, () => submitReview('approve'))">{{ canReviewPost ? '通过所选版本' : '通过评论' }}</button>
            </view>
          </view>
        </view>
        <view v-else-if="reviewFinished" class="panel inspector"><text class="muted">没有后续待审记录。</text></view>
      </view>
    </template>
  </view>
</template>

<script setup lang="uts">
import { computed, ref } from 'vue'
import ReviewGallery from './ReviewGallery.uvue'
import { api } from '@/features/api.uts'
import { moderationOverview, refreshModerationOverview } from '@/features/moderation-overview.uts'
type Row = { id: string, title?: string, author?: string, body?: string, status?: string, postId?: string, revisionId?: string, commentId?: string, targetUid?: string, reason?: string, resolution?: string, createdAt?: number, imageCount?: number, hasImage?: boolean, at?: number, until?: number, actor?: string, action?: string, target?: string }
type Revision = { id: string, title: string, body: string, status: string, hasImage: boolean, imageCount?: number, reason: string }
type Detail = { postId: string, status: string, author: string, targetUid: string, latestRevision: string, reportedRevisionId: string, reportStatus: string, selected: Revision, current: Revision | null, reportedComment: Row | null }
type Rule = { word: string, action: string }
type Policy = { revision: number, canEdit: boolean, minSeconds: number, maxPerWindow: number, duplicateSeconds: number, rules: Rule[] }
type Page = { items: Row[], next: string }
const props = defineProps<{ initialGroup: string, targetUid: string, targetLabel: string }>()
const group = ref(props.initialGroup), targetUid = ref(props.targetUid), targetLabel = ref(props.targetLabel)
const contentTabs = [{ id: 'pending', label: '待审帖子' }, { id: 'published', label: '已发布帖子' },
  { id: 'comments', label: '待审评论' }, { id: 'publicComments', label: '公开评论' }]
const reportTabs = [{ id: 'reports', label: '待处理' }, { id: 'resolvedReports', label: '已处理' }]
const recordTabs = [{ id: 'policy', label: '词库与限流' }, { id: 'mutes', label: '禁言记录' }, { id: 'audit', label: '审计记录' }]
const category = computed(() => {
  const value = group.value
  if (reportTabs.some(tab => tab.id === value)) return 'reports'
  return recordTabs.some(tab => tab.id === value) ? 'records' : 'content'
})
const currentTabs = computed(() => category.value === 'reports' ? reportTabs : category.value === 'records' ? recordTabs : contentTabs)
const ruleLabels = ['待审', '拒绝', '允许']
const ruleActions = ['pending', 'reject', 'allow']
function hasPending(groupId: string): boolean {
  const value = moderationOverview.value
  if (value == null || targetUid.value.length > 0) return false
  if (groupId === 'pending') return value.pendingPosts > 0
  if (groupId === 'comments') return value.pendingComments > 0
  return groupId === 'reports' && value.openReports > 0
}
const busy = ref(false), message = ref(''), receipt = ref(''), rows = ref<Row[]>([]), next = ref('')
const selected = ref<Row | null>(null), detail = ref<Detail | null>(null), comment = ref<Row | null>(null)
const currentVersion = computed(() => detail.value?.current ?? null)
const selectedVersion = computed(() => detail.value?.selected ?? null)
const selectedVersionLabel = computed(() => {
  const current = currentVersion.value != null && currentVersion.value.id === selectedVersion.value?.id
  if (isReportGroup()) {
    if (detail.value?.reportedRevisionId) return current ? '当前公开版 · 举报指向版本' : '举报指向版本'
    return current ? '当前公开版（供参考）' : '参考版本'
  }
  return current ? '当前公开版' : '所选版本'
})
const resolveLabel = computed(() => {
  const publicPost = detail.value?.status === 'public' && currentVersion.value != null
  const publicObject = publicPost && (!selected.value?.commentId || comment.value?.status === 'public')
  return publicObject ? '保留内容并结案' : '记录结果并结案'
})
function countImages(version: Revision | null): number { return version?.imageCount ?? (version?.hasImage === true ? 1 : 0) }
const detailFailed = ref(false)
const queueState = ref('loading')
const reviewQueue = computed(() => group.value === 'pending' || group.value === 'comments')
const canReviewPost = computed(() => group.value === 'pending' && detail.value != null && detail.value.selected.id === detail.value.latestRevision &&
  detail.value.selected.status === 'pending' && detail.value.status !== 'removed' && detail.value.status !== 'deleted')
const canReviewComment = computed(() => group.value === 'comments' && comment.value?.status === 'pending')
const canApprove = computed(() => !busy.value && (canReviewPost.value || (canReviewComment.value && currentVersion.value != null)))
const hasContentActions = computed(() => currentVersion.value != null || comment.value?.status === 'public')
const rejecting = ref(false), rejectionReason = ref(''), reviewFinished = ref(false)
let continuation: Row | null = null
const reason = ref(''), minutes = ref('60'), auditText = ref('')
const resolutionReason = ref(''), accountReason = ref('')
const policy = ref<Policy | null>(null), rules = ref<Rule[]>([])
const minSeconds = ref('10'), maxPerWindow = ref('20'), duplicateSeconds = ref('300')
onMounted(() => { reload() })
function groupName(): string {
  switch (group.value) {
    case 'pending': return '待审帖子'
    case 'published': return '已发布帖子'
    case 'comments': return '待审评论'
    case 'publicComments': return '公开评论'
    case 'reports': return '待处理举报'
    case 'resolvedReports': return '已处理举报'
    case 'mutes': return '禁言记录'
    case 'policy': return '词库与限流'
    default: return '审计记录'
  }
}
function statusName(value: string): string {
  switch (value) {
    case 'pending': return '待审核'
    case 'approved': return '已通过'
    case 'public': return '已公开'
    case 'rejected': return '已驳回'
    case 'removed': return '已下架'
    case 'deleted': return '作者已撤下'
    case 'open': return '待处理'
    case 'resolved': return '已处理'
    case 'withdrawn': return '已撤回'
    case 'superseded': return '已有更新版本'
    default: return '未发布'
  }
}
function timeLabel(at: number): string { return at > 0 ? new Date(at).toLocaleString() : '时间未记录' }
function isReportGroup(): boolean { return group.value === 'reports' || group.value === 'resolvedReports' }
function objectLabel(row: Row): string {
  if (isReportGroup()) return row.commentId ? '评论举报' : '帖子举报'
  return group.value === 'comments' || group.value === 'publicComments' ? '评论' : '帖子'
}
function ruleName(value: string): string { return value === 'reject' ? '拒绝' : value === 'pending' ? '待审' : '允许' }
function policyIndex(value: string): number { return Math.max(0, ruleActions.indexOf(value)) }
function setRuleAction(index: number, action: number): void {
  if (!busy.value && policy.value?.canEdit && rules.value[index] != null && ruleActions[action] != null) {
    rules.value[index].action = ruleActions[action]
  }
}
function target(): string { return comment.value?.targetUid ?? detail.value?.targetUid ?? selected.value?.targetUid ?? '' }
function targetName(): string { return comment.value?.author ?? detail.value?.author ?? selected.value?.author ?? '旅伴' }
function clearDetail(): void {
  selected.value = null; detail.value = null; comment.value = null; reason.value = ''; minutes.value = '60'
  resolutionReason.value = ''; accountReason.value = ''
  auditText.value = ''; detailFailed.value = false; reviewFinished.value = false; cancelReject()
}
function cancelReject(): void { rejecting.value = false; rejectionReason.value = '' }
function beginReject(): void { rejecting.value = true }
function activate(event: KeyboardEvent, action: () => void): void {
  if (busy.value || (event.key !== 'Enter' && event.key !== ' ')) return
  event.preventDefault()
  action()
}
function submitReview(decision: string): void {
  if (canReviewPost.value) reviewPost(decision)
  else if (canReviewComment.value && (decision !== 'approve' || currentVersion.value != null)) reviewComment(decision)
}
async function task(work: () => Promise<void>): Promise<void> {
  if (busy.value) return
  busy.value = true; message.value = ''
  try { await work() }
  catch (error) {
    const code = (error as Error).message
    switch (code) {
      case 'FORBIDDEN': message.value = '当前账号没有此权限。'; break
      case 'STALE_VERSION':
      case 'NOT_PENDING':
      case 'NOT_FOUND': detail.value = null; comment.value = null; detailFailed.value = true; cancelReject(); message.value = '记录已变化，请重新读取详情或刷新队列。'; break
      case 'CONFLICT': message.value = '规则已由他人更新。输入已保留，请先备份改动，再重新读取规则。'; break
      case 'INVALID_CONTENT': message.value = '请填写处理原因，最多 300 字。'; break
      case 'INVALID_POLICY': message.value = '请检查词条是否重复、留空，以及频率数字是否有效。'; break
      case 'INVALID_DURATION': message.value = '禁言时间须为 1 至 43200 分钟。'; break
      default: message.value = '操作未完成（' + code + '）。'
    }
  } finally { busy.value = false }
}
async function load(append: boolean): Promise<void> {
  if (group.value === 'policy') {
    const value = await api<Policy>('communityPolicy')
    policy.value = value; rules.value = value.rules
    minSeconds.value = '' + value.minSeconds; maxPerWindow.value = '' + value.maxPerWindow; duplicateSeconds.value = '' + value.duplicateSeconds
    return
  }
  try {
    const result = await api<Page>('communityReviewList', { group: group.value, targetUid: targetUid.value, cursor: append ? next.value : '' })
    rows.value = append ? [...rows.value, ...result.items] : result.items
    next.value = result.next; queueState.value = 'ready'
  } catch (error) {
    queueState.value = append ? 'moreFailed' : 'failed'
    throw error
  }
}
function reload(): void { task(async () => {
  if (continuation != null) await refreshPending()
  else { clearDetail(); await load(false) }
}) }
function clearUser(): void {
  if (busy.value) return
  targetUid.value = ''; targetLabel.value = ''; resetQueue(); reload()
}
function more(): void { task(async () => { await load(true) }) }
function selectCategory(value: string, defaultGroup: string): void {
  if (category.value !== value) switchTo(defaultGroup)
}
function switchTo(value: string): void {
  if (busy.value) return
  if (group.value === value) return
  group.value = value
  resetQueue()
  reload()
}
function resetQueue(): void {
  continuation = null
  rows.value = []; next.value = ''; policy.value = null; receipt.value = ''; queueState.value = 'loading'
}
async function loadSelection(row: Row): Promise<void> {
  clearDetail(); selected.value = row
  if (group.value === 'audit') { auditText.value = JSON.stringify(row, null, 2); return }
  if (group.value === 'mutes') return
  const isComment = group.value === 'comments' || group.value === 'publicComments'
  const isReport = isReportGroup()
  try {
    const value = await api<Detail>('communityReviewDetail', {
      postId: row.postId ?? '', revisionId: row.revisionId ?? '', commentId: isComment ? row.id : row.commentId ?? '',
      reportId: isReport ? row.id : ''
    })
    detail.value = value; comment.value = value.reportedComment
  } catch (_) { detailFailed.value = true }
}
function select(row: Row): void { task(async () => { continuation = null; receipt.value = ''; await loadSelection(row) }) }
function retryDetail(): void {
  const row = selected.value
  if (row != null) task(() => loadSelection(row))
}
function confirm(title: string, targetLabel: string, required: boolean, explanation = reason.value): Promise<boolean> {
  const note = explanation.trim()
  if (required && note.length === 0) throw new Error('INVALID_CONTENT')
  return new Promise<boolean>(resolve => {
    uni.showModal({ title, content: targetLabel + (note.length ? '\n原因：' + note : ''),
      success: result => resolve(result.confirm), fail: () => resolve(false) })
  })
}
function reviewPost(decision: string): void {
  task(async () => {
    const version = decision === 'remove' ? detail.value?.current : detail.value?.selected
    if (version == null) return
    const note = decision === 'reject' ? rejectionReason.value : decision === 'remove' ? reason.value : ''
    if (!await confirm(decision === 'remove' ? '下架公开帖子' : decision === 'approve' ? '通过帖子版本' : '驳回帖子版本',
      (version.title || '无标题帖子') + '\n版本：' + version.id, decision !== 'approve', note)) return
    await api<UTSJSONObject>('communityReviewPost', { postId: detail.value?.postId ?? '', revisionId: version.id, decision, reason: note })
    await afterDecision(decision !== 'remove')
  })
}
function reviewComment(decision: string): void {
  task(async () => {
    const item = comment.value
    if (item == null) return
    const note = decision === 'reject' ? rejectionReason.value : decision === 'remove' ? reason.value : ''
    if (!await confirm(decision === 'remove' ? '移除评论' : decision === 'approve' ? '通过评论' : '驳回评论',
      (item.author ?? '') + '：' + (item.body ?? '').slice(0, 80), decision !== 'approve', note)) return
    await api<UTSJSONObject>('communityReviewComment', { commentId: item.id, decision, reason: note })
    await afterDecision(decision !== 'remove')
  })
}
async function refreshPending(): Promise<void> {
  const reviewed = continuation
  if (reviewed == null) return
  // The queue is sorted by timestamp and then ID, both descending.
  const older = (row: Row): boolean => (row.createdAt ?? 0) < (reviewed.createdAt ?? 0) ||
    ((row.createdAt ?? 0) === (reviewed.createdAt ?? 0) && row.id < reviewed.id)
  try {
    await load(false)
    while (!rows.value.some(older) && next.value.length > 0) await load(true)
  } catch (_) {
    queueState.value = 'failed'; message.value = '审核已记录，队列刷新失败。'
    return
  }
  continuation = null
  rows.value = rows.value.filter(row => row.id !== reviewed.id)
  const following = rows.value.find(older)
  if (following != null) await loadSelection(following)
  else reviewFinished.value = true
}
async function afterDecision(advance: boolean): Promise<void> {
  refreshModerationOverview(true)
  const row = selected.value
  if (advance && reviewQueue.value && row != null) {
    continuation = row
    rows.value = rows.value.filter(item => item.id !== row.id)
    clearDetail()
    receipt.value = '已记录审核结果。'
    await refreshPending()
    return
  }
  await refreshAfterChange('已记录处理结果。', async () => {
    if (isReportGroup() && row != null) await refreshReport(row)
    else { clearDetail(); await load(false) }
  })
}
async function refreshReport(row: Row): Promise<void> {
  await loadSelection(row)
  if (detailFailed.value) message.value = '处理结果已记录，详情暂未刷新，请重试详情。'
}
async function refreshAfterChange(success: string, refresh: () => Promise<void>): Promise<void> {
  receipt.value = success
  try { await refresh() }
  catch (_) {
    clearDetail()
    rows.value = []; next.value = ''; policy.value = null
    message.value = '写入已完成，但读取失败，请刷新恢复。'
  }
}
function resolveReport(): void {
  task(async () => {
    const row = selected.value, item = detail.value
    if (row == null || item?.reportStatus !== 'open') return
    const subject = comment.value != null ? '评论：' + (comment.value?.body ?? '').slice(0, 50) : '帖子：' + (item.selected.title || '无标题')
    const version = item.reportedRevisionId || '旧举报未记录版本'
    const note = resolutionReason.value.trim()
    if (!await confirm(resolveLabel.value, subject + '\n版本：' + version + '\n这一步只记录处理结果，内容和账户状态维持现状。', true, note)) return
    await api<UTSJSONObject>('communityResolveReport', { reportId: row.id, reason: note })
    refreshModerationOverview(true)
    clearDetail()
    await refreshAfterChange('举报已处理。', () => load(false))
  })
}
function mute(release: boolean): void {
  task(async () => {
    const duration = release ? 0 : Number(minutes.value)
    if (!release && (!Number.isInteger(duration) || duration < 1 || duration > 43200)) throw new Error('INVALID_DURATION')
    const note = accountReason.value.trim(), row = selected.value
    if (!await confirm(release ? '解除禁言' : '设置禁言', targetName() + (release ? '' : ' · ' + duration + ' 分钟'), true, note)) return
    const value = await api<{ until: number }>('communityMute', { targetUid: target(), minutes: duration, reason: note })
    const success = value.until > 0 ? '已禁言至 ' + new Date(value.until).toLocaleString() : '已解除禁言。'
    if (group.value === 'mutes') {
      clearDetail()
      await refreshAfterChange(success, () => load(false))
    } else if (isReportGroup() && row != null) {
      receipt.value = success
      await refreshReport(row)
    } else { receipt.value = success; accountReason.value = '' }
  })
}
function seedPolicy(): void {
  task(async () => {
    const result = await api<{ added: number }>('communitySeedPolicy', {
      revision: policy.value?.revision ?? -1, rules: rules.value,
      minSeconds: Number(minSeconds.value), maxPerWindow: Number(maxPerWindow.value), duplicateSeconds: Number(duplicateSeconds.value)
    })
    await refreshAfterChange(result.added > 0 ? '已补充 ' + result.added + ' 条基础词条。' : '当前规则已保存，基础词条已齐全。', () => load(false))
  })
}
function addRule(): void { rules.value = [...rules.value, { word: '', action: 'pending' }] }
function removeRule(index: number): void { rules.value.splice(index, 1) }
function savePolicy(): void {
  task(async () => {
    await api<UTSJSONObject>('communitySavePolicy', { revision: policy.value?.revision ?? -1,
      minSeconds: Number(minSeconds.value), maxPerWindow: Number(maxPerWindow.value),
      duplicateSeconds: Number(duplicateSeconds.value), rules: rules.value })
    await refreshAfterChange('规则已保存。', () => load(false))
  })
}
</script>

<style scoped>
.governance, .panel, .version, .result { display: flex; flex-direction: column; gap: 12px; }
.tools, .workspace, .versions { display: flex; flex-direction: row; gap: 10px; align-items: flex-start; }
.tools { flex-wrap: wrap; align-items: center; }
.tools button { margin: 0; }
.tools button.active { background: #304c37; color: white; }
.categories { padding: 10px; background: #fff; border-radius: 12px; }
.categories button,.tabs button { border: 0; }
.categories button::after,.tabs button::after { border: 0; }
.tabs { padding: 0 0 8px; border-bottom: 1px solid #d9e2d7; }
.tabs button { background: transparent; color: #43554a; }
.tabs button.selected { background: #dae8dd; color: #244132; font-weight: 700; }
.rule-mode { padding: 8px 12px; border: 1px solid #cad6cb; border-radius: 8px; cursor: pointer; }
.review-dot { display:inline-block; width:8px; height:8px; margin-left:8px; vertical-align:middle; border-radius:50%; background:#ce353c; }
.duration { display:flex; flex-direction:column; gap:4px; width:145px; }
.workspace { display: grid; grid-template-columns: minmax(175px, 235px) minmax(0, 1fr); align-items: start; }
.panel { background: #fff; border-radius: 12px; padding: 16px; }
.results, .inspector { min-width: 0; box-sizing: border-box; }
.inspector-content, .high-impact { display:flex; flex-direction:column; gap:12px; min-width:0; }
.review-inspector { position:sticky; top:12px; max-height:calc(100dvh - 350px); min-height:270px; padding:0; gap:0; overflow:hidden; }
.review-inspector .inspector-content { flex:1 1 auto; padding:16px; overflow-y:auto; min-height:0; }
.decision-bar { padding:12px 16px; background:#fff; border-top:1px solid #d9e2d7; display:flex; flex-direction:column; gap:8px; flex-shrink:0; }
.decision-bar textarea { min-height:54px; height:54px; }
.decision-buttons { justify-content:flex-end; }
.decision-bar .danger { background:#a2383d; color:#fff; }
.high-impact { border-top:1px solid #ede8dc; padding-top:12px; }
.version { flex: 1; min-width: min(215px, 100%); box-sizing:border-box; background: #faf7ef; border-radius: 10px; padding: 12px; }
.versions { flex-wrap: wrap; }
.result { width:100%; box-sizing:border-box; background:#f7f7ef; padding:10px 12px; text-align:left; line-height:1.45; overflow-wrap:anywhere; }
.result.selected-row { background:#e1ede2; box-shadow:inset 3px 0 #426240; }
.result::after { border:none; }
.result:focus-visible, .decision-buttons button:focus-visible { outline:2px solid #426240; outline-offset:2px; }
.heading { color: #2c3b28; font-weight: 700; }
.muted { color: #685d53; font-size: 13px; overflow-wrap: anywhere; }
.record, .excerpt { white-space: pre-wrap; overflow-wrap: anywhere; }
.excerpt { max-height: 56px; overflow: hidden; }
.status { color: #784b20; }
input, textarea { background: #f7f4eb; padding: 10px; border-radius: 8px; }
textarea { width: 100%; min-height: 80px; }
@media (max-width: 750px) { .workspace { grid-template-columns: minmax(0, 1fr); } }
</style>
