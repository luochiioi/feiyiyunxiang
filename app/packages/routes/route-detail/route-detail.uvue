<template>
  <view class="screen">
    <AppPageHeader title="路线详情" :show-back="true" />
    <view class="content">
      <DemoNotice />

      <template v-if="route != null">
        <view class="card">
          <image class="cover" src="/packages/routes/static/silk-cover.jpg" mode="aspectFill" />
          <text class="tag">{{ route.region }} · 海丝瓷绣</text>
          <text class="title">{{ route.name }}</text>
          <text class="body">{{ route.description }}</text>
          <text class="muted">探索进度 {{ route.done }} / {{ route.total }}</text>
          <ProgressBar :value="route.done / route.total * 100" color="#52704a" :height="12" :show-label="false" />
        </view>
        <view class="card">
          <text class="heading">探索任务</text>
          <view v-for="node in nodes" :key="node.id" class="row spread divider menu-row" @click="openCheckin(node.id)">
            <text class="body">{{ node.title }}</text><text class="muted">{{ node.checked ? '查看我的打卡' : '去打卡' }} ›</text>
          </view>
        </view>
        <button class="secondary" @click="showOnMap">在地图查看路线</button>
      </template>
      <view v-else class="card"><text class="body">找不到这条路线。</text><button class="secondary" @click="openPage('/packages/routes/routes/routes')">查看路线列表</button></view>
    </view>
  </view>
</template>

<script setup lang="uts">
import AppPageHeader from '@/components/AppPageHeader.uvue'
import DemoNotice from '@/components/DemoNotice.uvue'

import { computed, ref } from 'vue'
import ProgressBar from '@/components/ProgressBar.uvue'
import { findRoute, listNodes, refreshCatalog } from '@/features/exploration/catalog.uts'
import { dispatchMapEvent } from '@/features/exploration/map-store.uts'
import { decodePageId, openCheckin, openPage, returnToMap } from '@/features/navigation.uts'
const id = ref<string | null>(null)
onLoad(query => { id.value = decodePageId(query['routeId'] ?? null) })
const route = computed(() => findRoute(id.value))
const nodes = computed(() => route.value == null ? [] : listNodes(route.value!.id))
onShow(() => { refreshCatalog() })
function showOnMap(): void {
  const item = route.value
  if (item == null) return
  dispatchMapEvent({ type: 'select-route', routeId: item.id, viewport: item.viewport })
  returnToMap()
}
</script>

<style scoped>
@import '@/styles/page.css';

</style>
