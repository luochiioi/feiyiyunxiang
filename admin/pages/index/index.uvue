<template>
  <view class="desktop">
    <view class="sidebar"><image src="/static/aomiao-wave.png" mode="aspectFit" class="pet" /><text class="brand">非遗云享</text><text>运营工作台</text><text class="hint">路线、文化任务与剧情发布</text></view>
    <view class="main">
      <text class="title">{{ session == null ? '管理员登录' : '路线与博物馆' }}</text>
      <text class="message">{{ message }}</text>
      <view v-if="session == null" class="card login">
        <text>管理员账号</text><input v-model="username" placeholder="受控初始化的账号" />
        <text>密码</text><input v-model="password" :password="true" placeholder="管理员密码" />
        <button class="primary" :disabled="busy" @click="signIn">{{ busy ? '登录中…' : '登录工作台' }}</button>
        <text class="hint">使用单独开通的后台管理员账号登录。</text>
      </view>
      <template v-else>
        <view class="toolbar"><button @click="load">刷新草稿</button><button @click="newDraft">新建开发测试路线</button><button :disabled="busy" @click="showAccountForm">修改登录账号或密码</button><button :disabled="busy" @click="signOut">退出</button></view>
        <view v-if="editingAccount" class="card account-form">
          <text class="heading">修改管理员登录信息</text>
          <text>登录账号（3–40 字符）</text><input v-model="newUsername" :maxlength="40" :disabled="busy" />
          <text>当前密码</text><input v-model="currentPassword" :password="true" :maxlength="256" :disabled="busy" />
          <text>新密码（10–128 字符，可留空）</text><input v-model="newPassword" :password="true" :maxlength="128" :disabled="busy" />
          <template v-if="newPassword.length > 0">
            <text>确认新密码</text><input v-model="confirmPassword" :password="true" :maxlength="128" :disabled="busy" />
          </template>
          <text class="hint">保存后，各设备需要重新登录。请先保存正在编辑的路线草稿。</text>
          <view class="toolbar">
            <button class="primary" :disabled="busy" @click="saveAccount">保存登录信息</button>
            <button :disabled="busy" @click="closeAccountForm">取消</button>
          </view>
        </view>
        <view class="workspace">
          <view class="list card"><view v-for="item in drafts" :key="item.id" class="list-item" @click="edit(item)"><text>{{ item.name }}</text><text class="hint">{{ item.region }} · 草稿 v{{ item.revision }}</text></view><text v-if="drafts.length === 0">暂无草稿</text></view>
          <view v-if="editing" class="card editor">
            <text class="heading">{{ draft.name }} · 修订 {{ draft.revision }}</text>
            <text>路线编号（新建后固定）</text><input v-model="draft.id" :disabled="draft.revision > 0" />
            <text>路线名称</text><input v-model="draft.name" />
            <text>地区</text><input v-model="draft.region" />
            <text>路线说明</text><textarea v-model="draft.description" />
            <text>博物馆名称</text><input v-model="draft.museum.name" />
            <text>博物馆介绍</text><textarea v-model="draft.museum.description" />
            <text class="hint">当前仅允许发布醒目标识的开发测试内容。正式馆方资料核实与生产内容审批仍待完成。</text>
            <view v-for="(node, index) in draft.nodes" :key="index" class="node">
              <text class="heading">节点 {{ index + 1 }}</text><text>节点编号</text><input v-model="node.id" />
              <text>名称</text><input v-model="node.title" /><text>要求</text><textarea v-model="node.description" />
              <view class="coords"><view><text>GCJ-02 纬度</text><input type="digit" :value="'' + node.latitude" @input="node.latitude = numeric($event.detail.value)" /></view><view><text>GCJ-02 经度</text><input type="digit" :value="'' + node.longitude" @input="node.longitude = numeric($event.detail.value)" /></view><view><text>范围（10–500 米）</text><input type="number" :value="'' + node.radius" @input="node.radius = numeric($event.detail.value)" /></view></view>
              <button :disabled="busy" @click="removeNode(index)">删除节点</button>
            </view>
            <button :disabled="busy" @click="addNode">增加定位照片节点</button>
            <text class="heading">文化任务与剧情</text>
            <text class="hint">选填。可从模板载入可编辑的 JSON。after 使用上面的打卡节点编号，空数组表示没有打卡门槛。正式配图、馆藏资料和文化文案待校订。</text>
            <textarea class="content-source" v-model="cultureSource" :maxlength="-1" placeholder="文化内容 JSON" />
            <view class="toolbar">
              <button :disabled="busy" @click="fillMacau">载入澳门模板</button>
              <button :disabled="busy" @click="fillHunan">载入湖南模板</button>
              <button v-if="draft.testOnly" :disabled="busy" @click="fillCombined">在本路线合并两地任务</button>
              <button :disabled="busy" @click="validatePreview">校验并预览当前编辑</button>
            </view>
            <view v-if="draft.cultureUpgrade != null" class="node">
              <text class="heading">沿用已有探索的打卡进度</text>
              <text class="hint">可填最多两个联调路线编号，用逗号分隔。相同任务的配色作品、答题和已读进度将转入本路线。</text>
              <input v-model="cultureSourceRoutes" placeholder="来源路线编号（选填）" />
            </view>
            <ContentPreview v-if="preview != null" :key="previewId" :value="preview" />
            <view class="toolbar"><button class="primary" :disabled="busy" @click="save">保存草稿</button><button :disabled="busy || draft.revision === 0" @click="publish">发布已保存修订</button></view>
            <text class="hint">{{ draft.cultureUpgrade != null ? '已有探索会加入这次发布的文化任务，沿用原有地图点位和打卡记录。' : '发布后生成固定版本，正在探索的用户继续使用原版本。' }}</text>
          </view>
        </view>
      </template>
    </view>
  </view>
</template>
<script setup lang="uts">
import { ref } from 'vue'
import { api, session, AdminSession } from '@/features/api.uts'
import ContentPreview from './ContentPreview.uvue'
import { combinedContent, macauContent, hunanContent } from '@/features/stage-three-content.uts'
import type { DraftNode, DraftPreview } from '@/features/stage-three-content.uts'
type Museum = { name: string, description: string }
type Viewport = { latitude: number, longitude: number, scale: number }
type Draft = { id: string, name: string, region: string, description: string, revision: number, testOnly: boolean, museum: Museum, viewport: Viewport, nodes: DraftNode[], cultureUpgrade?: string[] | null }
const username = ref(''), password = ref(''), busy = ref(false), message = ref('')
const editingAccount = ref(false), newUsername = ref('')
const currentPassword = ref(''), newPassword = ref(''), confirmPassword = ref('')
const drafts = ref<Draft[]>([])
const editing = ref(false)
const cultureSource = ref('')
const cultureSourceRoutes = ref('')
const preview = ref<DraftPreview | null>(null)
const previewId = ref(0)
let savedPayload = ''
const draft = ref<Draft>({ id: '', name: '', region: '', description: '', revision: 0, testOnly: true, museum: { name: '', description: '' }, viewport: { latitude: 0, longitude: 0, scale: 16 }, nodes: [] })
function numeric(value: string): number { return Number(value) }
async function signIn(): Promise<void> { if (busy.value) return; busy.value = true; try { session.value = await api<AdminSession>('adminLogin', { username: username.value, password: password.value }); password.value = ''; await load() } catch (_) { message.value = '登录失败，请检查账号、密码或云端配置。' } finally { busy.value = false } }
async function signOut(): Promise<void> { try { await api<UTSJSONObject>('adminLogout'); session.value = null; editing.value = false; drafts.value = []; closeAccountForm() } catch (_) { message.value = '退出未完成，请重试。' } }
function showAccountForm(): void {
  message.value = ''
  newUsername.value = session.value?.username ?? username.value
  editingAccount.value = true
}
function closeAccountForm(): void {
  newUsername.value = ''
  currentPassword.value = ''
  newPassword.value = ''
  confirmPassword.value = ''
  editingAccount.value = false
}
async function saveAccount(): Promise<void> {
  if (busy.value) return
  const loginName = newUsername.value.trim()
  if (!/^[A-Za-z0-9_-]{3,40}$/.test(loginName)) {
    message.value = '账号需为 3–40 个英文字母、数字、下划线或连字符。'
    return
  }
  if (currentPassword.value.length === 0) {
    message.value = '请输入当前密码确认修改。'
    return
  }
  const changingPassword = newPassword.value.length > 0
  if (changingPassword && (newPassword.value.length < 10 || newPassword.value.length > 128 || newPassword.value.trim().length === 0)) {
    message.value = '新密码应为 10–128 字符。'
    return
  }
  if (changingPassword && newPassword.value !== confirmPassword.value) {
    message.value = '两次输入的新密码不一致。'
    return
  }
  busy.value = true
  try {
    const payload: UTSJSONObject = { currentPassword: currentPassword.value, newUsername: loginName }
    if (changingPassword) payload['newPassword'] = newPassword.value
    await api<UTSJSONObject>('adminUpdateCredentials', payload)
    session.value = null
    username.value = loginName
    editing.value = false
    drafts.value = []
    message.value = '登录信息已更新，请重新登录。'
    closeAccountForm()
  } catch (error) {
    const code = (error as Error | null)?.message ?? ''
    if (code === 'PASSWORD_INCORRECT') message.value = '当前密码不正确。'
    else if (code === 'PASSWORD_UNCHANGED') message.value = '请设置与当前密码不同的新密码。'
    else if (code === 'INVALID_PASSWORD') message.value = '新密码应为 10–128 字符。'
    else if (code === 'USERNAME_TAKEN') message.value = '这个账号已被使用，请换一个。'
    else if (code === 'INVALID_USERNAME') message.value = '账号格式不正确。'
    else if (code === 'CREDENTIALS_UNCHANGED') message.value = '请输入要修改的账号或新密码。'
    else if (code === 'RATE_LIMITED') message.value = '尝试次数过多，请稍后再试。'
    else if (code === 'AUTH_REQUIRED') { message.value = '登录已过期，请重新登录后修改。'; closeAccountForm() }
    else message.value = '暂未确认修改结果，请重新登录核对。'
  } finally { busy.value = false }
}
async function load(): Promise<void> { try { drafts.value = await api<Draft[]>('drafts'); message.value = '' } catch (_) { message.value = '读取失败或会话已过期。编辑内容仍保留。' } }
function edit(item: Draft): void {
  if (busy.value) return
  const raw = JSON.stringify(item)
  draft.value = JSON.parse<Draft>(raw)!
  const value = JSON.parse<UTSJSONObject>(raw)!['culture']
  cultureSource.value = value == null ? '' : JSON.stringify(value, null, 2)
  cultureSourceRoutes.value = draft.value.cultureUpgrade?.join(', ') ?? ''
  preview.value = null
  savedPayload = JSON.stringify(draftPayload())
  editing.value = true
}
function newDraft(): void {
  if (busy.value) return
  draft.value = { id: 'route-' + Date.now(), name: '开发测试路线', region: '澳门', description: '仅用于开发联调，不代表真实馆方路线', revision: 0, testOnly: true, museum: { name: '开发测试馆', description: '资料待核实' }, viewport: { latitude: 0, longitude: 0, scale: 16 }, nodes: [] }
  cultureSource.value = ''
  cultureSourceRoutes.value = ''
  savedPayload = ''
  preview.value = null
  editing.value = true
  addNode()
}
function fillMacau(): void {
  const nodes = draft.value.nodes
  if (nodes.length === 0) { message.value = '澳门模板需要至少一个打卡节点。'; return }
  draft.value.region = '澳门'
  draft.value.cultureUpgrade = null
  cultureSource.value = JSON.stringify(macauContent(nodes.map(node => node.id)), null, 2)
  preview.value = null
  message.value = '已载入澳门开发模板，请核对打卡坐标后校验。'
}
function fillHunan(): void {
  const nodes = draft.value.nodes
  if (nodes.length === 0) { message.value = '湖南模板需要至少一个打卡节点。'; return }
  draft.value.region = '湖南'
  draft.value.cultureUpgrade = null
  cultureSource.value = JSON.stringify(hunanContent(), null, 2)
  preview.value = null
  message.value = '已载入湖南开发模板，请核对打卡坐标后校验。'
}
function fillCombined(): void {
  const nodes = draft.value.nodes
  if (nodes.length === 0) { message.value = '合并模板需要至少一个打卡节点。'; return }
  draft.value.cultureUpgrade = []
  cultureSource.value = JSON.stringify(combinedContent(nodes.map(node => node.id)), null, 2)
  preview.value = null
  message.value = '已载入两地文化任务。校验后可在本路线预览第二至六幕。'
}
function addNode(): void { draft.value?.nodes.push({ id: 'node-' + Date.now(), title: '测试节点', description: '定位与照片', latitude: 0, longitude: 0, radius: 100 }) }
function removeNode(index: number): void { draft.value?.nodes.splice(index, 1) }
function draftPayload(): UTSJSONObject {
  const value = draft.value
  const first = value.nodes[0]
  const payload = JSON.parse<UTSJSONObject>(JSON.stringify(value))!
  if (value.cultureUpgrade != null) {
    payload['cultureUpgrade'] = cultureSourceRoutes.value.split(/[,，]/).map(id => id.trim()).filter(id => id.length > 0)
  }
  if (first != null) payload['viewport'] = { ...value.viewport, latitude: first.latitude, longitude: first.longitude }
  const source = cultureSource.value.trim()
  if (source.length === 0) { payload['culture'] = null; return payload }
  try {
    const content = JSON.parse<UTSJSONObject>(source)
    if (content == null) throw new Error('INVALID_CONTENT_JSON')
    payload['culture'] = content
  } catch (_) { throw new Error('INVALID_CONTENT_JSON') }
  return payload
}
function contentError(error: any): string {
  const code = (error as Error | null)?.message ?? ''
  if (code === 'CONFLICT') return '草稿修订冲突，请刷新并重新载入。'
  if (code === 'INVALID_CONTENT_JSON') return '文化内容需要有效的 JSON 对象。'
  if (code.endsWith('_GATE')) return '解锁条件引用了无效或重复的打卡节点，或缺少本幕对应的文化任务。'
  if (code === 'INVALID_SCENE_GRAPH') return '检查起始场景、跳转目标、循环和不可达场景。'
  if (code === 'INVALID_SCENE') return '场景编号、正文、类型或素材引用有误。当前可使用素材编号 aomiao。'
  if (code === 'INVALID_QUIZ_ANSWER') return '辨认题选项编号必须唯一，答案须引用一个已有选项。'
  if (code === 'INVALID_CULTURE_UPGRADE') return '请核对开发测试状态、两地合并模板及来源路线编号。'
  if (code === 'TEST_CONTENT_DISABLED' || code === 'CONTENT_REVIEW_REQUIRED') return '环境或内容审核条件尚未满足。'
  return '请检查字段、素材和坐标后重试。' + (code.startsWith('INVALID_') ? '（' + code + '）' : '')
}
async function validatePreview(): Promise<void> {
  if (busy.value) return
  busy.value = true
  preview.value = null
  try {
    preview.value = await api<DraftPreview>('previewDraft', draftPayload())
    previewId.value += 1
    message.value = '当前编辑通过校验。预览使用本次校验的内容。'
  } catch (error) { message.value = '校验失败。' + contentError(error) }
  finally { busy.value = false }
}
async function save(): Promise<void> {
  if (busy.value) return
  busy.value = true
  try {
    const payload = draftPayload()
    const result = await api<{ revision: number }>('saveDraft', payload)
    draft.value.revision = result.revision
    payload['revision'] = result.revision
    savedPayload = JSON.stringify(payload)
    message.value = '草稿修订 ' + result.revision + ' 已保存。'
  } catch (error) { message.value = '保存失败。' + contentError(error) }
  finally { busy.value = false }
}
async function publish(): Promise<void> {
  if (busy.value || draft.value.revision === 0) return
  busy.value = true
  try {
    if (savedPayload !== JSON.stringify(draftPayload())) {
      message.value = '编辑内容有改动，请先保存当前修订。'
      return
    }
    const result = await api<{ version: string }>('publish', { id: draft.value.id, revision: draft.value.revision })
    message.value = '已发布修订 ' + draft.value.revision + '（' + result.version.slice(0, 8) + '）。'
  } catch (error) { message.value = '发布未确认。' + contentError(error) }
  finally { busy.value = false }
}
</script>
<style>
page { background:#f3f4ed; color:#35452d; font-size:14px; }
.desktop { min-height:100vh; display:flex; flex-direction:row; }
.sidebar { width:220px; flex-shrink:0; background:#304c37; color:#fff; padding:32px 22px; box-sizing:border-box; display:flex; flex-direction:column; gap:20px; }
.pet { width:110px; height:110px; }
.brand,.title { font-size:25px; font-weight:700; }
.main { padding:32px; flex:1; min-width:0; }
.card { padding:24px; background:#fffef7; border-radius:20px; display:flex; flex-direction:column; gap:12px; }
.login { max-width:440px; margin-top:24px; }
.password-form { max-width:440px; margin-bottom:16px; }
.hint { font-size:12px; opacity:.75; line-height:1.7; }
.message { display:block; padding:12px 0; color:#8b532b; }
.toolbar { display:flex; flex-direction:row; gap:12px; margin:12px 0; flex-wrap:wrap; }
button { margin:0; font-size:14px; }
.primary { background:#426240; color:white; }
.workspace { display:flex; flex-direction:row; gap:20px; align-items:flex-start; }
.list { width:220px; flex-shrink:0; }
.list-item { display:flex; flex-direction:column; padding:12px 0; border-bottom:1px solid #e0e6d6; cursor:pointer; }
.editor { flex:1; min-width:0; }
input,textarea { border:1px solid #d7dfce; padding:10px; box-sizing:border-box; border-radius:9px; width:100%; background:white; }
textarea { height:90px; }
.content-source { height: 240px; font-family: monospace; }
.node { display:flex; flex-direction:column; gap:10px; padding:18px; border:1px solid #e0e6d6; border-radius:12px; }
.coords { display:flex; flex-direction:row; gap:12px; }.coords>view { flex:1; min-width:0; }
.heading { font-weight:700; font-size:16px; }
@media(max-width:1000px) { .sidebar { width:160px; }.workspace { flex-direction:column; }.list { width:100%; }.main { padding:16px; } }
</style>
