<template>
  <view class="desktop">
    <view class="sidebar"><image src="/static/aomiao-wave.png" mode="aspectFit" class="pet" /><text class="brand">非遗云享</text><text>运营工作台 · 阶段二</text><text class="hint">博物馆与路线发布</text><text class="hint">社区审核、剧情、旅伴管理待开发</text></view>
    <view class="main">
      <text class="title">{{ session == null ? '管理员登录' : '路线与博物馆' }}</text>
      <text class="message">{{ message }}</text>
      <view v-if="session == null" class="card login">
        <text>管理员账号</text><input v-model="username" placeholder="受控初始化的账号" />
        <text>密码</text><input v-model="password" :password="true" placeholder="管理员密码" />
        <button class="primary" :disabled="busy" @click="signIn">{{ busy ? '登录中…' : '登录工作台' }}</button>
        <text class="hint">使用单独开通的后台管理员账号登录。</text>
      </view>
      <template v-else>
        <view class="toolbar"><button @click="load">刷新草稿</button><button @click="newDraft">新建开发测试路线</button><button :disabled="busy" @click="showPasswordForm">修改密码</button><button :disabled="busy" @click="signOut">退出</button></view>
        <view v-if="changingPassword" class="card password-form">
          <text class="heading">修改管理员密码</text>
          <text>当前密码</text><input v-model="currentPassword" :password="true" :maxlength="256" :disabled="busy" />
          <text>新密码（16–128 字符）</text><input v-model="newPassword" :password="true" :maxlength="128" :disabled="busy" />
          <text>确认新密码</text><input v-model="confirmPassword" :password="true" :maxlength="128" :disabled="busy" />
          <text class="hint">修改后，需要在各设备上使用新密码重新登录。</text>
          <view class="toolbar">
            <button class="primary" :disabled="busy" @click="savePassword">保存新密码</button>
            <button :disabled="busy" @click="closePasswordForm">取消</button>
          </view>
        </view>
        <view class="workspace">
          <view class="list card"><view v-for="item in drafts" :key="item.id" class="list-item" @click="edit(item)"><text>{{ item.name }}</text><text class="hint">{{ item.region }} · 草稿 v{{ item.revision }}</text></view><text v-if="drafts.length === 0">暂无草稿</text></view>
          <view v-if="editing" class="card editor">
            <text class="heading">{{ draft.name }} · 修订 {{ draft.revision }}</text>
            <text>路线编号（新建后固定）</text><input v-model="draft.id" :disabled="draft.revision > 0" />
            <text>路线名称</text><input v-model="draft.name" />
            <text>地区</text><input v-model="draft.region" />
            <text>路线说明</text><textarea v-model="draft.description" />
            <text>博物馆名称</text><input v-model="draft.museum.name" />
            <text>博物馆介绍</text><textarea v-model="draft.museum.description" />
            <text class="hint">当前仅允许发布醒目标识的开发测试内容。正式馆方资料核实与生产内容审批仍待完成。</text>
            <view v-for="(node, index) in draft.nodes" :key="index" class="node">
              <text class="heading">节点 {{ index + 1 }}</text><text>节点编号</text><input v-model="node.id" />
              <text>名称</text><input v-model="node.title" /><text>要求</text><textarea v-model="node.description" />
              <view class="coords"><view><text>GCJ-02 纬度</text><input type="digit" :value="'' + node.latitude" @input="node.latitude = numeric($event.detail.value)" /></view><view><text>GCJ-02 经度</text><input type="digit" :value="'' + node.longitude" @input="node.longitude = numeric($event.detail.value)" /></view><view><text>范围（10–500 米）</text><input type="number" :value="'' + node.radius" @input="node.radius = numeric($event.detail.value)" /></view></view>
              <button :disabled="busy" @click="removeNode(index)">删除节点</button>
            </view>
            <button :disabled="busy" @click="addNode">增加定位照片节点</button>
            <view class="toolbar"><button class="primary" :disabled="busy" @click="save">保存草稿</button><button :disabled="busy || draft.revision === 0" @click="publish">保存并发布此版本</button></view>
            <text class="hint">发布后生成固定版本；正在探索的用户继续使用原版本。</text>
          </view>
        </view>
      </template>
    </view>
  </view>
</template>
<script setup lang="uts">
import { ref } from 'vue'
import { api, session, AdminSession } from '@/features/api.uts'
type Node = { id: string, title: string, description: string, latitude: number, longitude: number, radius: number }
type Museum = { name: string, description: string }
type Viewport = { latitude: number, longitude: number, scale: number }
type Draft = { id: string, name: string, region: string, description: string, revision: number, testOnly: boolean, museum: Museum, viewport: Viewport, nodes: Node[] }
const username = ref(''), password = ref(''), busy = ref(false), message = ref('')
const changingPassword = ref(false)
const currentPassword = ref(''), newPassword = ref(''), confirmPassword = ref('')
const drafts = ref<Draft[]>([])
const editing = ref(false)
const draft = ref<Draft>({ id: '', name: '', region: '', description: '', revision: 0, testOnly: true, museum: { name: '', description: '' }, viewport: { latitude: 0, longitude: 0, scale: 16 }, nodes: [] })
function numeric(value: string): number { return Number(value) }
async function signIn(): Promise<void> { if (busy.value) return; busy.value = true; try { session.value = await api<AdminSession>('adminLogin', { username: username.value, password: password.value }); password.value = ''; await load() } catch (_) { message.value = '登录失败，请检查账号、密码或云端配置。' } finally { busy.value = false } }
async function signOut(): Promise<void> { try { await api<UTSJSONObject>('adminLogout'); session.value = null; editing.value = false; drafts.value = []; closePasswordForm() } catch (_) { message.value = '退出未完成，请重试。' } }
function showPasswordForm(): void {
  message.value = ''
  changingPassword.value = true
}
function closePasswordForm(): void {
  currentPassword.value = ''
  newPassword.value = ''
  confirmPassword.value = ''
  changingPassword.value = false
}
async function savePassword(): Promise<void> {
  if (busy.value) return
  if (currentPassword.value.length === 0 || newPassword.value.length < 16 || newPassword.value.length > 128 || newPassword.value.trim().length === 0) {
    message.value = '请输入当前密码，并设置 16–128 字符的新密码。'
    return
  }
  if (newPassword.value !== confirmPassword.value) {
    message.value = '两次输入的新密码不一致。'
    return
  }
  busy.value = true
  try {
    await api<UTSJSONObject>('adminChangePassword', { currentPassword: currentPassword.value, newPassword: newPassword.value })
    session.value = null
    editing.value = false
    drafts.value = []
    message.value = '密码已修改，请用新密码重新登录。'
    closePasswordForm()
  } catch (error) {
    const code = (error as Error | null)?.message ?? ''
    if (code === 'PASSWORD_INCORRECT') message.value = '当前密码不正确。'
    else if (code === 'PASSWORD_UNCHANGED') message.value = '请设置与当前密码不同的新密码。'
    else if (code === 'INVALID_PASSWORD') message.value = '新密码应为 16–128 字符。'
    else if (code === 'RATE_LIMITED') message.value = '尝试次数过多，请稍后再试。'
    else if (code === 'AUTH_REQUIRED') { message.value = '登录已过期，请重新登录后修改密码。'; closePasswordForm() }
    else message.value = '暂未确认密码是否修改，请重新登录核对。'
  } finally { busy.value = false }
}
async function load(): Promise<void> { try { drafts.value = await api<Draft[]>('drafts'); message.value = '' } catch (_) { message.value = '读取失败或会话已过期。编辑内容仍保留。' } }
function edit(item: Draft): void { draft.value = JSON.parse<Draft>(JSON.stringify(item))!; editing.value = true }
function newDraft(): void { draft.value = { id: 'route-' + Date.now(), name: '开发测试路线', region: '澳门', description: '仅用于开发联调，不代表真实馆方路线', revision: 0, testOnly: true, museum: { name: '开发测试馆', description: '资料待核实' }, viewport: { latitude: 0, longitude: 0, scale: 16 }, nodes: [] }; editing.value = true; addNode() }
function addNode(): void { draft.value?.nodes.push({ id: 'node-' + Date.now(), title: '测试节点', description: '定位与照片', latitude: 0, longitude: 0, radius: 100 }) }
function removeNode(index: number): void { draft.value?.nodes.splice(index, 1) }
async function saveValue(): Promise<void> {
  if (draft.value == null || draft.value!.nodes.length === 0) throw new Error('INVALID_NODES')
  draft.value!.viewport.latitude = draft.value!.nodes[0].latitude; draft.value!.viewport.longitude = draft.value!.nodes[0].longitude
  const result = await api<{ revision: number }>('saveDraft', JSON.parse<UTSJSONObject>(JSON.stringify(draft.value))!)
  draft.value!.revision = result.revision
}
async function save(): Promise<void> { if (busy.value) return; busy.value = true; try { await saveValue(); message.value = '草稿已保存。' } catch (_) { message.value = '保存失败：请检查必填内容、坐标，或刷新确认修订冲突。当前编辑内容已保留。' } finally { busy.value = false } }
async function publish(): Promise<void> { if (busy.value || draft.value == null) return; busy.value = true; try { await saveValue(); await api<UTSJSONObject>('publish', { id: draft.value!.id, revision: draft.value!.revision }); message.value = '此测试版本已发布。' } catch (_) { message.value = '发布未完成，请核对权限、坐标和修订版本后重试。' } finally { busy.value = false } }
</script>
<style>
page { background:#f3f4ed; color:#35452d; font-size:14px; }
.desktop { min-height:100vh; display:flex; flex-direction:row; }
.sidebar { width:220px; flex-shrink:0; background:#304c37; color:#fff; padding:32px 22px; box-sizing:border-box; display:flex; flex-direction:column; gap:20px; }
.pet { width:110px; height:110px; }
.brand,.title { font-size:25px; font-weight:700; }
.main { padding:32px; flex:1; min-width:0; }
.card { padding:24px; background:#fffef7; border-radius:20px; display:flex; flex-direction:column; gap:12px; }
.login { max-width:440px; margin-top:24px; }
.password-form { max-width:440px; margin-bottom:16px; }
.hint { font-size:12px; opacity:.75; line-height:1.7; }
.message { display:block; padding:12px 0; color:#8b532b; }
.toolbar { display:flex; flex-direction:row; gap:12px; margin:12px 0; flex-wrap:wrap; }
button { margin:0; font-size:14px; }
.primary { background:#426240; color:white; }
.workspace { display:flex; flex-direction:row; gap:20px; align-items:flex-start; }
.list { width:220px; flex-shrink:0; }
.list-item { display:flex; flex-direction:column; padding:12px 0; border-bottom:1px solid #e0e6d6; cursor:pointer; }
.editor { flex:1; min-width:0; }
input,textarea { border:1px solid #d7dfce; padding:10px; box-sizing:border-box; border-radius:9px; width:100%; background:white; }
textarea { height:90px; }
.node { display:flex; flex-direction:column; gap:10px; padding:18px; border:1px solid #e0e6d6; border-radius:12px; }
.coords { display:flex; flex-direction:row; gap:12px; }.coords>view { flex:1; min-width:0; }
.heading { font-weight:700; font-size:16px; }
@media(max-width:1000px) { .sidebar { width:160px; }.workspace { flex-direction:column; }.list { width:100%; }.main { padding:16px; } }
</style>
