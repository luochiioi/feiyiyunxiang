<template>
  <view class="screen">
    <AppPageHeader title="点位详情" :show-back="true" />
    <view class="content">
      <DemoNotice description="验收图钉对应的详情、选中样式和返回。照片与备注为示例，真实打卡待开发。" />

      <template v-if="node != null">
        <view class="card">
          <text class="tag">{{ node.checked ? '已记录 · 示例' : '待探索' }}</text>
          <text class="title">{{ node.title }}</text>
          <text class="body">{{ node.description }}</text>
          <text class="muted">演示点位 · 坐标和打卡范围待内容核实</text>
        </view>
        <view class="card green">
          <text class="heading">我的记录</text>
          <text class="body">{{ node.checked ? '示例备注：记下旅程的第一站。' : '这里会显示你的私密照片和备注。' }}</text>
          <text class="muted">照片默认仅本人可见，可自行选图提交社区审核。</text>
        </view>
        <button v-if="!node.checked" class="primary" @click="checkin">打卡说明 · 待开发</button>
        <button class="secondary" @click="showOnMap">在地图查看</button>
      </template>
      <view v-else class="card"><text class="body">找不到这个点位。</text><button class="secondary" @click="returnToMap">回到地图</button></view>
    </view>
  </view>
</template>

<script setup lang="uts">
import AppPageHeader from '@/components/AppPageHeader.uvue'
import DemoNotice from '@/components/DemoNotice.uvue'

import { computed, ref } from 'vue'
import { findNode, findRoute } from '@/features/exploration/catalog.uts'
import { dispatchMapEvent, mapState } from '@/features/exploration/map-store.uts'
import { openPage, returnToMap } from '@/features/navigation.uts'
const id = ref<string | null>(null)
onLoad(query => { id.value = query['nodeId'] ?? null })
const node = computed(() => findNode(id.value))
function checkin(): void {
  const item = node.value
  if (item != null) openPage('/packages/routes/checkin/checkin?nodeId=' + encodeURIComponent(item.id))
}
function showOnMap(): void {
  const item = node.value
  if (item == null) return
  const route = findRoute(item.routeId)
  if (route == null) return
  if (mapState.value.routeId !== route.id) {
    dispatchMapEvent({ type: 'select-route', routeId: route.id, viewport: route.viewport })
  }
  dispatchMapEvent({ type: 'select-node', nodeId: item.id })
  returnToMap()
}
</script>

<style scoped>
@import '@/styles/page.css';

</style>
