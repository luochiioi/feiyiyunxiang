import { computed, ref, watch } from 'vue'
import { secured, session } from '@/features/api.uts'

export type NotificationItem = { id: string, kind: string, title: string, preview: string, createdAt: number, read: boolean }
export type NotificationTarget = { postId: string, revisionId: string, commentId: string, preview: boolean }
export type NotificationDetail = { id: string, kind: string, title: string, preview: string, createdAt: number, read: boolean, reason: string, target: NotificationTarget | null }
export type NotificationPage = { items: NotificationItem[], next: string }
const owner = ref(''), unread = ref(0)
let sequence = 0
watch(() => session.value?.uid, () => { sequence++; owner.value = ''; unread.value = 0; if (session.value != null) refreshNotificationsSummary() }, { flush: 'sync' })
export const hasUnreadNotifications = computed(() => owner.value === session.value?.uid && unread.value > 0)
export async function refreshNotificationsSummary(): Promise<void> {
  const request = ++sequence, uid = session.value?.uid
  if (uid == null) { owner.value = ''; unread.value = 0; return }
  try {
    const result = await secured<{ unread: number }>('notificationsSummary')
    if (request !== sequence || uid !== session.value?.uid) return
    owner.value = uid; unread.value = result.unread
  } catch (_) { /* Preserve known unread state; retry on next page show. */ }
}
export async function listNotifications(cursor: string): Promise<NotificationPage> {
  return await secured<NotificationPage>('notificationsList', { cursor })
}
export async function loadNotification(id: string): Promise<NotificationDetail> {
  return await secured<NotificationDetail>('notificationDetail', { id })
}
export async function readNotification(id: string): Promise<void> {
  const uid = session.value?.uid
  await secured<UTSJSONObject>('notificationRead', { id })
  if (uid === session.value?.uid) await refreshNotificationsSummary()
}
