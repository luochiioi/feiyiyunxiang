<template>
  <view class="account-avatar">
    <image :src="src || '/static/aomiao-wave.png'" :mode="src.length > 0 ? 'aspectFill' : 'aspectFit'" @error="failed = true; src = ''" />
    <button v-if="failed" aria-label="重试头像" @click="load">↻</button>
  </view>
</template>

<script setup lang="uts">
import { onBeforeUnmount, ref, watch } from 'vue'
import { loadPublicProfileAvatar, session } from '@/features/api.uts'
const props = defineProps<{ code: string, version: string }>()
const src = ref(''), failed = ref(false)
let generation = 0
async function load(): Promise<void> {
  const ticket = ++generation
  const code = props.code, version = props.version, uid = session.value?.uid
  failed.value = false
  src.value = ''
  if (code.length === 0 || version.length === 0) return
  try {
    const value = await loadPublicProfileAvatar(code, version)
    if (ticket === generation && uid === session.value?.uid) src.value = value
  } catch (_) {
    if (ticket === generation && uid === session.value?.uid) failed.value = true
  }
}
watch(() => props.code + '/' + props.version, () => { load() }, { immediate: true })
onBeforeUnmount(() => { generation++ })
</script>

<style scoped>
.account-avatar { position: relative; width: 38px; height: 38px; flex-shrink: 0; }
image { width: 100%; height: 100%; border-radius: 50%; background: #f7eedc; }
button { position: absolute; right: -7px; bottom: -4px; padding: 0 4px; font-size: 12px; line-height: 18px; }
</style>
