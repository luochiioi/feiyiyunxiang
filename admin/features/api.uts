import { ref } from 'vue'
export type AdminSession = { uid: string, token: string, expiresAt: number }
export const session = ref<AdminSession | null>(null)
type Reply<T> = { code: string, data: T }
// Keep administrator tokens only in memory; reload requires login again.
export async function api<T>(action: string, payload: UTSJSONObject = {}): Promise<T> {
  const response = await uniCloud.callFunction<Reply<T>>({ name: 'fy-api', data: { action, payload, token: session.value?.token ?? '' } })
  if (response.result.code !== 'OK') {
    if (response.result.code === 'AUTH_REQUIRED') session.value = null
    throw new Error(response.result.code)
  }
  return response.result.data
}
