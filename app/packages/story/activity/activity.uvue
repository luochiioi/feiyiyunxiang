<template>
  <view class="screen">
    <AppPageHeader title="文化任务" :show-back="true" />
    <view class="content">
      <view v-if="status == null" class="card">
        <text class="body">{{ message }}</text>
        <button v-if="validEntry" class="primary" :disabled="busy" @click="load">{{ session == null ? '微信登录并继续' : '重新读取' }}</button>
      </view>
      <view v-else class="card">
        <text v-if="status.testOnly" class="tag">开发测试 · 内容待校订</text>
        <text class="title">{{ status.title }}</text>
        <view v-if="activityId === 'learning' && status.exhibitBonus" class="option">
          <text class="heading">展品彩蛋 · 一绣两面</text>
          <StitchSample :variant="reverseSide ? 'reverse-side' : 'direction'" />
          <text class="body">{{ reverseSide ? '反面示意 · 比较线条的角度和色阶' : '正面示意 · 留意针脚聚拢的位置' }}</text>
          <button class="secondary" @click="reverseSide = !reverseSide">翻看另一面</button>
        </view>
        <text v-if="!status.unlocked" class="body">{{ status.lockText ?? (activityId === 'learning' ? '完成湘绣辨认及路线指定的打卡后解锁。' : '完成路线指定的定位照片打卡后解锁。') }}</text>
        <template v-else-if="activityId === 'tile'">
          <text class="muted">原创纹样示意 · 可比较留白、线条与重复排列</text>
          <TilePreview :pattern="selection.pattern" :palette="selection.palette" :frame-palette="selection.framePalette" />
          <text v-if="status.exhibitBonus" class="body">开光纹样框已解锁。盘面的边框把纹样分区，框内可各自安排图案。</text>
          <button v-if="status.exhibitBonus && !framing && status.exhibitWork == null" class="secondary" @click="startFrame">创作开光纹样</button>
          <text v-if="status.exhibitWork != null || (status.work != null && !framing)" class="body">作品已保存，可在「我的 → 文化作品」回看。</text>
          <template v-else>
            <text class="heading">纹样</text>
            <view class="choices">
              <button v-for="item in patterns" :key="item.id" class="choice" :class="{ selected: selection.pattern === item.id }" :disabled="busy" @click="choose(item.id, selection.palette)">{{ item.name }}</button>
            </view>
            <text class="heading">蓝白配色</text>
            <view class="choices">
              <button v-for="item in palettes" :key="item.id" class="choice" :class="{ selected: selection.palette === item.id }" :disabled="busy" @click="choose(selection.pattern, item.id)">{{ item.name }}</button>
            </view>
            <template v-if="framing">
              <text class="heading">边框颜色</text>
              <view class="choices"><button v-for="item in palettes" :key="item.id" class="choice" :class="{ selected: selection.framePalette === item.id }" :disabled="busy" @click="chooseFrame(item.id)">{{ item.name }}</button></view>
            </template>
            <button class="primary" :disabled="busy" @click="save">{{ busy ? '保存中…' : '保存作品并完成任务' }}</button>
          </template>
        </template>
        <template v-else-if="quizActivity">
          <text class="body">{{ status.prompt }}</text>
          <template v-if="activityId === 'tileQuiz'">
            <image class="quiz-clue" src="/packages/story/static/macau-shore.jpg" mode="aspectFit" />
            <text class="muted">AI 场景插画</text>
          </template>
          <text class="muted">辨认图为学习示意。</text>
          <view v-for="option in status.options" :key="option.id" class="option">
            <StitchSample v-if="option.illustration.startsWith('threads')" :variant="option.illustration === 'threads-direction' ? 'direction' : 'color'" />
            <TilePreview v-else :pattern="option.illustration === 'tile-sail' ? 'sail' : (option.illustration === 'tile-rose' ? 'rose' : 'geometry')" palette="cobalt" />
            <button class="secondary" :disabled="busy || status.done === true" @click="answer(option.id)">{{ option.label }}</button>
            <template v-if="pickedOptionId === option.id">
              <text v-if="message.length > 0" class="body">{{ message }}</text>
              <text v-if="status.done" class="body">{{ status.explanation }}</text>
              <button v-if="status.done && storyLink" class="secondary" @click="showStory">查看已解锁章节</button>
            </template>
          </view>
          <text v-if="status.done && pickedOptionId.length === 0" class="body">{{ status.explanation }}</text>
        </template>
        <template v-else>
          <text class="body">学习进度 {{ status.read?.length ?? 0 }} / {{ status.cards?.length ?? 0 }}</text>
          <text class="muted">从走向、长短、色阶和层次观察针脚，图示用于学习。</text>
          <view v-for="card in status.cards" :key="card.id" class="option">
            <text class="heading">{{ card.title }}</text>
            <button class="secondary" :disabled="busy" @click="openCard(card.id)">{{ card.hotspot }} · {{ status.read?.includes(card.id) === true ? '已学习' : '查看' }}</button>
            <template v-if="openedCard === card.id">
              <StitchSample v-if="card.illustration != null" :variant="card.illustration" />
              <text class="body">{{ card.body }}</text>
              <button v-if="status.read?.includes(card.id) !== true" class="primary" :disabled="busy" @click="markRead(card.id)">标记已读</button>
            </template>
          </view>
        </template>
        <text v-if="message.length > 0 && (!quizActivity || pickedOptionId.length === 0)" class="muted">{{ message }}</text>
        <button v-if="storyLink && activityComplete && (!quizActivity || pickedOptionId.length === 0)" class="secondary" @click="showStory">查看已解锁章节</button>
      </view>
    </view>
  </view>
</template>

<script setup lang="uts">
import { computed, ref } from 'vue'
import AppPageHeader from '@/components/AppPageHeader.uvue'
import TilePreview from '../components/TilePreview.uvue'
import StitchSample from '../components/StitchSample.uvue'
import { secured, session } from '@/features/api.uts'
import { loadRun, refreshCatalog, startRoute } from '@/features/exploration/catalog.uts'
import { decodePageId, openPage } from '@/features/navigation.uts'

type Selection = { pattern: string, palette: string, framePalette?: string }
type Option = { id: string, label: string, illustration: string }
type Card = { id: string, title: string, hotspot: string, body: string, illustration?: string }
type ActivityStatus = { title: string, unlocked: boolean, testOnly: boolean, lockText?: string, work?: Selection | null, prompt?: string,
  exhibitBonus?: boolean, exhibitWork?: Selection | null, options?: Option[], done?: boolean, explanation?: string, cards?: Card[], read?: string[] }
const patterns = [{ id: 'rose', name: '玫瑰' }, { id: 'sail', name: '海浪帆船' }, { id: 'geometry', name: '几何' }]
const palettes = [{ id: 'indigo', name: '靛蓝' }, { id: 'cobalt', name: '钴蓝' }, { id: 'mist', name: '雾蓝' }]
const selection = ref<Selection>({ pattern: 'rose', palette: 'indigo' })
const status = ref<ActivityStatus | null>(null)
const framing = ref(false)
const reverseSide = ref(false)
const activityId = ref('')
const quizActivity = computed(() => activityId.value === 'quiz' || activityId.value === 'tileQuiz')
const activityComplete = computed(() => status.value?.work != null || status.value?.done === true || status.value?.read?.length === 4)
const pickedOptionId = ref('')
const validEntry = ref(false)
const openedCard = ref('')
const busy = ref(false)
const message = ref('微信登录后可继续任务并保存进度。')
const scopedRunId = ref<string | null>(null)
const storyLink = ref(false)
let routeId = ''
let runId = ''
let draftKey = ''
onLoad(query => {
  routeId = decodePageId(query['routeId'] ?? null) ?? ''
  scopedRunId.value = decodePageId(query['runId'] ?? null)
  activityId.value = decodePageId(query['activityId'] ?? null) ?? ''
  validEntry.value = routeId.length > 0 && ['tile', 'tileQuiz', 'quiz', 'learning'].includes(activityId.value)
  if (!validEntry.value) {
    message.value = '请从路线详情打开文化任务。'
    return
  }
  if (session.value != null) load()
})
async function load(): Promise<void> {
  if (busy.value || !validEntry.value) return
  busy.value = true
  message.value = '正在读取任务…'
  try {
    const run = scopedRunId.value == null ? await startRoute(routeId) : await loadRun(routeId, scopedRunId.value!)
    if (scopedRunId.value != null && run.snapshot.activities?.some(item => item.id === activityId.value) !== true) throw new Error('NOT_FOUND')
    runId = run.runId
    const result = await secured<ActivityStatus>('activityStatus', { runId, activityId: activityId.value })
    if (activityId.value === 'tile') {
      draftKey = 'fy-tile-' + session.value!.uid + '-' + runId
      const saved = result.exhibitWork ?? result.work
      if (saved != null) selection.value = saved
      const raw = uni.getStorageSync(draftKey) as string
      if (result.exhibitWork == null && raw != null && raw.length > 0) {
        try {
          const draft = JSON.parse<Selection>(raw)
          if (draft != null && (saved == null || (result.exhibitBonus === true && draft.framePalette != null))) selection.value = draft
        } catch (_) { uni.removeStorageSync(draftKey) }
      }
      framing.value = result.exhibitBonus === true && result.exhibitWork == null && selection.value.framePalette != null
    }
    storyLink.value = (run.purpose ?? 'solo') === 'solo'
    status.value = result
    message.value = ''
  } catch (error) {
    message.value = (error as Error).message === 'NOT_FOUND' ? '当前探索版本没有这项任务。' : '读取失败，请检查登录和网络后重试。'
  } finally { busy.value = false }
}
function choose(pattern: string, palette: string): void {
  selection.value = { ...selection.value, pattern, palette }
  uni.setStorageSync(draftKey, JSON.stringify(selection.value))
}
function chooseFrame(palette: string): void {
  selection.value = { ...selection.value, framePalette: palette }
  uni.setStorageSync(draftKey, JSON.stringify(selection.value))
}
function startFrame(): void {
  framing.value = true
  chooseFrame('cobalt')
}
function showStory(): void {
  const pages = getCurrentPages()
  if (pages.length > 1 && pages[pages.length - 2].route === 'packages/story/story/story') {
    uni.navigateBack({ delta: 1 })
    return
  }
  openPage('/packages/story/story/story?routeId=' + encodeURIComponent(routeId))
}
function openCard(id: string): void { openedCard.value = openedCard.value === id ? '' : id }
async function answer(option: string): Promise<void> {
  const current = status.value
  if (busy.value || current == null || current.done === true) return
  busy.value = true
  pickedOptionId.value = option
  message.value = ''
  try {
    const result = await secured<{ done: boolean, explanation: string, hint?: string }>('answerQuiz', { runId, activityId: activityId.value, option })
    status.value = { ...current, done: result.done, explanation: result.explanation }
    message.value = result.done ? '已完成辨认题。' : (result.hint ?? '再观察一下图中的细节，选另一项试试。')
    if (result.done) await refreshCatalog()
  } catch (_) { message.value = '答案提交失败，请重试。' }
  finally { busy.value = false }
}
async function markRead(cardId: string): Promise<void> {
  const current = status.value
  if (busy.value || current == null) return
  busy.value = true
  message.value = ''
  try {
    const read = await secured<string[]>('readCard', { runId, cardId })
    status.value = { ...current, read }
    if (read.length === current.cards?.length) {
      message.value = '四张知识卡已学完。'
      await refreshCatalog()
    }
  } catch (_) { message.value = '学习进度保存失败，请重试。' }
  finally { busy.value = false }
}
async function save(): Promise<void> {
  const current = status.value
  if (busy.value || current == null || !current.unlocked || current.exhibitWork != null || (current.work != null && !framing.value)) return
  busy.value = true
  message.value = ''
  try {
    const work = await secured<Selection>('saveTile', { runId, pattern: selection.value.pattern, palette: selection.value.palette, framePalette: framing.value ? selection.value.framePalette ?? 'cobalt' : null })
    selection.value = work
    status.value = { ...current, work: current.work ?? work, exhibitWork: framing.value ? work : current.exhibitWork }
    framing.value = false
    uni.removeStorageSync(draftKey)
    await refreshCatalog()
  } catch (_) { message.value = '保存尚未确认。配色草稿已留在本机，可以重试。' }
  finally { busy.value = false }
}
</script>

<style scoped>
@import '@/styles/page.css';
.choices { display: flex; flex-direction: row; flex-wrap: wrap; gap: 7px; }
.choice { margin: 0; padding: 4px 10px; font-size: 14px; color: #2f5282; background: #edf3fa; }
.selected { background: #2f5282; color: white; }
.quiz-clue { width: 100%; height: 166px; border-radius: 12px; background: #fff7e9; }
.option { display: flex; flex-direction: column; gap: 8px; padding-top: 10px; border-top: 1px solid #eee6db; }
</style>
