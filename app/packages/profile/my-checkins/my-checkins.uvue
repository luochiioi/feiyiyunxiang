<template>
  <view class="screen">
    <AppPageHeader title="探索档案" :show-back="true" />
    <view class="content">
      <view class="card green">
        <view class="row spread"><text class="heading">我的打卡</text><text class="muted">仅自己可见</text></view>
        <text v-if="owner === session?.uid && !busy" class="body">{{ records.length }} 条打卡</text>
        <view class="row shortcuts">
          <button class="secondary" @click="openPage('/packages/story/works/works')">文化作品</button>
          <button class="secondary" @click="openPage('/packages/partner/partner/partner')">旅伴记录</button>
        </view>
      </view>
      <view v-if="session == null" class="card">
        <text class="body">登录后可查看自己的打卡记录。</text>
        <button class="primary" :disabled="busy" @click="load">微信登录并查看</button>
      </view>
      <text v-if="busy" class="muted" role="status">正在读取打卡记录…</text>
      <view v-if="failed && session != null" class="card">
        <text class="body">打卡记录暂时无法读取。</text>
        <button class="secondary" @click="load">重试</button>
      </view>
      <template v-if="records.length > 0">
        <view class="row filters">
          <button v-for="tab in tabs" :key="tab.kind" class="secondary" :class="{ active: filter === tab.kind }"
            :aria-pressed="filter === tab.kind" @click="filter = tab.kind">{{ tab.label }}</button>
        </view>
        <view v-for="group in groups" :key="group.date" class="day">
          <text class="muted day-label">{{ group.date }}</text>
          <view class="card list">
            <button v-for="item in group.entries" :key="item._id" class="entry" @click="openDetail(item._id)">
              <view class="stack">
                <text class="heading">{{ item.title }}</text>
                <text class="muted">{{ item.museumName ? item.museumName + ' · ' : '' }}{{ diaryTime(item.createdAt) }} · {{ diaryKind(item.kind ?? null) }}{{ item.mediaId ? ' · 有照片' : '' }}</text>
              </view>
              <text class="arrow" aria-hidden="true">›</text>
            </button>
          </view>
        </view>
        <text v-if="groups.length === 0" class="muted">暂无此类打卡。</text>
        <button class="secondary" :disabled="busy" @click="load">刷新记录</button>
      </template>
      <view v-else-if="session != null && owner === session?.uid && !busy && !failed" class="card">
        <text class="heading">还没有打卡</text>
        <text class="body">完成一次打卡后，就可以在这里回看。</text>
        <button class="primary" @click="openPage('/packages/routes/routes/routes')">去探索</button>
      </view>
    </view>
  </view>
</template>
<script setup lang="uts">
import { computed, ref, watch } from 'vue'
import AppPageHeader from '@/components/AppPageHeader.uvue'
import { secured, session } from '@/features/api.uts'
import { openPage } from '@/features/navigation.uts'
import { diaryKind, diaryTime, groupDiary } from '@/features/profile/checkin-archive.uts'
import type { DiaryEntry } from '@/features/profile/checkin-archive.uts'

const tabs = [{ kind: '', label: '全部' }, { kind: 'indoor', label: '馆内' }, { kind: 'outdoor', label: '馆外' }]
const filter = ref(''), owner = ref('')
const savedRecords = ref<DiaryEntry[]>([])
const busy = ref(false), failed = ref(false)
const records = computed(() => owner.value === session.value?.uid ? savedRecords.value : [])
const groups = computed(() => groupDiary(records.value, filter.value))
let generation = 0

onShow(() => { if (session.value != null && owner.value !== session.value?.uid) load() })
watch(() => session.value?.uid, (uid, previous) => {
  if (previous == null && busy.value) return
  generation++
  savedRecords.value = []; owner.value = ''; filter.value = ''; busy.value = false; failed.value = false
  if (uid != null) load()
}, { flush: 'sync' })

function openDetail(id: string): void {
  openPage('/packages/profile/checkin-detail/checkin-detail?id=' + encodeURIComponent(id))
}

async function load(): Promise<void> {
  if (busy.value) return
  const request = ++generation
  const uid = session.value?.uid
  busy.value = true; failed.value = false
  try {
    const value = await secured<DiaryEntry[]>('explorationArchive')
    const current = session.value?.uid
    if (request !== generation || current == null || (uid != null && current !== uid)) return
    owner.value = current
    savedRecords.value = value
  } catch (_) {
    if (request !== generation) return
    failed.value = true
    if (session.value == null) uni.showToast({ title: '微信登录未完成，请重试', icon: 'none' })
  } finally { if (request === generation) busy.value = false }
}
</script>
<style scoped>
@import '@/styles/page.css';
.shortcuts > button, .filters > button { flex: 1; width: auto; }
.filters .active { background: #426240; color: #fff; }
.day { display: flex; flex-direction: column; gap: 6px; }
.day-label { padding-left: 4px; }
.list { padding: 0 12px; gap: 0; }
.entry { display: flex; align-items: center; flex-direction: row; gap: 10px; width: 100%; min-height: 62px; margin: 0; padding: 8px 0; text-align: left; background: #fff; }
.entry + .entry { border-top: 1px solid #eee6db; }
.entry::after { border: 0; }
.entry .heading, .entry .muted { overflow-wrap: anywhere; }
.arrow { color: #6e6153; font-size: 22px; }
</style>
