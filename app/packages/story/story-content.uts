export type Choice = { label: string, nextSceneId: string }
export type Scene = { id: string, kind: string, text: string, asset?: string, speaker?: string, nextSceneId?: string, choices?: Choice[] }
export type Chapter = { act: number, title: string, start: string, scenes: Scene[] }
export type Checkpoint = { path: string[], revision: number }
export type ChapterRead = { chapter: Chapter, checkpoint: Checkpoint, testOnly: boolean }

export const openingStorageKey = 'fy-story-opening-v1'
export const opening: Chapter = {
  act: 1,
  title: '触碰海丝地图',
  start: 'map',
  scenes: [
    { id: 'map', kind: 'dialogue', asset: 'aomiao', speaker: '澳喵', text: '这张海丝地图上，有一块蓝白瓷砖和一缕红色绣线。你想先看看哪一样？', nextSceneId: 'choose' },
    { id: 'choose', kind: 'choice', text: '指尖滑过地图，两样东西同时亮了起来。', choices: [
      { label: '触碰蓝白瓷砖', nextSceneId: 'tile' },
      { label: '拾起红色绣线', nextSceneId: 'thread' }
    ] },
    { id: 'tile', kind: 'dialogue', speaker: '旁白', text: '你在蓝纹里看见一片帆影。浪声由远而近，仿佛有一艘船正向你驶来。', nextSceneId: 'depart' },
