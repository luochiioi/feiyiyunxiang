<template>
  <view class="profile-review">
    <text v-if="message.length > 0" class="message" role="status">{{ message }}</text>
    <view class="review-columns">
    <view class="queue">
      <view class="actions queue-heading">
        <text class="heading">待审队列</text>
        <button :disabled="busy" @click="load(false)">刷新队列</button>
      </view>
      <text v-if="!busy && items.length === 0 && message.length === 0" class="muted">当前没有待审资料。</text>
      <button v-for="item in items" :key="item.revisionId" class="queue-item" :class="{ active: selectedId === item.revisionId }" :disabled="busy"
        @click="select(item.revisionId)">
        <text class="heading">{{ item.nickname }}</text><text class="muted">{{ new Date(item.createdAt).toLocaleString() }}</text>
      </button>
      <button v-if="next.length > 0" :disabled="busy" @click="load(true)">加载更多</button>
    </view>

    <view v-if="detail != null" class="inspector">
      <view class="comparison">
        <view class="version">
          <text class="heading">当前公开资料</text>
          <image class="thumb" :src="currentSrc || defaultAvatar" mode="aspectFit" @error="imageFailed(true)" />
          <button v-if="currentError" :disabled="busy" @click="loadAvatar(true)">重试当前头像</button>
          <text>{{ detail?.current.nickname }}</text>
          <text class="muted">{{ detail?.current.bio || '未填写简介' }}</text>
          <text class="muted">{{ detail?.current.displayCity || '未填写城市标签' }}</text>
          <text class="muted">{{ detail?.current.interests.join(' · ') || '未选择文化兴趣' }}</text>
        </view>
        <view class="version">
          <text class="heading">申请资料</text>
          <image class="thumb" :src="selectedSrc || defaultAvatar" mode="aspectFit" @error="imageFailed(false)" />
          <button v-if="selectedError" :disabled="busy" @click="loadAvatar(false)">重试申请头像</button>
          <text>{{ detail?.selected.nickname }}</text>
          <text class="muted">{{ detail?.selected.bio || '未填写简介' }}</text>
          <text class="muted">{{ detail?.selected.displayCity || '未填写城市标签' }}</text>
          <text class="muted">{{ detail?.selected.interests.join(' · ') || '未选择文化兴趣' }}</text>
          <text v-if="detail?.selected.reason">{{ detail?.selected.reason }}</text>
        </view>
      </view>
      <text v-if="detail?.accountActive === false">账号停用中，恢复后可继续审核。</text>
      <view v-if="canDecide" class="decision">
        <button v-if="attempted != null" :disabled="busy" @click="review(attempted ?? '')">重试确认审核结果</button>
        <template v-else-if="rejecting">
          <text class="heading">驳回原因</text>
          <textarea v-model="reason" :disabled="busy" placeholder="填写 1–300 字，申请人将在消息中看到" />
          <view class="actions decision-actions">
            <button :disabled="busy" @click="cancelReject">取消</button>
            <button class="danger" :disabled="busy" @click="review('reject')">确认驳回</button>
          </view>
        </template>
        <view v-else class="actions decision-actions">
          <button :disabled="busy" @click="rejecting = true">驳回…</button>
          <button class="primary" :disabled="busy" @click="review('approve')">通过资料</button>
        </view>
      </view>
    </view>
    <view v-else class="inspector placeholder"><text class="muted">{{ busy ? '正在读取…' : '选择一条申请，查看当前公开资料和修改内容。' }}</text></view>
    </view>
  </view>
</template>

<script setup lang="uts">
import { computed, onBeforeUnmount, onMounted, ref } from 'vue'
import { api, scheduleProfileImage, session } from '@/features/api.uts'
import type { ProfileReviewPage, ProfileReviewDetail, ProfileReviewItem } from '@/features/api.uts'

const defaultAvatar = '/static/aomiao-wave.png'
const items = ref<ProfileReviewItem[]>([]), next = ref('')
const detail = ref<ProfileReviewDetail | null>(null)
const selectedId = ref(''), rejecting = ref(false)
const message = ref(''), reason = ref('')
const selectedSrc = ref(''), currentSrc = ref('')
const selectedError = ref(false), currentError = ref(false)
const attempted = ref<string | null>(null), decided = ref(false), busy = ref(false)
const canDecide = computed(() => detail.value?.accountActive === true && detail.value?.selected.status === 'pending' && !decided.value)
let generation = 0
let closed = false
onMounted(() => { load(false) })
onBeforeUnmount(() => { closed = true; generation++ })

async function fetchQueue(more: boolean): Promise<void> {
  const result = await api<ProfileReviewPage>('profileReviewList', { cursor: more ? next.value : '' })
  items.value = more ? [...items.value, ...result.items] : result.items
  next.value = result.next
}

async function load(more: boolean): Promise<void> {
  if (busy.value) return
  busy.value = true
  try {
    await fetchQueue(more)
    message.value = ''
  } catch (_) {
    message.value = '未能读取待审队列，请重试。'
  } finally { busy.value = false }
}

async function select(id: string): Promise<void> {
  if (busy.value) return
  busy.value = true
  generation++
  detail.value = null
  selectedId.value = id
  currentSrc.value = ''; selectedSrc.value = ''
  currentError.value = false; selectedError.value = false
  attempted.value = null; decided.value = false; cancelReject(); message.value = ''
  try {
    detail.value = await api<ProfileReviewDetail>('profileReviewDetail', { revisionId: id })
    currentSrc.value = detail.value?.current.avatar ?? ''
    selectedSrc.value = detail.value?.selected.avatar ?? ''
    if (detail.value?.current.avatarVersion) loadAvatar(true)
    if (detail.value?.selected.hasAvatar === true) loadAvatar(false)
  } catch (_) { message.value = '未能读取资料详情，请重试。' }
  finally { busy.value = false }
}

function cancelReject(): void { rejecting.value = false; reason.value = '' }

function imageFailed(current: boolean): void {
  if (current && currentSrc.value.length > 0) { currentSrc.value = ''; currentError.value = true }
  if (!current && selectedSrc.value.length > 0) { selectedSrc.value = ''; selectedError.value = true }
}

function loadAvatar(current: boolean): void {
  const ticket = generation
  const uid = session.value?.uid
  scheduleProfileImage(async () => {
    const value = detail.value
    if (closed || ticket !== generation || uid !== session.value?.uid || value == null) return
    const source = current ? currentSrc : selectedSrc
    const failure = current ? currentError : selectedError
    failure.value = false
    try {
      const image = await api<{ src: string }>('profileReviewAvatar', {
        revisionId: value.selected.revisionId, current, avatarVersion: value.current.avatarVersion
      })
      if (!closed && ticket === generation && uid === session.value?.uid) source.value = image.src
    } catch (_) {
      if (!closed && ticket === generation && uid === session.value?.uid) failure.value = true
    }
  })
}

async function review(decision: string): Promise<void> {
  const value = detail.value
  if (value == null || busy.value || !canDecide.value) return
  const explanation = reason.value.trim()
  if (decision === 'reject' && (explanation.length === 0 || Array.from(explanation).length > 300)) {
    message.value = '请填写 1–300 字的驳回原因。'
    return
  }
  attempted.value = decision
  busy.value = true
  try {
    await api<UTSJSONObject>('profileReview', { revisionId: value.selected.revisionId, decision, reason: explanation })
    decided.value = true
    items.value = items.value.filter(item => item.revisionId !== value.selected.revisionId)
    message.value = decision === 'approve' ? '资料已通过。' : '资料已驳回。'
    try { await fetchQueue(false) }
    catch (_) { message.value += ' 队列刷新失败，可单独刷新。' }
  } catch (error) {
    const code = (error as Error).message
    if (['STALE_VERSION', 'ACCOUNT_DISABLED', 'NOT_FOUND'].includes(code)) {
      decided.value = true
      message.value = '资料版本或账号状态已变化，请刷新后重新查看。'
    } else if (code === 'INVALID_REASON') {
      attempted.value = null
      message.value = '请检查审核原因。'
    } else { message.value = '未收到审核确认，可重试同一决定。' }
  } finally { busy.value = false }
}
</script>

<style scoped>
.profile-review, .inspector, .version, .queue, .decision { display: flex; flex-direction: column; gap: 12px; }
.review-columns { display: grid; grid-template-columns: minmax(190px, 255px) minmax(0, 1fr); gap: 16px; align-items: start; }
.actions { display: flex; flex-direction: row; flex-wrap: wrap; align-items: center; gap: 8px; }
.queue,.inspector { padding: 16px; min-width:0; background:#fff; border:1px solid #e1e8df; border-radius: 14px; }
.queue-heading { justify-content: space-between; }
.queue-heading button { padding: 0 8px; font-size: 12px; }
.queue-item { display:flex; flex-direction:column; align-items:flex-start; text-align:left; gap:3px; padding:10px 12px; background: #f4f7f3; border-radius:8px; line-height:1.45; word-break:break-word; }
.queue-item.active { background:#e1ede2; box-shadow: inset 3px 0 #426240; }
.queue-item::after { border:none; }
.comparison { display:grid; grid-template-columns: repeat(2,minmax(0,1fr)); gap:12px; }
.version { padding: 14px; border-radius: 10px; background:#f6f7f3; overflow-wrap: anywhere; }
.heading { color:#244132; font-weight:700; }
.muted { color:#516256; font-size:13px; }
.thumb { width: 64px; height: 64px; border-radius: 32px; background: #f7eedc; }
.message { color: #74512a; }
.decision { padding-top:12px; border-top:1px solid #e1e8df; }
.decision-actions { justify-content:flex-end; }
.decision .primary { color:#fff; background:#426240; border-color:#426240; }
.danger { color:#fff; background:#a2383d; }
.placeholder { min-height: 140px; justify-content:center; }
textarea { border: 1px solid #d5d5d5; padding: 8px; min-height: 65px; }
@media (max-width: 840px) { .review-columns { grid-template-columns: minmax(0,1fr); } }
@media (max-width: 440px) { .comparison { grid-template-columns: minmax(0,1fr); } }
</style>
