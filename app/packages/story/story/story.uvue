<template>
  <view class="screen">
    <AppPageHeader title="剧情" :show-back="true" />
    <view class="content">
      <view class="card green">
        <text class="title">海丝瓷绣·一念归期</text>
        <text class="body">从海丝地图出发，沿澳门的蓝白瓷砖或湖南的湘绣继续故事。</text>
        <button class="primary" @click="openOpening">{{ openingStarted ? '继续开场预览' : '阅读开场预览' }}</button>
      </view>
      <view class="card">
        <text class="heading">章节目录</text>
        <text class="muted">从每一幕的入口完成任务，返回这里继续阅读。</text>
        <view v-for="(chapter, index) in chapters" :key="chapter.title" class="row spread divider menu-row">
          <view class="stack">
            <text class="body">{{ '第 ' + (index + 1) + ' 幕 · ' + (chapterFor(index + 1)?.title ?? chapter.title) }}</text>
            <text v-if="index > 0 && chapterFor(index + 1)?.unlocked !== true" class="muted">{{ chapterFor(index + 1)?.gateText ?? chapter.gate }}</text>
          </view>
          <button v-if="hasAction(index + 1)" class="chapter-action" @click="openChapter(index + 1)">{{ chapterLabel(index + 1) }}</button>
          <text v-else class="muted">{{ chapterLabel(index + 1) }}</text>
        </view>
        <text v-if="message.length > 0" class="muted">{{ message }}</text>
        <button v-if="loadFailed" class="secondary" @click="load">重新读取解锁进度</button>
      </view>
      <button class="secondary" @click="openPage('/packages/routes/routes/routes')">查看路线</button>
    </view>
  </view>
</template>

<script setup lang="uts">
import AppPageHeader from '@/components/AppPageHeader.uvue'
import { ref } from 'vue'
import { api, secured, session } from '@/features/api.uts'
import type { PublishedRoute } from '@/features/exploration/catalog.uts'
import { decodePageId, openCultureActivity, openPage, openRouteDetail } from '@/features/navigation.uts'
import { legacyStorm, localStoryPath, savedOpeningPath } from '../story-content.uts'
import { readLegacyStorm } from '../legacy-story.uts'
type Entry = { act: number, title: string, runId: string, routeId: string, unlocked: boolean, started: boolean, gateText?: string, nextActivityId?: string | null, local?: boolean }
type TaskLink = { routeId: string, activityId: string, label: string }
const entries = ref<Entry[]>([])
const routes = ref<PublishedRoute[]>([])
const openingStarted = ref(false)
const loadFailed = ref(false)
const olderService = ref(false)
const message = ref('')
let loading = false
let preferredRoute = ''
const chapters = [
  { title: '触碰海丝地图', gate: '', taskId: '' },
  { title: '海上风暴', gate: '完成路线内任一地点打卡', taskId: '' },
  { title: '女儿与瓷砖', gate: '保存蓝白瓷砖配色作品', taskId: 'tile' },
  { title: '澳门靠岸', gate: '答对瓷砖纹样辨认题', taskId: 'tileQuiz' },
  { title: '湘绣相遇', gate: '答对湘绣辨认题', taskId: 'quiz' },
  { title: '针法学习', gate: '答对湘绣辨认题后，读完四张知识卡', taskId: 'learning' }
]
onLoad(query => { preferredRoute = decodePageId(query['routeId'] ?? null) ?? '' })
onShow(() => {
  openingStarted.value = savedOpeningPath().length > 1
  load()
})
async function load(): Promise<void> {
  if (loading) return
  loadFailed.value = false
  olderService.value = false
  message.value = ''
  loading = true
  const uid = session.value?.uid
  try {
    try { routes.value = await api<PublishedRoute[]>('catalog') } catch (_) { /* Keep the last public catalog for task links. */ }
    if (uid == null) { entries.value = []; return }
    let library: Entry[] = []
    let missing = false
    try {
      library = await secured<Entry[]>('storyLibrary')
    } catch (error) {
      if ((error as Error).message !== 'NOT_FOUND') throw error
      missing = true
    }
    if (session.value?.uid !== uid) throw new Error('AUTH_REQUIRED')
    if (missing || !library.some(item => item.act === 2 && (preferredRoute.length === 0 || item.routeId === preferredRoute))) {
      try {
        const local = await readLegacyStorm(preferredRoute, '')
        if (local != null && !library.some(item => item.routeId === local.routeId)) {
          library.push({ act: 2, title: legacyStorm.title, routeId: local.routeId, runId: local.runId,
            unlocked: local.unlocked, started: localStoryPath(local.storageKey, legacyStorm).length > 1,
            gateText: '澳门 · 完成本路线任一地点打卡', local: true })
        }
      } catch (error) {
        if (missing) throw error
      }
    }
    if (session.value?.uid !== uid) throw new Error('AUTH_REQUIRED')
    entries.value = library
    olderService.value = missing
    if (missing) {
      message.value = library.length > 0
        ? '当前测试路线的第二幕可按已有打卡进度阅读，其余章节待剧情服务接入。'
        : '当前开发环境尚未接入剧情服务。可从已打卡的澳门测试路线查看第二幕。'
    }
  } catch (error) {
    entries.value = []
    loadFailed.value = true
    message.value = (error as Error).message === 'AUTH_REQUIRED' || session.value == null
      ? '请在「我的」重新登录后读取解锁进度。' : '暂时无法读取路线打卡进度，请重试。'
  } finally { loading = false }
}
function chapterFor(act: number): Entry | null {
  const candidates = entries.value.filter(entry => entry.act === act)
  const main = routes.value.find(route => route.cultureUpgrade === true)
  return candidates.find(entry => entry.routeId === preferredRoute) ??
    candidates.find(entry => entry.routeId === main?.id) ??
    candidates.find(entry => entry.unlocked) ?? candidates[0] ?? null
}
function taskFor(act: number): TaskLink | null {
  if (act < 2) return null
  const entry = chapterFor(act)
  const defaultTask = chapters[act - 1].taskId
  const matching = routes.value.filter(route => route.chapters?.some(chapter => chapter.act === act) === true ||
    route.activities?.some(task => task.id === (act === 2 ? 'tile' : defaultTask)) === true)
  const route = matching.find(item => item.id === preferredRoute) ?? matching.find(item => item.cultureUpgrade === true) ??
    matching.find(item => item.id === entry?.routeId) ?? matching[0] ?? null
  if (route == null && entry == null) return null
  const routeId = route?.id ?? entry!.routeId
  const sameRoute = entry?.routeId === routeId
  let task = ''
  if (act > 2) {
    if (sameRoute && entry?.nextActivityId !== undefined) task = entry?.nextActivityId ?? ''
    else if (route?.activities?.some(item => item.id === defaultTask) === true) {
      task = act === 6 && !entries.value.some(item => item.routeId === routeId && item.act === 5 && item.unlocked) ? 'quiz' : defaultTask
    }
  }
  const label = task === 'tile' ? '去配色' : task === 'tileQuiz' ? '答瓷砖题' : task === 'quiz' ? '答湘绣题' : task === 'learning' ? '学知识卡' : act === 2 ? '去打卡' : '查看路线'
  return { routeId, activityId: task, label }
}
function hasAction(act: number): boolean {
  return act === 1 || chapterFor(act)?.unlocked === true || taskFor(act) != null
}
function chapterLabel(act: number): string {
  if (act === 1) return '游客可读 ›'
  const entry = chapterFor(act)
  if (entry?.unlocked === true) return entry.started ? '继续阅读 ›' : '阅读 ›'
  const task = taskFor(act)
  if (task != null) return task.label + ' ›'
  if (loadFailed.value) return '待重试'
  if (entry != null) return '随路线解锁'
  if (session.value == null) return '登录后查看'
  return olderService.value ? '待接入' : '当前探索暂无'
}
function openOpening(): void { openPage('/packages/story/reader/reader?act=1') }
function openChapter(act: number): void {
  if (act === 1) { openOpening(); return }
  const entry = chapterFor(act)
  if (entry?.unlocked === true) {
    openPage('/packages/story/reader/reader?act=' + act + '&runId=' + encodeURIComponent(entry.runId) + (entry.local === true ? '&legacy=1' : ''))
    return
  }
  const task = taskFor(act)
  if (task == null) return
  if (task.activityId.length > 0) openCultureActivity(task.routeId, task.activityId)
  else openRouteDetail(task.routeId)
}
</script>

<style scoped>
@import '@/styles/page.css';

.chapter-action { flex-shrink: 0; margin: 0; padding: 0 10px; border-radius: 9px; font-size: 13px; line-height: 34px; background: #eef2e5; color: #385538; }
</style>
