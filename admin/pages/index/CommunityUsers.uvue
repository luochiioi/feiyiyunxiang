<template>
  <view class="ops">
    <view class="tools">
      <input v-model="code" :disabled="busy" placeholder="8 位公开旅伴 ID" :maxlength="8" @confirm="search" />
      <button :disabled="busy" @click="search">查找</button>
      <button :disabled="busy" @click="filter('')">清除筛选／全部</button>
      <button :disabled="busy" @click="filter('active')">正常</button>
      <button :disabled="busy" @click="filter('disabled')">运营停用</button>
    </view>
    <text class="muted">按完整公开 ID 精确查找：8 位英文字母或数字 2–9。</text>
    <text v-if="receipt.length > 0" class="receipt">{{ receipt }}</text>
    <text v-if="message.length > 0" class="muted">{{ message }}</text>
    <view class="columns">
      <view class="panel account-list">
        <text class="heading">{{ listTitle() }}</text>
        <text v-if="!busy && listState === 'ready' && users.length === 0" class="muted">没有匹配的账户。</text>
        <view v-for="user in users" :key="user.id" class="account-row">
          <AccountAvatar :code="user.code" :version="user.status === 0 ? user.avatarVersion ?? '' : ''" />
          <view class="ops"><text>{{ user.nickname }}</text><text class="muted">{{ user.code.length > 0 ? 'ID ' + user.code : '尚无公开 ID' }} · {{ statusLabel(user.status, user.suspendedByOps) }}</text></view>
          <button :disabled="busy" @click="select(user.id)">详情</button>
        </view>
        <button v-if="listState === 'failed'" :disabled="busy" @click="refreshList">重试账户列表</button>
        <button v-if="next.length > 0 && listState !== 'failed'" :disabled="busy" @click="more">{{ listState === 'moreFailed' ? '重试加载更多' : '加载更多' }}</button>
      </view>
      <view v-if="detailFailed" class="panel inspector">
        <text>暂时无法读取所选账户详情。</text>
        <button :disabled="busy" @click="retryDetail">重试账户详情</button>
      </view>
      <view v-else-if="selected != null" class="panel inspector">
        <AccountAvatar :code="selected?.code ?? ''" :version="selected?.status === 0 ? selected?.avatarVersion ?? '' : ''" />
        <text class="heading">{{ selected?.nickname }} · {{ statusLabel(selected?.status ?? -1, selected?.suspendedByOps === true) }}</text>
        <text class="muted">{{ selected?.code ? 'ID ' + selected?.code : '尚无公开 ID' }} · {{ created() }}</text>
        <text class="muted">{{ muted ? '禁言中 · 截止 ' + new Date(selected?.muteUntil ?? 0).toLocaleString() : '未禁言' }}</text>
        <view class="profile-summary">
          <text class="heading">当前公开资料</text>
          <text class="muted">简介</text><text class="profile-bio">{{ selected?.bio || '未填写简介' }}</text>
          <text class="muted">城市标签 {{ selected?.displayCity || '未填写' }}</text>
          <text class="muted">文化兴趣 {{ selected?.interests?.join(' · ') || '未填写' }}</text>
        </view>
        <text>好友 {{ selected?.friendCount }} · 帖子共 {{ selected?.postCount }} · 评论共 {{ selected?.commentCount }} · 被举报共 {{ selected?.reportCount }}</text>
        <view class="tools">
          <button :disabled="busy" @click="review('pending')">待审帖子（{{ selected?.pendingPosts }}）</button>
          <button :disabled="busy" @click="review('published')">公开帖子（{{ selected?.publishedPosts }}）</button>
          <button :disabled="busy" @click="review('comments')">待审评论（{{ selected?.pendingComments }}）</button>
          <button :disabled="busy" @click="review('publicComments')">公开评论（{{ selected?.publicComments }}）</button>
          <button :disabled="busy" @click="review('reports')">待处理举报（{{ selected?.openReports }}）</button>
          <button :disabled="busy" @click="review('resolvedReports')">已处理举报（{{ selected?.resolvedReports }}）</button>
          <button :disabled="busy" @click="review('mutes')">禁言记录</button>
          <button :disabled="busy" @click="review('audit')">审计记录</button>
        </view>
        <text class="muted">停用会撤销会话并暂停微信登录。已公开内容可在社区审核中处理。</text>
        <textarea :disabled="busy" v-model="reason" :maxlength="300" placeholder="输入停用、恢复或禁言原因" />
        <view class="tools">
          <button v-if="selected?.status === 0" :disabled="busy" @click="setStatus(true)">停用账户</button>
          <button v-if="selected?.suspendedByOps && selected?.status === 1" :disabled="busy" @click="setStatus(false)">恢复账户</button>
        </view>
        <view class="tools">
          <view class="duration"><text class="muted">禁言时长（分钟）</text><input :disabled="busy" v-model="minutes" type="number" /></view>
          <button :disabled="busy" @click="mute(false)">禁言</button>
          <button v-if="muted" :disabled="busy" @click="mute(true)">解除禁言</button>
        </view>
      </view>
    </view>
  </view>
</template>
<script setup lang="uts">
import { computed, ref, watch } from 'vue'
import { api } from '@/features/api.uts'
import AccountAvatar from './AccountAvatar.uvue'
type Account = { id: string, status: number, suspendedByOps: boolean, code: string, nickname: string, avatarVersion?: string, createdAt: number, muteUntil: number }
type AccountDetail = { id: string, status: number, suspendedByOps: boolean, code: string, nickname: string, avatarVersion?: string, bio?: string, displayCity?: string, interests?: string[], createdAt: number, muteUntil: number, friendCount: number, postCount: number, commentCount: number, reportCount: number, pendingPosts: number, publishedPosts: number, pendingComments: number, publicComments: number, openReports: number, resolvedReports: number }
type AccountPage = { items: Account[], next: string }
const props = defineProps<{ visible: boolean }>()
const emit = defineEmits<{ (event: 'review', group: string, uid: string, label: string): void }>()
const users = ref<Account[]>([]), selected = ref<AccountDetail | null>(null)
const code = ref(''), searchCode = ref(''), status = ref(''), next = ref('')
const reason = ref(''), minutes = ref('60'), busy = ref(false), message = ref(''), receipt = ref('')
const selectedId = ref(''), detailFailed = ref(false), listState = ref('loading')
const muted = computed(() => (selected.value?.muteUntil ?? 0) > Date.now())
watch(() => props.visible, visible => { if (visible && selectedId.value.length > 0) retryDetail() })
onMounted(() => { filter('') })

function statusLabel(value: number, suspendedByOps: boolean): string {
  switch (value) {
    case 0: return '正常'
    case 1: return suspendedByOps ? '运营停用' : '其他停用'
    case 2: return '审核中'
    case 3: return '审核拒绝'
    case 4: return '已注销'
    default: return '状态未知'
  }
}
function listTitle(): string {
  if (searchCode.value.length > 0) return '查找结果'
  return status.value === 'active' ? '正常账户' : status.value === 'disabled' ? '运营停用账户' : '全部账户'
}
function created(): string {
  const at = selected.value?.createdAt ?? 0
  return at > 0 ? '注册于 ' + new Date(at).toLocaleDateString() : '注册时间未知'
}
async function work(operation: () => Promise<void>): Promise<void> {
  if (busy.value) return
  busy.value = true; message.value = '加载中…'
  try { await operation(); if (message.value === '加载中…') message.value = '' }
  catch (error) {
    switch ((error as Error).message) {
      case 'INVALID_CODE': message.value = '请输入 8 位公开旅伴 ID。'; break
      case 'INVALID_CONTENT': message.value = '请填写操作原因。'; break
      case 'INVALID_DURATION': message.value = '禁言时长须为 1 至 43200 分钟。'; break
      case 'INVALID_ACCOUNT_STATE': message.value = '该账户当前状态不支持此操作。'; break
      case 'FORBIDDEN': message.value = '当前账号没有用户管理权限。'; break
      default: message.value = '操作未完成，请检查接口和网络后重试。'
    }
  } finally { busy.value = false }
}
async function load(append: boolean, pages = 1): Promise<void> {
  try {
    let result = await api<AccountPage>('communityUsers', { code: searchCode.value, status: status.value, cursor: append ? next.value : '' })
    const items = [...result.items]
    for (let i = 1; i < pages && result.next.length > 0; i++) {
      result = await api<AccountPage>('communityUsers', { code: searchCode.value, status: status.value, cursor: result.next })
      items.push(...result.items)
    }
    users.value = append ? [...users.value, ...items] : items
    next.value = result.next; listState.value = 'ready'
  } catch (error) {
    listState.value = append ? 'moreFailed' : 'failed'
    throw error
  }
}
function resetSelection(): void {
  selectedId.value = ''; selected.value = null; detailFailed.value = false
  reason.value = ''; minutes.value = '60'; receipt.value = ''
}
function resetList(): void { resetSelection(); users.value = []; next.value = ''; listState.value = 'loading' }
function search(): void {
  work(async () => {
    const term = code.value.trim()
    if (!/^[A-Z2-9]{8}$/i.test(term)) throw new Error('INVALID_CODE')
    resetList(); searchCode.value = term.toUpperCase(); status.value = ''; await load(false)
  })
}
function filter(value: string): void {
  work(async () => { resetList(); status.value = value; code.value = ''; searchCode.value = ''; await load(false) })
}
function refreshLoadedPages(): Promise<void> { return load(false, Math.max(1, Math.ceil(users.value.length / 20))) }
function refreshList(): void { work(refreshLoadedPages) }
function more(): void { work(() => load(true)) }
async function loadDetail(id: string): Promise<void> {
  try {
    selected.value = await api<AccountDetail>('communityUserDetail', { targetUid: id })
    detailFailed.value = false
  } catch (_) { detailFailed.value = true }
}
function select(id: string): void {
  work(async () => { resetSelection(); selectedId.value = id; await loadDetail(id) })
}
function retryDetail(): void {
  const id = selectedId.value
  if (id.length > 0) work(() => loadDetail(id))
}
function review(group: string): void {
  const user = selected.value
  if (user != null) emit('review', group, user.id, user.code ? user.nickname + ' · ' + user.code : user.nickname)
}
function confirm(title: string, user: AccountDetail, note: string, details: string): Promise<boolean> {
  return new Promise<boolean>(resolve => {
    const label = user.nickname + (user.code ? ' · ' + user.code : ' · ' + user.id)
    uni.showModal({ title, content: label + details + '\n原因：' + note,
      success: result => resolve(result.confirm), fail: () => resolve(false) })
  })
}
async function refreshAfterWrite(id: string, result: string): Promise<void> {
  receipt.value = result; reason.value = ''; message.value = ''
  await Promise.all([loadDetail(id), refreshLoadedPages().catch(() => {})])
}
function setStatus(suspend: boolean): void {
  const user = selected.value, note = reason.value.trim()
  if (user == null) return
  work(async () => {
    if (note.length === 0) throw new Error('INVALID_CONTENT')
    if (!await confirm(suspend ? '停用此账户' : '恢复此账户', user, note, '\n现有会话将撤销。')) return
    receipt.value = ''
    await api<UTSJSONObject>('communityAccountStatus', { targetUid: user.id, suspend, reason: note })
    await refreshAfterWrite(user.id, suspend ? '账户已停用，会话已撤销。' : '账户已恢复，请重新登录。')
  })
}
function mute(release: boolean): void {
  const user = selected.value, note = reason.value.trim(), duration = release ? 0 : Number(minutes.value)
  if (user == null) return
  work(async () => {
    if (note.length === 0) throw new Error('INVALID_CONTENT')
    if (!release && (!Number.isInteger(duration) || duration < 1 || duration > 43200)) throw new Error('INVALID_DURATION')
    if (!await confirm(release ? '解除此账户的禁言' : '禁言此账户', user, note, release ? '' : ' · ' + duration + ' 分钟')) return
    receipt.value = ''
    const result = await api<{ until: number }>('communityMute', { targetUid: user.id, reason: note, minutes: duration })
    await refreshAfterWrite(user.id, release ? '已解除禁言。' : '已禁言至 ' + new Date(result.until).toLocaleString())
  })
}
</script>
<style scoped>
.ops, .panel { display: flex; flex-direction: column; gap: 10px; }
.tools, .columns, .account-row { display: flex; flex-direction: row; gap: 10px; align-items: center; flex-wrap: wrap; }
.columns { align-items: flex-start; }
.account-row { justify-content: space-between; border-bottom: 1px solid #ece7dc; padding: 8px 0; }
.panel { background: #fffef7; border-radius: 12px; padding: 16px; }
.account-list { width: 280px; }
.inspector { flex: 1; min-width: 330px; }
button { margin: 0; }
.tools input { width: 180px; }
.profile-summary,.duration { display:flex; flex-direction:column; gap:4px; }
.profile-summary { background:#f2f5ed; border-radius:8px; padding:10px; }
.profile-bio { overflow-wrap:anywhere; white-space:pre-wrap; margin-bottom:5px; }
.tools .duration input { width:145px; }
.receipt { color: #304c37; font-weight: 700; }
.muted { font-size: 13px; color: #675d50; }
</style>
