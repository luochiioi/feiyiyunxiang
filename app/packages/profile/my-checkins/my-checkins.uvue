<template>
  <view class="screen"><AppPageHeader title="探索档案" :show-back="true" />
    <view class="content">
      <view class="card green"><text class="heading">我的私密日记</text><text class="body">{{ records.length }} 条已保存记录 · 作品与合作待开发</text><button class="secondary" :disabled="busy" @click="load">{{ session == null ? '微信登录并查看' : '刷新日记' }}</button></view>
      <text class="body">{{ message }}</text>
      <view v-for="item in records" :key="item._id" class="card">
        <view class="row spread"><text class="heading">{{ item.title }}</text><text class="tag">仅本人可见</text></view>
        <text class="muted">{{ new Date(item.createdAt).toLocaleString() }}</text>
        <text class="body">{{ item.note }}</text>
        <button class="secondary" @click="viewPhoto(item.mediaId)">查看私密照片</button>
        <image v-if="photoId === item.mediaId" :src="photo" mode="aspectFit" style="width:100%;height:220px" />
      </view>
      <button class="secondary" @click="returnToMap">回到地图</button>
    </view>
  </view>
</template>
<script setup lang="uts">
import { ref } from 'vue'
import AppPageHeader from '@/components/AppPageHeader.uvue'
import { secured, session } from '@/features/api.uts'
import { returnToMap } from '@/features/navigation.uts'
type Diary = { _id: string, title: string, createdAt: number, note: string, mediaId: string }
const records = ref<Diary[]>([]), busy = ref(false), message = ref('登录后查看云端日记。')
const photo = ref(''), photoId = ref('')
onShow(() => { if (session.value != null) load() })
onHide(() => { photo.value = ''; photoId.value = '' })
async function load(): Promise<void> {
  if (busy.value) return
  busy.value = true
  try { records.value = await secured<Diary[]>('diary'); message.value = records.value.length === 0 ? '暂无打卡记录，先去路线开始探索。' : '' }
  catch (_) { records.value = []; message.value = '日记暂时无法加载，请检查网络与云端配置后重试。' }
  finally { busy.value = false }
}
async function viewPhoto(id: string): Promise<void> {
  try { const result = await secured<{ src: string }>('readMedia', { id }); photo.value = result.src; photoId.value = id }
  catch (_) { message.value = '照片暂时无法读取，请重试。' }
}
</script>
<style scoped>
@import '@/styles/page.css';
</style>
