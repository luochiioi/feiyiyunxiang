<template>
  <view class="screen">
    <AppPageHeader title="合作详情" :show-back="true" />
    <view class="content">
      <view v-if="loading" class="card"><text class="body">正在读取合作…</text></view>
      <view v-else-if="loadFailed" class="card">
        <text class="body">暂时无法读取合作信息。</text>
        <button class="secondary" @click="load">重试</button>
      </view>
      <template v-else-if="team != null">
        <view class="card green">
          <text class="title">旅伴合作</text>
          <text class="body">各自完成所在地的节点与文化任务，双方完成后共同解锁成果。</text>
          <text class="muted">状态 {{ statusText }} · 我的席位 {{ seatName(team.mySeat) }} · 旅伴 {{ seatName(team.partnerSeat ?? '') }}</text>
        </view>
        <view class="card">
          <text class="heading">旅伴</text>
          <view class="row"><ProfileAvatar :code="team.partner?.code ?? ''" :version="team.partner?.avatarVersion ?? ''" :legacy="team.partner?.avatar ?? ''" /><text class="body">{{ partnerText }}</text></view>
          <text class="muted">对外成果只展示席位标签，不展示对方昵称。</text>
        </view>
        <view class="card">
          <text class="heading">文化任务</text>
          <text class="body">我 · {{ canAnswer ? coopTaskText(selectedTasks, '按路线默认任务') : coopTaskText(team.myTasks) }}</text>
          <text class="body">旅伴 · {{ coopTaskText(team.partnerTasks) }}</text>
        </view>
        <view v-if="canAnswer" class="card">
          <text class="heading">选择我的文化任务</text>
          <text class="muted">点位打卡仍按席位全部完成。</text>
          <button v-for="task in taskOptions" :key="task.id" class="secondary" :class="{ selected: isTaskChosen(task.id) }" :disabled="busy" @click="toggleTask(task.id)">{{ task.title }}</button>
          <button v-if="selectedTasks.length < taskOptions.length" class="secondary" :disabled="busy" @click="chosen = null">恢复全选</button>
        </view>
        <view v-if="status === 'active'" class="card">
          <text class="heading">双方进度</text>
          <text class="body">我的{{ team.mySeat === 'macau' ? '澳门' : '湖南' }}席位 {{ team.myProgress?.done ?? 0 }} / {{ team.myProgress?.total ?? 0 }}</text>
          <text class="body">旅伴的{{ (team.partnerSeat ?? (team.mySeat === 'macau' ? 'hunan' : 'macau')) === 'macau' ? '澳门' : '湖南' }}席位 {{ team.partnerProgress?.done ?? 0 }} / {{ team.partnerProgress?.total ?? 0 }}</text>
        </view>
        <button v-if="status === 'active' && team.myRunId != null" class="primary" :disabled="busy" @click="explore">开始探索</button>
        <button v-if="(status === 'active' || status === 'done') && team.myRunId != null" class="secondary" @click="openCurrentStory">查看合作剧情</button>
        <button v-if="canSettle" class="primary" :disabled="busy" @click="settle">结算成果</button>
        <button v-if="canAnswer" class="primary" :disabled="busy" @click="answer(true)">接受邀请</button>
        <button v-if="canAnswer" class="secondary" :disabled="busy" @click="answer(false)">拒绝邀请</button>
        <button v-if="status === 'invited' && team.invitedByMe" class="secondary" :disabled="busy" @click="confirmEnd(true)">撤回邀请</button>
        <button v-if="status === 'active'" class="secondary" :disabled="busy" @click="confirmEnd(false)">退出合作</button>
        <button v-if="status === 'active' || status === 'invited'" class="secondary" :disabled="busy" @click="load">刷新合作</button>
        <button v-else class="secondary" :disabled="busy" @click="load">发起新合作</button>
      </template>
      <PartnerInviteForm v-else :coop="true" :friends="friends" :busy="busy" :enabled="true" @invite="invite" />
      <view v-if="history.length > 0 || historyFailed" class="card">
        <text class="heading">已完成的合作</text>
        <button v-if="historyFailed" class="secondary" @click="loadHistory">重试读取合作记录</button>
        <view v-for="entry in history" :key="entry.id" class="row spread divider menu-row" @click="openCoopStory(entry.runId)">
          <text class="body">{{ completionDate(entry.completedAt) }}</text>
          <text class="muted">查看合作剧情 ›</text>
        </view>
      </view>
    </view>
  </view>
</template>

<script setup lang="uts">
import AppPageHeader from '@/components/AppPageHeader.uvue'
import ProfileAvatar from '@/components/ProfileAvatar.uvue'
import PartnerInviteForm from '../components/PartnerInviteForm.uvue'
import { computed, ref } from 'vue'
import { openCoopStory, openRouteDetail } from '@/features/navigation.uts'
import { showError, secured, session } from '@/features/api.uts'
import { answerCoop, coopTaskText, loadCoop, loadInviteFriends, loadMyCoop, selectedCoopTasks, startCoop, toggleCoopTask } from '@/features/partner/partner.uts'
import type { CoopView, PartnerFriend } from '@/features/partner/partner.uts'

type CoopStoryEntry = { id: string, runId: string, completedAt: number }

const team = ref<CoopView | null>(null)
const history = ref<CoopStoryEntry[]>([])
const historyFailed = ref(false)
const historyLoading = ref(false)
const friends = ref<PartnerFriend[]>([])
const busy = ref(false)
const loading = ref(false)
const loadFailed = ref(false)
const chosen = ref<string[] | null>(null)
const status = computed(() => team.value?.status ?? '')
const statusText = computed(() => status.value === 'active' ? '进行中' : status.value === 'done' ? '已完成' : status.value === 'invited' ? '待接受' : '已结束')
const canSettle = computed(() => status.value === 'active')
const canAnswer = computed(() => status.value === 'invited' && team.value?.invitedByMe === false)
const partnerText = computed(() => team.value?.partner?.nickname ?? '旅伴')
const taskOptions = computed(() => team.value?.myTaskOptions ?? [])
const selectedTasks = computed(() => selectedCoopTasks(taskOptions.value, chosen.value))

function seatName(seat: string): string { return seat === 'macau' ? '澳门' : seat === 'hunan' ? '湖南' : '待分配' }

function isTaskChosen(id: string): boolean {
  return selectedTasks.value.some(task => task.id === id)
}
function toggleTask(id: string): void {
  chosen.value = toggleCoopTask(selectedTasks.value, id)
}
function showTeam(value: CoopView | null): void {
  const previous = team.value
  if (value?.id !== previous?.id || value?.routeId !== previous?.routeId || value?.mySeat !== previous?.mySeat) chosen.value = null
  team.value = value
}

onShow(() => {
  if (!busy.value) load()
  loadHistory()
})

async function loadHistory(): Promise<void> {
  if (historyLoading.value) return
  historyLoading.value = true
  history.value = []
  historyFailed.value = false
  const uid = session.value?.uid
  try {
    const entries = await secured<CoopStoryEntry[]>('coopStoryHistory')
    if (uid == null || session.value?.uid === uid) history.value = entries
  } catch (_) { historyFailed.value = true }
  finally { historyLoading.value = false }
}

function completionDate(value: number): string {
  const date = new Date(value)
  return date.getFullYear() + '年' + (date.getMonth() + 1) + '月' + date.getDate() + '日'
}

function openCurrentStory(): void {
  const runId = team.value?.myRunId
  if (runId != null) openCoopStory(runId)
}

async function load(): Promise<void> {
  if (loading.value) return
  loading.value = true
  loadFailed.value = false
  try {
    showTeam(await loadMyCoop())
    if (team.value == null) friends.value = await loadInviteFriends()
  } catch (_) { loadFailed.value = true }
  finally { loading.value = false }
}

async function invite(code: string, routeId: string, seat: string, activities: string[]): Promise<void> {
  if (busy.value) return
  busy.value = true
  try {
    const result = await startCoop(code, routeId, seat, activities)
    showTeam(await loadCoop(result.id))
  } catch (error) {
    showTeam(await loadMyCoop().catch(() => null))
    if (team.value == null) {
      if ((error as Error).message === 'INVALID_ROUTE') uni.showToast({ title: '两地路线暂未同时开放', icon: 'none' })
      else showError()
    }
  }
  finally { busy.value = false }
}

function explore(): void {
  const value = team.value
  if (value != null && value.myRunId != null) openRouteDetail(value.routeId, value.myRunId)
}

function confirmEnd(withdraw: boolean): void {
  const current = team.value
  if (busy.value || current == null) return
  uni.showModal({
    title: withdraw ? '撤回合作邀请？' : '退出本次合作？',
    content: withdraw ? '好友将无法接受这次邀请。' : '双方将结束本次合作，已保存的打卡记录仍可查看。',
    success: result => { if (result.confirm) endCoop(current.id, withdraw) }
  })
}

async function endCoop(teamId: string, withdraw: boolean): Promise<void> {
  if (busy.value || team.value?.id !== teamId) return
  busy.value = true
  try {
    await secured<UTSJSONObject>(withdraw ? 'withdrawCoop' : 'leaveCoop', { teamId })
    uni.showToast({ title: withdraw ? '邀请已撤回' : '已退出合作', icon: 'success' })
    await load()
  } catch (error) {
    const code = (error as Error).message
    if (code === 'NOT_PENDING' || code === 'NOT_FOUND') await load()
    else showError()
  } finally { busy.value = false }
}

async function settle(): Promise<void> {
  const id = team.value?.id
  if (busy.value || id == null) return
  busy.value = true
  try {
    await secured<UTSJSONObject>('settleCoop', { teamId: id })
    showTeam(await loadCoop(id))
    await loadHistory()
  } catch (error) {
    if ((error as Error).message === 'NOT_READY') uni.showToast({ title: '双方完成席位任务后可结算', icon: 'none' })
    else showError()
  } finally { busy.value = false }
}
async function answer(accept: boolean): Promise<void> {
  const id = team.value?.id
  if (busy.value || id == null || !canAnswer.value) return
  busy.value = true
  try {
    const tasks = accept ? selectedTasks.value.map(task => task.id) : []
    await answerCoop(id, accept, tasks)
    await load()
  } catch (error) {
    const code = (error as Error).message
    if (code === 'EXPIRED' || code === 'NOT_PENDING') {
      uni.showToast({ title: '合作邀请已结束，请重新发起', icon: 'none' })
      await load()
    } else showError()
  }
  finally { busy.value = false }
}
</script>

<style scoped>
@import '@/styles/page.css';
.selected { background: #e2eddb; color: #304d2d; box-shadow: inset 0 0 0 2px #52704a; }
</style>
