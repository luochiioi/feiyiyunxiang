<template>
  <view class="screen">
    <AppPageHeader title="社区" :show-back="true" />
    <view class="content">
      <view class="row filters">
        <button class="secondary" :class="{ active: tab === 'latest' }" @click="select('latest')">最新</button>
        <button class="secondary" :class="{ active: tab === 'friends' }" @click="select('friends')">好友</button>
        <button class="secondary" :class="{ active: tab === 'ranking' }" @click="select('ranking')">好友排行</button>
      </view>
      <view class="row filters">
        <button class="secondary" :class="{ active: tab === 'mine' }" @click="select('mine')">我的帖子</button>
        <button class="secondary" :class="{ active: tab === 'saved' }" @click="select('saved')">我的收藏</button>
      </view>
      <text v-if="message.length > 0" class="body">{{ message }}</text>
      <button v-if="message.length > 0" class="secondary" :disabled="busy" @click="load(false)">重试</button>
      <template v-if="tab === 'ranking'">
        <view class="card">
          <text class="heading">路线完成榜</text>
          <text class="muted">仅本人和好友 · 按完成的探索路线数排名</text>
          <view v-for="row in ranks" :key="row.mine ? 'me' : row.code" class="row spread divider">
            <text class="body">{{ row.rank }}. {{ row.nickname }}{{ row.mine ? '（我）' : '' }}</text>
            <text class="tag">{{ row.count }} 条</text>
          </view>
        </view>
      </template>
      <template v-else>
        <PostCard v-for="post in posts" :key="post.revisionId" :post="post" :detail="false" :preview="tab === 'mine'" :visible="visible" @open="showPost(post)" />
        <view v-if="!busy && message.length === 0 && posts.length === 0 && next.length === 0" class="card"><text class="body">暂无帖子。</text></view>
        <button v-if="next.length > 0" class="secondary" :disabled="busy" @click="load(true)">加载更多</button>
      </template>
      <button class="primary compose" @click="openPage(composePath)">发帖</button>
    </view>
  </view>
</template>

<script setup lang="uts">
import { ref } from 'vue'
import AppPageHeader from '@/components/AppPageHeader.uvue'
import PostCard from '../components/PostCard.uvue'
import { secured } from '@/features/api.uts'
import { openPage } from '@/features/navigation.uts'
import { publicRead, communityError, postPath, composePath } from '@/features/community/community.uts'
import type { Post, PostPage, Ranking } from '@/features/community/community.uts'
const posts = ref<Post[]>([]), ranks = ref<Ranking[]>([]), tab = ref('latest')
const next = ref(''), message = ref(''), busy = ref(false), visible = ref(false)
let sequence = 0
onShow(() => { visible.value = true; load(false) })
onHide(() => { visible.value = false; sequence++ })
function select(value: string): void { if (tab.value !== value) { tab.value = value; load(false) } }
async function load(append: boolean): Promise<void> {
  const call = ++sequence, active = tab.value
  busy.value = true; message.value = ''
  if (!append) { posts.value = []; ranks.value = []; next.value = '' }
  try {
    if (active === 'ranking') {
      const result = await secured<Ranking[]>('communityRanking')
      if (call === sequence) ranks.value = result
    } else {
      const payload: UTSJSONObject = { tab: active, cursor: append ? next.value : '' }
      const result = active === 'latest' ? await publicRead<PostPage>('communityFeed', payload) : await secured<PostPage>('communityFeed', payload)
      if (call === sequence) { posts.value = [...posts.value, ...result.items]; next.value = result.next }
    }
  } catch (error) { if (call === sequence) message.value = communityError(error) }
  finally { if (call === sequence) busy.value = false }
}
function showPost(post: Post): void {
  const preview = tab.value === 'mine' ? '&revisionId=' + encodeURIComponent(post.revisionId) : ''
  openPage(postPath + '?postId=' + encodeURIComponent(post.id) + preview)
}
</script>

<style scoped>
@import '@/styles/page.css';
.filters .secondary { flex: 1; white-space: nowrap; }
.filters .active { background: #426240; color: #fff; }
.compose { position: fixed; width: auto; right: 16px; bottom: calc(15px + env(safe-area-inset-bottom)); box-shadow: 0 3px 12px #35503138; }
.screen { padding-bottom: calc(70px + env(safe-area-inset-bottom)); }
</style>
