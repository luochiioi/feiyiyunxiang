<template>
  <view class="screen">
    <AppPageHeader title="我的" :show-back="true" />
    <view class="content">
      <view class="card row">
        <image class="avatar" src="/static/ip/aomiao-wave.png" mode="aspectFit" />
        <view class="stack">
          <text class="heading">{{ session == null ? '你好，探索者' : '微信已登录' }}</text>
          <text class="muted">{{ session == null ? '游客，可浏览已发布路线' : '小程序账号 ' + session.uid.slice(-10).toUpperCase() }}</text>
        </view>
      </view>
      <view class="card green">
        <view class="row spread">
          <text class="title">{{ aomiao?.claimed === true ? '我的澳喵' : '领取你的澳喵' }}</text>
          <text v-if="aomiao?.claimed === true" class="tag">已领取</text>
        </view>
        <view class="pet-stage">
          <image class="pet" src="/static/ip/aomiao-wave.png" mode="aspectFit" />
        </view>
        <text v-if="roleError.length > 0" class="body">{{ roleError }}</text>
        <button v-if="roleError.length > 0 && aomiao != null" class="secondary" :disabled="busy" @click="loadAomiao">重试读取澳喵</button>
        <button v-if="session == null" class="primary" :disabled="busy" @click="signIn">{{ busy ? '正在登录…' : '微信登录后领取' }}</button>
        <button v-else-if="aomiao == null" class="secondary" :disabled="busy" @click="loadAomiao">{{ busy ? '正在读取澳喵…' : '重试读取澳喵' }}</button>
        <button v-else-if="!aomiao.claimed" class="primary" :disabled="busy" @click="claim">{{ busy ? '正在领取…' : '领取澳喵' }}</button>
        <button v-else class="primary" @click="openPage('/packages/routes/routes/routes')">带澳喵去探索</button>
      </view>
      <view class="card green">
        <text class="heading">探索档案</text><text class="body">回看打卡日记、文化作品和旅伴记录。</text>
        <button class="primary" @click="openPage('/packages/profile/my-checkins/my-checkins')">查看档案</button>
      </view>
      <view class="card">
        <text class="heading">社区记录</text>
        <view class="row spread menu-row" @click="openPage(communityPath + '?tab=mine')"><view class="my-posts-label"><text class="body">我的帖子</text><view v-if="hasUnreadReview" class="review-dot" aria-label="有未读驳回理由" /></view><text class="muted">审核进度 ›</text></view>
        <view class="row spread divider menu-row" @click="openPage(communityPath)"><text class="body">社区</text><text class="muted">›</text></view>
        <!-- #ifdef MP-WEIXIN -->
        <view class="row spread divider menu-row" @click="showPrivacy"><text class="body">隐私保护指引</text><text class="muted">›</text></view>
        <!-- #endif -->
      </view>
      <button v-if="session != null" class="secondary" :disabled="busy" @click="signOut">退出登录</button>
    </view>
  </view>
</template>

<script setup lang="uts">
import AppPageHeader from '@/components/AppPageHeader.uvue'

import { openPage } from '@/features/navigation.uts'
import { computed, ref } from 'vue'
import { session, login, api, secured, clearSession, showError } from '@/features/api.uts'
import { hasUnreadReview, refreshReviewNotices } from '@/features/community/review-notices.uts'
import { communityPath } from '@/features/community/community.uts'
import { activeRun } from '@/features/exploration/catalog.uts'
type Aomiao = { claimed: boolean }
const busy = ref(false)
const roleError = ref('')
const role = ref<Aomiao | null>(null)
const owner = ref('')
const aomiao = computed(() => session.value?.uid === owner.value ? role.value : null)
onShow(() => { if (session.value != null) loadAomiao(); refreshReviewNotices() })

async function updateAomiao(action: string): Promise<void> {
  if (busy.value) return
  busy.value = true
  roleError.value = ''
  const uid = session.value?.uid
  try {
    const value = await secured<Aomiao>(action)
    if (uid != null && session.value?.uid === uid) {
      owner.value = uid
      role.value = value
    }
  } catch (_) {
    roleError.value = '澳喵暂时无法同步，请重试。'
  } finally { busy.value = false }
}
async function loadAomiao(): Promise<void> { await updateAomiao('aomiaoStatus') }
async function claim(): Promise<void> { await updateAomiao('claimAomiao') }
async function signIn(): Promise<void> {
  if (busy.value) return
  busy.value = true
  try {
    await login()
    uni.showToast({ title: '微信登录成功', icon: 'success' })
  } catch (e) {
    const message = (e as Error).message === 'CONFIG_REQUIRED' ? '微信登录尚未配置' : '微信登录未完成，请重试'
    uni.showToast({ title: message, icon: 'none' })
  } finally { busy.value = false }
  if (session.value != null) { await loadAomiao(); await refreshReviewNotices() }
}
function showPrivacy(): void {
  // #ifdef MP-WEIXIN
  wx.openPrivacyContract({ fail: () => uni.showToast({ title: '暂时无法打开隐私保护指引', icon: 'none' }) })
  // #endif
}
async function signOut(): Promise<void> {
  if (busy.value) return
  busy.value = true
  try {
    await api<UTSJSONObject>('logout')
    clearSession()
    activeRun.value = null
    role.value = null
    owner.value = ''
    roleError.value = ''
  } catch (_) { showError() } finally { busy.value = false }
}
</script>

<style scoped>
@import '@/styles/page.css';
.my-posts-label { position: relative; padding-right: 12px; }
.review-dot { position: absolute; right: 0; top: 0; width: 8px; height: 8px; border-radius: 50%; background: #c73535; }
.pet-stage { height: 172px; align-items: center; justify-content: center; border-radius: 14px; background: #f8efd9; }
.pet { width: 158px; height: 158px; }
</style>
