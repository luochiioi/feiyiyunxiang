<template>
  <view class="screen">
    <AppPageHeader title="消息详情" :show-back="true" />
    <view class="content">
      <view v-if="session == null" class="card"><text class="body">请从「我的」登录后查看本人的消息。</text></view>
      <text v-if="loading" class="muted">正在读取消息…</text>
      <view v-if="error.length > 0" class="card"><text class="body">{{ error }}</text><button class="secondary" :disabled="loading" @click="loadDetail">重试读取消息</button></view>
      <view v-if="detail != null" class="card">
        <text class="heading">{{ detail?.title ?? '' }}</text><text class="muted">{{ formatTime(detail?.createdAt ?? 0) }}</text>
        <view v-if="detail?.friend != null" class="reason"><view class="row"><ProfileAvatar :code="detail?.friend?.code ?? ''" :version="detail?.friend?.avatarVersion ?? ''" /><text class="title">{{ detail?.friend?.nickname ?? '旅伴' }}</text></view><text class="body">{{ friendStatusText(detail?.friend?.status ?? 'unavailable') }}</text></view>
        <view v-if="(detail?.reason ?? '').length > 0" class="reason"><text class="title">审核员处理原因</text><text class="body">{{ detail?.reason ?? '' }}</text></view>
        <view v-if="isPostShare" class="share">
          <text class="body">{{ detail?.preview }} 分享了一条帖子。</text>
          <text v-if="detail?.sharedTitle" class="heading">{{ detail?.sharedTitle }}</text>
          <text v-if="detail?.target == null" class="muted">这条帖子当前不可查看。</text>
        </view>
        <text v-else-if="detail?.target == null && detail?.friend == null && detail?.profileTarget == null" class="muted">对应内容已删除或当前不可访问，审核结果仍保留在此。</text>
      </view>
      <view v-if="readError.length > 0" class="card"><text class="body">{{ readError }}</text><button class="secondary" :disabled="reading" @click="markRead">重试标为已读</button></view>
      <button v-if="detail != null && (!isPostShare || canOpenRelated)" class="primary" :disabled="!canOpenRelated" @click="openRelated">{{ relatedLabel }}</button>
    </view>
  </view>
</template>
<script setup lang="uts">
import AppPageHeader from '@/components/AppPageHeader.uvue'
import ProfileAvatar from '@/components/ProfileAvatar.uvue'
import { profileEditPath } from '@/features/profile/profile.uts'
import { computed, ref, watch, nextTick } from 'vue'
import { session } from '@/features/api.uts'
import { loadNotification, readNotification, NotificationDetail } from '@/features/notifications.uts'
import { refreshReviewNotices } from '@/features/community/review-notices.uts'
import { openPage } from '@/features/navigation.uts'
const id = ref(''), detail = ref<NotificationDetail | null>(null)
const error = ref(''), readError = ref(''), loading = ref(false), reading = ref(false)
const isPostShare = computed(() => detail.value?.kind === 'community.post.shared')
const canOpenRelated = computed(() => detail.value?.target != null || detail.value?.profileTarget != null || (detail.value?.friend != null && detail.value!.kind.startsWith('friend.')))
const relatedLabel = computed(() => {
  if (isPostShare.value) return '查看帖子'
  if (detail.value?.profileTarget != null) return '查看资料审核结果'
  if (detail.value?.friend != null && detail.value!.kind.startsWith('friend.')) return detail.value!.friend!.status === 'pending' ? '前往处理好友申请' : '查看旅伴'
  if (detail.value?.target == null) return '内容当前不可访问'
  return detail.value!.kind.startsWith('community.comment.') ? '查看评论所在帖子' : '查看对应帖子详情'
})
let sequence = 0
watch(() => session.value?.uid, () => { sequence++; detail.value = null; error.value = ''; readError.value = ''; loading.value = false; reading.value = false; if (session.value != null) loadDetail() }, { flush: 'sync' })
onLoad((options) => { id.value = options['id'] ?? ''; loadDetail() })
onShow(async () => { if (detail.value?.friend != null) await loadDetail() })
async function loadDetail(): Promise<void> {
  const uid = session.value?.uid
  if (uid == null || loading.value) return
  const request = ++sequence
  loading.value = true; error.value = ''; detail.value = null; readError.value = ''
  try {
    const result = await loadNotification(id.value)
    if (request !== sequence || uid !== session.value?.uid) return
    detail.value = result
    await nextTick()
    if (request !== sequence || uid !== session.value?.uid) return
    await markRead()
  } catch (_) { if (request === sequence && uid === session.value?.uid) error.value = '消息暂时无法读取或已不可用，请重试。' }
  finally { if (request === sequence && uid === session.value?.uid) loading.value = false }
}
async function markRead(): Promise<void> {
  const uid = session.value?.uid, current = detail.value, request = sequence
  if (uid == null || current == null || current.read || reading.value) return
  reading.value = true; readError.value = ''
  try {
    await readNotification(current.id)
    if (request !== sequence || uid !== session.value?.uid) return
    detail.value = { ...current, read: true }
    await refreshReviewNotices()
  } catch (_) { if (request === sequence && uid === session.value?.uid) readError.value = '已读未同步，请重试。消息仍为未读。' }
  finally { if (request === sequence && uid === session.value?.uid) reading.value = false }
}
function openTarget(): void {
  const target = detail.value?.target
  if (target == null) return
  openPage('/packages/community/community-post/community-post?postId=' + encodeURIComponent(target.postId) + (target.preview ? '&revisionId=' + encodeURIComponent(target.revisionId) : ''))
}
function openFriend(): void {
  if (detail.value?.friend == null || !detail.value!.kind.startsWith('friend.')) return
  openPage('/packages/partner/partner/partner')
}
function openRelated(): void {
  if (!canOpenRelated.value) return
  const profile = detail.value?.profileTarget
  if (profile != null) openPage(profileEditPath + '?revisionId=' + encodeURIComponent(profile.revisionId))
  else if (detail.value?.friend != null) openFriend()
  else openTarget()
}
function friendStatusText(status: string): string {
  if (status === 'pending') return '这条好友申请等待你处理，请前往旅伴选择接受或拒绝。'
  if (status === 'accepted') return '好友关系已建立，可以前往旅伴查看。'
  if (status === 'rejected') return '你已拒绝这条好友申请。'
  if (status === 'withdrawn') return '对方已撤回这条好友申请。'
  if (status === 'expired') return '这条好友申请已过期。'
  return '这条申请已失效，或相关账号当前不可用，请到旅伴查看当前状态。'
}
function formatTime(at: number): string { return new Date(at).toLocaleString() }
</script>
<style scoped>
@import '@/styles/page.css';
.reason { gap: 10px; padding: 14px; border-radius: 12px; background: #fff0e9; }
.share { gap: 7px; }
</style>
