import { requestId, secured } from '@/features/api.uts'
import { catalogError, refreshCatalog } from '@/features/exploration/catalog.uts'

export { coopRouteEnabled, partnerView } from './partner-view.uts'
export type { PartnerInput, PartnerView } from './partner-view.uts'

export type PartnerFriend = { code: string, nickname: string, avatarVersion?: string, avatar?: string }
type SeatProgress = { done: number, total: number }
export type CoopTask = { id: string, title: string }
export type CoopView = {
  id: string, status: string, routeId: string, mySeat: string, partnerSeat?: string, myRunId: string | null, invitedByMe: boolean,
  partner: PartnerFriend | null, myProgress?: SeatProgress, partnerProgress?: SeatProgress,
  myTasks: CoopTask[], partnerTasks: CoopTask[], myTaskOptions: CoopTask[]
}
export type PkEgg = { id: string, title: string, description: string, nodeId: string, nodeTitle: string }
export type QuizOption = { id: string, label: string }
export type AssignmentQuiz = { id: string, title: string, prompt: string, hint: string | null, options: QuizOption[] }
export type QuizAnswer = { correct: boolean, alreadyDone: boolean, attempts?: number }
export type PkView = {
  id: string, status: string, routeId: string, invitedBy: string, ready: string[],
  startedAt: number | null, expiresAt: number, myRunId: string | null,
  eggPending: boolean, winner: string | null, partner?: PartnerFriend | null
}
type InviteResult = { id: string }

export function selectedCoopTasks(options: CoopTask[], chosen: string[] | null): CoopTask[] {
  if (chosen == null) return options
  const selected = options.filter(task => chosen.includes(task.id))
  return selected.length > 0 ? selected : options
}
export function toggleCoopTask(selected: CoopTask[], id: string): string[] {
  const ids = selected.map(task => task.id)
  if (!ids.includes(id)) return [...ids, id]
  if (ids.length === 1) {
    uni.showToast({ title: '至少保留一项文化任务', icon: 'none' })
    return ids
  }
  return ids.filter(item => item !== id)
}
export function coopTaskText(tasks: CoopTask[], emptyText = '全部文化任务'): string {
  return tasks.length === 0 ? emptyText : tasks.map(task => task.title).join('、')
}

export function loadFriends(): Promise<UTSJSONObject[]> { return secured<UTSJSONObject[]>('friends') }
export function loadAssignment(): Promise<UTSJSONObject | null> { return secured<UTSJSONObject | null>('assignment') }
export function loadCoop(teamId: string): Promise<CoopView> { return secured<CoopView>('coopStatus', { teamId }) }
export function loadMyCoop(): Promise<CoopView | null> { return secured<CoopView | null>('myCoop') }
export function loadMyPk(): Promise<PkView | null> { return secured<PkView | null>('myPk') }
export function loadPkEggs(matchId: string): Promise<PkEgg[]> { return secured<PkEgg[]>('pkEggs', { matchId }) }
export function choosePkEgg(matchId: string, eggId: string): Promise<UTSJSONObject> {
  return secured<UTSJSONObject>('chooseEgg', { matchId, eggId })
}
export function startCoop(code: string, routeId: string, seat: string, activities: string[]): Promise<InviteResult> {
  const payload: UTSJSONObject = { code, routeId, seat, requestId: requestId() }
  if (activities.length > 0) payload['activities'] = activities
  return secured<InviteResult>('inviteCoop', payload)
}
export function startPk(code: string, routeId: string): Promise<InviteResult> {
  return secured<InviteResult>('invitePk', { code, routeId, requestId: requestId() })
}
export async function loadInviteFriends(): Promise<PartnerFriend[]> {
  const [rows] = await Promise.all([loadFriends(), refreshCatalog()])
  if (catalogError.value) throw new Error('CATALOG_UNAVAILABLE')
  return rows.filter(row => row['kind'] !== 'incoming').map(row => ({
    code: row['code'] as string, nickname: row['nickname'] as string,
    avatarVersion: row['avatarVersion'] as string | null ?? '', avatar: row['avatar'] as string | null ?? ''
  }))
}
export function sendFriendRequest(code: string, requestId: string): Promise<UTSJSONObject> {
  return secured<UTSJSONObject>('requestFriend', { code, requestId })
}
export function answerFriendRequest(requestId: string, accept: boolean): Promise<UTSJSONObject> {
  return secured<UTSJSONObject>('respondFriend', { requestId, accept })
}
export function answerCoop(teamId: string, accept: boolean, activities: string[]): Promise<UTSJSONObject> {
  const payload: UTSJSONObject = { teamId, accept }
  if (!accept || activities.length > 0) payload['activities'] = activities
  return secured<UTSJSONObject>('respondCoop', payload)
}
export function answerPk(matchId: string, accept: boolean): Promise<UTSJSONObject> {
  return secured<UTSJSONObject>('respondPk', { matchId, accept })
}
export function markReady(matchId: string): Promise<UTSJSONObject> { return secured<UTSJSONObject>('readyPk', { matchId }) }
export function settlePk(matchId: string): Promise<{ winner: string | null, expired: boolean, eggPending: boolean }> {
  return secured<{ winner: string | null, expired: boolean, eggPending: boolean }>('settlePk', { matchId })
}
export function finishAssignment(assignmentId: string): Promise<UTSJSONObject> {
  return secured<UTSJSONObject>('completeAssignment', { assignmentId })
}
export function declineAssignment(assignmentId: string): Promise<UTSJSONObject> {
  return secured<UTSJSONObject>('rejectAssignment', { assignmentId })
}
export function loadAssignmentQuiz(assignmentId: string): Promise<AssignmentQuiz> {
  return secured<AssignmentQuiz>('assignmentQuiz', { assignmentId })
}
export function answerAssignmentQuiz(assignmentId: string, optionId: string): Promise<QuizAnswer> {
  return secured<QuizAnswer>('answerAssignment', { assignmentId, optionId })
}
