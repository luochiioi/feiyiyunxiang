import { ref } from 'vue'
export type AdminSession = { uid: string, username: string, token: string, expiresAt: number, admin?: boolean }
export type ProfileReviewItem = { revisionId: string, nickname: string, bio: string, displayCity: string, interests: string[], status: string, createdAt: number, reason: string, hasAvatar: boolean, avatar?: string }
export type ProfileReviewPage = { items: ProfileReviewItem[], next: string }
type CurrentProfile = { nickname: string, bio: string, displayCity: string, interests: string[], avatarVersion: string, avatar?: string }
export type ProfileReviewDetail = { selected: ProfileReviewItem, current: CurrentProfile, accountActive: boolean }
export const session = ref<AdminSession | null>(null)
type Reply<T> = { code: string, data: T }
// Keep administrator tokens only in memory; reload requires login again.
export async function api<T>(action: string, payload: UTSJSONObject = {}): Promise<T> {
  const response = await uniCloud.callFunction<Reply<T>>({ name: 'fy-api', data: { action, payload, token: session.value?.token ?? '' } })
  if (response.result.code !== 'OK') {
    if (response.result.code === 'AUTH_REQUIRED') session.value = null
    throw new Error(response.result.code)
  }
  return response.result.data
}
