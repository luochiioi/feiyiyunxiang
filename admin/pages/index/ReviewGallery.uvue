<template>
  <view v-if="photos.length > 0" class="gallery">
    <view v-for="photo in photos" :key="photo.index" class="photo-tile">
      <image v-if="photo.src.length > 0" class="photo" :src="photo.src" mode="aspectFill"
        @click="preview(photo)" @error="imageFailed(photo)" />
      <view v-else class="photo-placeholder">
        <text class="photo-caption">{{ photo.status === 'loading' ? '图片加载中…' : '图片读取失败' }}</text>
        <button v-if="photo.status === 'failed'" class="retry" @click="loadPhoto(photo)">重试图片</button>
      </view>
      <text class="photo-number">{{ photo.index + 1 }}</text>
    </view>
  </view>
</template>
<script setup lang="uts">
import { ref, watch, onUnmounted } from 'vue'
import { api } from '@/features/api.uts'
type Photo = { index: number, src: string, status: string }
const props = defineProps<{ postId: string, revisionId: string, imageCount: number }>()
const photos = ref<Photo[]>([])
let generation = 0
onUnmounted(() => { generation++ })
watch(() => props.postId + '/' + props.revisionId + '/' + props.imageCount, () => { loadGallery() }, { immediate: true })
async function fetchPhoto(photo: Photo, request: number, postId: string, revisionId: string): Promise<void> {
  photo.status = 'loading'; photo.src = ''
  try {
    const result = await api<{ src: string }>('communityReviewImage', { postId, revisionId, index: photo.index })
    if (request !== generation) return
    photo.src = result.src; photo.status = 'ready'
  } catch (_) {
    if (request === generation) photo.status = 'failed'
  }
}
async function loadGallery(): Promise<void> {
  const request = ++generation, postId = props.postId, revisionId = props.revisionId
  photos.value = Array.from({ length: Math.max(0, Math.min(9, props.imageCount)) },
    (_, index) => ({ index, src: '', status: 'loading' }))
  const items = photos.value
  let next = 0
  async function worker(): Promise<void> {
    while (request === generation && next < items.length) {
      const photo = items[next++]
      await fetchPhoto(photo, request, postId, revisionId)
    }
  }
  await Promise.all([worker(), worker(), worker()])
}
async function loadPhoto(photo: Photo): Promise<void> {
  if (photo.status === 'loading') return
  await fetchPhoto(photo, generation, props.postId, props.revisionId)
}
function imageFailed(photo: Photo): void { photo.src = ''; photo.status = 'failed' }
function preview(photo: Photo): void {
  const urls = photos.value.filter(item => item.src.length > 0).map(item => item.src)
  if (photo.src.length > 0) uni.previewImage({ current: photo.src, urls })
}
</script>
<style scoped>
.gallery { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 8px; }
.photo-tile { position: relative; min-width: 0; aspect-ratio: 1; overflow: hidden; border-radius: 9px; background: #eeeadd; }
.photo, .photo-placeholder { width: 100%; height: 100%; }
.photo { cursor: zoom-in; }
.photo-placeholder { display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 6px; padding: 8px; box-sizing: border-box; }
.photo-caption { font-size: 12px; color: #746b5f; text-align: center; }
.photo-number { position: absolute; right: 5px; bottom: 5px; min-width: 18px; padding: 2px 4px; text-align: center; border-radius: 4px; background: #0008; color: #fff; font-size: 11px; pointer-events: none; }
.retry { font-size: 12px; margin: 0; padding: 0 8px; line-height: 28px; }
</style>
