<template>
  <view class="cropper">
    <text class="heading">裁剪头像</text>
    <text class="muted">缩放或移动照片，头像会显示圆圈内的区域。</text>
    <view class="crop-frame">
      <canvas id="profile-avatar-crop" type="2d" class="crop-canvas" />
    </view>
    <text v-if="failed" class="muted" role="status">这张照片暂时无法裁剪。请重试或选择另一张。</text>
    <template v-if="ready">
      <view class="control">
        <text class="muted">缩放</text>
        <slider :value="zoom" :min="100" :max="300" :step="5" activeColor="#426240" @changing="setZoom($event.detail.value)" @change="setZoom($event.detail.value)" />
      </view>
      <view v-if="canMoveX" class="control">
        <text class="muted">左右移动</text>
        <slider :value="x" :min="0" :max="100" activeColor="#426240" @changing="setX($event.detail.value)" @change="setX($event.detail.value)" />
      </view>
      <view v-if="canMoveY" class="control">
        <text class="muted">上下移动</text>
        <slider :value="y" :min="0" :max="100" activeColor="#426240" @changing="setY($event.detail.value)" @change="setY($event.detail.value)" />
      </view>
    </template>
    <view class="row crop-buttons">
      <button class="secondary" @click="emit('cancel')">取消裁剪</button>
      <button v-if="failed" class="primary" @click="load">重试裁剪</button>
      <button v-else class="primary" :disabled="!ready" @click="confirm">使用此裁剪</button>
    </view>
  </view>
</template>

<script setup lang="uts">
import { computed, getCurrentInstance, onBeforeUnmount, onMounted, ref } from 'vue'
import { avatarCrop, avatarSize } from '@/features/profile/avatar-crop.uts'

const props = defineProps<{ source: string }>()
const emit = defineEmits<{ (event: 'cancel'): void, (event: 'confirm', value: string): void }>()
const instance = getCurrentInstance()!.proxy
const width = ref(0), height = ref(0), zoom = ref(100), x = ref(50), y = ref(50)
const ready = ref(false), failed = ref(false)
const canMoveX = computed(() => width.value > height.value || zoom.value > 100)
const canMoveY = computed(() => height.value > width.value || zoom.value > 100)
let generation = 0
let canvas: CanvasContext | null = null
let picture: Image | null = null

onMounted(load)
onBeforeUnmount(() => { generation++; canvas = null; picture = null })

function load(): void {
  const ticket = ++generation
  ready.value = false
  failed.value = false
  uni.createCanvasContextAsync({
    id: 'profile-avatar-crop', component: instance,
    success: context => {
      if (ticket !== generation) return
      const drawable = context.getContext('2d')
      if (drawable == null) { failed.value = true; return }
      const image = context.createImage()
      image.onload = () => {
        if (ticket !== generation) return
        if (image.width <= 0 || image.height <= 0) { failed.value = true; return }
        drawable.canvas.width = avatarSize
        drawable.canvas.height = avatarSize
        width.value = image.width; height.value = image.height
        canvas = context; picture = image
        ready.value = draw()
      }
      image.onerror = () => { if (ticket === generation) failed.value = true }
      image.src = props.source
    },
    fail: () => { if (ticket === generation) failed.value = true }
  })
}

function draw(): boolean {
  const context = canvas?.getContext('2d')
  const image = picture
  if (context == null || image == null) return false
  try {
    const crop = avatarCrop(width.value, height.value, zoom.value / 100, x.value, y.value)
    context.clearRect(0, 0, avatarSize, avatarSize)
    context.drawImage(image, crop.x, crop.y, crop.side, crop.side, 0, 0, avatarSize, avatarSize)
    return true
  } catch (_) { failed.value = true; return false }
}
function setZoom(value: number): void { zoom.value = value; draw() }
function setX(value: number): void { x.value = value; draw() }
function setY(value: number): void { y.value = value; draw() }

function confirm(): void {
  if (!ready.value || !draw()) return
  try {
    const data = canvas?.toDataURL() ?? ''
    if (!data.startsWith('data:image/png;base64,') || data.length > 1398104) throw new Error('INVALID_IMAGE')
    emit('confirm', data)
  } catch (_) { failed.value = true }
}
</script>

<style scoped>
@import '@/styles/page.css';
.cropper { padding: 12px; gap: 8px; border: 1px solid #e8dbc9; border-radius: 14px; background: #fffaf4; }
.crop-frame { align-self: center; width: 232px; height: 232px; border-radius: 50%; overflow: hidden; background: #f0e7d8; }
.crop-canvas { width: 232px; height: 232px; border-radius: 50%; }
.control { gap: 3px; }
slider { margin: 0 8px; }
.crop-buttons > button { flex: 1; width: auto; }
</style>
