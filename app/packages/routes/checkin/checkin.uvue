<template>
  <view class="screen">
    <AppPageHeader title="私密打卡" :show-back="true" />
    <view class="content">
      <view v-if="loading" class="card"><text class="body">正在加载打卡点…</text></view>
      <template v-else-if="node != null">
        <text class="title">{{ node.title }}</text>
        <text class="body">{{ node.description }}</text>
        <text v-if="node.alternate != null" class="body">{{ node.alternate }}</text>
        <view v-if="clue != null && !locked" class="card">
          <text class="heading">展品故事</text>
          <text class="body">{{ clue?.story }}</text>
          <template v-if="ready && !completed">
            <text class="body">{{ clue?.question }}</text>
            <view v-if="clue?.options != null" class="clue-choices">
              <button v-for="option in clue?.options" :key="option" :class="clueAnswer === option ? 'primary' : 'secondary'" :disabled="busy" @click="pickClue(option)">{{ option }}</button>
            </view>
            <input v-else v-model="clueAnswer" class="clue-input" :disabled="busy && !locating" maxlength="80" placeholder="输入线索密码" @blur="saveClueDraft" />
          </template>
        </view>
        <view v-if="completed" class="card green">
          <view class="row spread"><text class="heading">我的打卡</text><text class="tag">仅本人可见</text></view>
          <template v-if="record != null">
            <text class="muted">{{ new Date(record.createdAt).toLocaleString() }}</text>
            <image v-if="recordPhoto.length > 0" :src="recordPhoto" mode="aspectFit" class="saved-photo" />
            <text v-if="photoUnavailable" class="muted">这次打卡的原照片未保存到云端。</text>
            <button v-else-if="photoFailed" class="secondary" :disabled="busy" @click="loadRecordPhoto">重试读取照片</button>
            <text v-if="record.note.length > 0" class="body">{{ record.note }}</text>
            <button v-if="node.reward != null" class="secondary" @click="openReward">打开已解锁的文化内容</button>
          </template>
          <button v-else class="secondary" :disabled="busy" @click="prepare">查看我的打卡</button>
        </view>
        <view v-else-if="session == null" class="card">
          <text class="body">登录后可以打卡和查看自己的记录。</text>
          <button class="primary" :disabled="busy" @click="signIn">{{ busy ? '正在登录…' : '微信登录' }}</button>
        </view>
        <view v-else-if="locked" class="card">
          <text class="body">请先完成上一站的线索打卡，再来探索这一站。</text>
          <button class="secondary" :disabled="busy" @click="prepare">刷新解锁进度</button>
        </view>
        <template v-else-if="ready">
          <view v-if="node.reward == null" class="card green">
            <text class="body">{{ locationStatus }}</text>
            <button v-if="locationPermissionDenied" class="secondary" :disabled="busy" @click="openLocationSettings">打开定位授权设置</button>
            <button v-else-if="locationRetry" class="secondary" :disabled="busy" @click="previewLocation">重新定位</button>
          </view>
          <view class="card">
            <text class="heading">照片与日记</text>
            <image v-if="photo.length > 0" :src="photo" mode="aspectFit" class="saved-photo" />
            <button class="secondary" :disabled="busy" @click="choose">{{ node.reward == null ? '拍照 / 选择照片（不超过 1MB）' : '拍摄展品或展板（不超过 1MB）' }}</button>
            <textarea v-model="note" :disabled="busy" maxlength="1000" :placeholder="node.reward == null ? '记下这一站（仅自己可见）' : '记下一条展品观察（仅自己可见）'" @input="saveDraft" />
          </view>
          <button class="primary" :disabled="busy || photo.length === 0 || (clue != null && clueAnswer.trim().length === 0)" @click="submit">{{ busy ? '处理中…' : '提交打卡' }}</button>
        </template>
        <text v-else-if="busy" class="body">正在准备打卡…</text>
        <button v-else class="secondary" @click="prepare">重试加载打卡</button>
        <text v-if="status.length > 0" class="body">{{ status }}</text>
      </template>
      <view v-else-if="scopedRunId != null" class="card">
        <text class="body">{{ busy ? '正在加载打卡点…' : status }}</text>
        <button v-if="!busy" class="secondary" @click="prepare">重试加载打卡</button>
      </view>
      <view v-else class="card"><text class="body">点位不可用，请从已发布路线进入。</text></view>
    </view>
  </view>
</template>
<script setup lang="uts">
import { ref, computed } from 'vue'
import AppPageHeader from '@/components/AppPageHeader.uvue'
import { findNode, loadRun, startRoute, refreshCatalog } from '@/features/exploration/catalog.uts'
import type { PublishedNode, RunProgress } from '@/features/exploration/catalog.uts'
import type { ExhibitClue, MapPosition, RouteNode } from '@/features/exploration/types.uts'
import { distanceMeters, locationFailureCode, validLocation } from '@/features/exploration/checkin-location.uts'
import { login, secured, session, requestId } from '@/features/api.uts'
import { decodePageId, openCultureActivity } from '@/features/navigation.uts'
type Draft = { requestId: string, base64: string, mime: string, note: string, mediaId: string, clueAnswer?: string }
type NodeRecord = { createdAt: number, note: string, mediaId: string }
const id = ref<string | null>(null)
const scopedRunId = ref<string | null>(null)
const scopedRun = ref<RunProgress | null>(null)
const node = computed<RouteNode | null>(() => {
  if (scopedRunId.value == null) return findNode(id.value)
  const run = scopedRun.value
  if (run == null) return null
  const exhibit = run.snapshot.exhibit
  const point = exhibit != null && run.routeId + ':' + exhibit.id === id.value
    ? exhibit : run.snapshot.nodes.find(item => run.routeId + ':' + item.id === id.value)
  return point == null ? null : { ...point, id: run.routeId + ':' + point.id, routeId: run.routeId, markerId: 0, checked: run.completed.includes(point.id) || (point.reward != null && run.exhibitCompleted === true) }
})
const loading = ref(false)
const ready = ref(false), busy = ref(false), completed = ref(false)
const clue = ref<ExhibitClue | null>(null), clueAnswer = ref(''), locked = ref(false)
const record = ref<NodeRecord | null>(null), recordPhoto = ref(''), photoFailed = ref(false)
const photoUnavailable = ref(false)
const photo = ref(''), note = ref(''), status = ref('')
const locating = ref(false), locationStatus = ref(''), locationPermissionDenied = ref(false), locationRetry = ref(false)
let draft: Draft = { requestId: '', base64: '', mime: '', note: '', mediaId: '' }
let draftKey = ''
let exploration: RunProgress | null = null
onLoad(async query => {
  id.value = decodePageId(query['nodeId'] ?? null)
  scopedRunId.value = decodePageId(query['runId'] ?? null)
  if (scopedRunId.value != null) {
    await prepare()
    return
  }
  if (id.value != null && node.value == null) {
    loading.value = true
    await refreshCatalog()
    loading.value = false
  }
  clue.value = node.value?.clue ?? null
  if (session.value != null) await prepare()
})
onHide(saveClueDraft)
onUnload(saveClueDraft)
function saveDraft(): void {
  if (draftKey.length === 0 || completed.value) return
  const saved: Draft = { ...draft, note: note.value, clueAnswer: clueAnswer.value }
  uni.setStorageSync(draftKey, JSON.stringify(saved))
  draft = saved
}
function pickClue(option: string): void {
  clueAnswer.value = option
  saveClueDraft()
}
function openReward(): void {
  const run = exploration
  const reward = node.value?.reward
  if (run != null && reward != null) openCultureActivity(run.routeId, reward, run.runId)
}
function saveClueDraft(): void {
  if (clueAnswer.value === (draft.clueAnswer ?? '')) return
  try { saveDraft() }
  catch (_) { status.value = '线索答案暂未保存，请检查本机存储空间。' }
}
async function prepare(): Promise<void> {
  if (busy.value || (scopedRunId.value == null && (node.value == null || session.value == null))) return
  busy.value = true
  ready.value = false
  locked.value = false
  status.value = ''
  try {
    if (scopedRunId.value != null) {
      const parts = id.value?.split(':') ?? []
      if (parts.length !== 2) throw new Error('NOT_FOUND')
      scopedRun.value = await loadRun(parts[0], scopedRunId.value!)
    }
    const item = node.value
    if (item == null) throw new Error('NOT_FOUND')
    if (scopedRun.value != null) exploration = scopedRun.value
    else if (item.clue != null || item.afterClue != null) {
      const selected = exploration ?? await startRoute(item.routeId)
      exploration = await loadRun(item.routeId, selected.runId)
    }
    if (await loadRecord()) return
    exploration = exploration ?? scopedRun.value ?? await startRoute(item.routeId)
    const target = currentRunNode()
    clue.value = target.clue ?? null
    locked.value = target.afterClue != null && !exploration!.completed.includes(target.afterClue!)
    if (locked.value) return
    draftKey = 'fy-draft-' + session.value!.uid + '-' + exploration!.runId + '-' + id.value
    const saved = uni.getStorageSync(draftKey) as string
    draft = { requestId: requestId(), base64: '', mime: '', note: '', mediaId: '' }
    if (saved != null && saved.length > 0) {
      try { draft = JSON.parse<Draft>(saved) ?? draft } catch (_) { uni.removeStorageSync(draftKey) }
    }
    note.value = draft.note
    clueAnswer.value = draft.clueAnswer ?? ''
    photo.value = draft.base64.length > 0 ? 'data:' + draft.mime + ';base64,' + draft.base64 : ''
    ready.value = true
    if (target.reward == null) await checkLocation()
  } catch (_) { status.value = '打卡信息暂时无法加载，请检查网络后重试。' }
  finally { busy.value = false }
}
async function signIn(): Promise<void> {
  if (busy.value) return
  busy.value = true
  status.value = ''
  try { await login() }
  catch (_) { status.value = '微信登录未完成，请重试。' }
  finally { busy.value = false }
  if (session.value != null) await prepare()
}
async function loadRecord(): Promise<boolean> {
  const item = node.value
  const owner = session.value?.uid
  if (item == null || owner == null) return false
  const nodeId = item.id.split(':')[1]
  const recordRunId = scopedRunId.value ?? exploration?.runId ?? null
  const payload: UTSJSONObject = recordRunId == null
    ? { routeId: item.routeId, nodeId }
    : { routeId: item.routeId, nodeId, runId: recordRunId }
  const saved = await secured<NodeRecord | null>('nodeRecord', payload)
  if (session.value?.uid !== owner) throw new Error('AUTH_REQUIRED')
  if (saved == null) return false
  record.value = saved
  completed.value = true
  ready.value = false
  await loadRecordPhoto()
  return true
}
async function loadRecordPhoto(): Promise<void> {
  const item = record.value
  const owner = session.value?.uid
  if (item == null || owner == null) return
  photoFailed.value = false
  photoUnavailable.value = false
  try {
    const result = await secured<{ src: string }>('readMedia', { id: item.mediaId })
    if (session.value?.uid === owner) recordPhoto.value = result.src
  } catch (error) {
    photoUnavailable.value = (error as Error | null)?.message === 'PHOTO_UNAVAILABLE'
    photoFailed.value = !photoUnavailable.value
  }
}
function choose(): void {
  const sourceType = node.value?.reward != null ? ['camera'] : ['camera', 'album']
  uni.chooseImage({ count: 1, sourceType, sizeType: ['compressed'], success: result => {
    const path = result.tempFilePaths[0]
    // #ifdef MP-WEIXIN
    uni.getFileSystemManager().readFile({ filePath: path, encoding: 'base64', success: file => {
      const base64 = file.data as string
      if (base64.length > 1398104) { status.value = '照片过大，请选择小于 1MB 的 JPG 或 PNG。'; return }
      draft.base64 = base64; draft.mime = base64.startsWith('iVBOR') ? 'image/png' : 'image/jpeg'
      draft.mediaId = ''; photo.value = 'data:' + draft.mime + ';base64,' + base64; saveDraft()
    }, fail: () => { status.value = '照片读取失败，请重新选择。' } })
    // #endif
  } })
}
function currentRunNode(): PublishedNode {
  const item = node.value
  const run = exploration
  if (item == null || run == null || run.routeId !== item.routeId) throw new Error('NOT_FOUND')
  const nodeId = item.id.split(':')[1]
  const exhibit = run.snapshot.exhibit
  const target = exhibit != null && exhibit.id === nodeId ? exhibit : run.snapshot.nodes.find(n => n.id === nodeId)
  if (target == null) throw new Error('NOT_FOUND')
  return target
}
function getCheckinLocation(): Promise<MapPosition> {
  locationStatus.value = '正在获取当前位置…'
  locationPermissionDenied.value = false
  locationRetry.value = false
  return new Promise<MapPosition>((resolve, reject) => {
    uni.getLocation({
      type: 'gcj02',
      success: result => {
        const position: MapPosition = { latitude: result.latitude, longitude: result.longitude }
        if (validLocation(position)) resolve(position)
        else reject(new Error('INVALID_LOCATION'))
      },
      fail: error => reject(new Error(locationFailureCode(error.errMsg ?? '')))
    })
  })
}
function showLocationResult(target: PublishedNode, position: MapPosition): boolean {
  const meters = distanceMeters({ latitude: target.latitude, longitude: target.longitude }, position)
  const withinRange = meters <= target.radius
  locationRetry.value = !withinRange
  locationStatus.value = (withinRange ? '在打卡范围内' : '超出打卡范围') +
    '。距点位约 ' + Math.round(meters) + ' 米，打卡范围 ' + target.radius + ' 米。'
  return withinRange
}
function showLocationFailure(code: string): void {
  locationPermissionDenied.value = code === 'LOCATION_PERMISSION'
  locationRetry.value = !locationPermissionDenied.value
  if (code === 'LOCATION_PERMISSION') locationStatus.value = '请开启定位权限后继续打卡。'
  else if (code === 'LOCATION_PRIVACY') locationStatus.value = '微信隐私授权未完成，请同意隐私指引或联系管理员检查配置。'
  else if (code === 'NOT_FOUND') locationStatus.value = '当前探索已变更，请返回后重新进入打卡点。'
  else locationStatus.value = '无法获取当前位置，请确认系统定位已开启后重试。'
}
function openLocationSettings(): void {
  // #ifdef MP-WEIXIN
  uni.openSetting({ success: result => { if (result.authSetting['scope.userLocation'] === true) previewLocation() } })
  // #endif
}
async function checkLocation(): Promise<void> {
  locating.value = true
  try {
    const target = currentRunNode()
    showLocationResult(target, await getCheckinLocation())
  } catch (error) {
    showLocationFailure((error as Error | null)?.message ?? '')
  } finally { locating.value = false }
}
async function previewLocation(): Promise<void> {
  if (busy.value || !ready.value) return
  busy.value = true
  try { await checkLocation() } finally { busy.value = false }
}
async function submit(): Promise<void> {
  if (busy.value || !ready.value || node.value == null || photo.value.length === 0 || completed.value) return
  busy.value = true
  let stage = 'draft'
  try {
    saveDraft()
    stage = 'location'
    status.value = ''
    const target = currentRunNode()
    const runId = exploration!.runId
    const nodeId = target.id
    const location = target.reward == null ? await getCheckinLocation() : null
    const withinRange = location == null || showLocationResult(target, location)
    // An existing media ID may be part of a retry after a lost success response.
    if (!withinRange && draft.mediaId.length === 0) {
      status.value = '请进入打卡范围后重试，草稿已保留。'
      return
    }
    stage = 'photo'
    status.value = '正在保存私密照片…'
    if (draft.mediaId.length === 0) {
      const media = await secured<{ id: string }>('uploadMedia', { runId, nodeId, requestId: draft.requestId, base64: draft.base64 })
      draft.mediaId = media.id; saveDraft()
    }
    stage = 'checkin'
    status.value = '正在校验打卡…'
    await secured<{ id: string }>('checkin', { runId, nodeId, requestId: draft.requestId, mediaId: draft.mediaId, latitude: location?.latitude ?? null, longitude: location?.longitude ?? null, note: note.value, clueAnswer: clueAnswer.value })
    completed.value = true
    ready.value = false
    status.value = '打卡已保存，仅本人可见。'
    uni.removeStorageSync(draftKey)
    await Promise.allSettled([refreshCatalog(), loadRecord()])
  } catch (error) {
    if (completed.value) return
    const code = (error as Error | null)?.message ?? ''
    if (stage === 'draft') status.value = '本机草稿保存失败，请检查存储空间后重试。'
    else if (stage === 'location') {
      showLocationFailure(code)
      status.value = '打卡未提交，草稿已保留。'
    } else if (code === 'CONFIG_REQUIRED' && stage === 'photo') {
      status.value = '私密照片存储尚未启用，请联系管理员。照片和备注已保留。'
    } else if (code === 'PHOTO_UNAVAILABLE' && stage === 'checkin') {
      draft.mediaId = ''
      saveDraft()
      status.value = '照片未保存到云端，请重新提交。草稿已保留。'
    } else if (code === 'CLUE_INCORRECT') status.value = clue.value?.options == null
      ? '线索密码不正确。请再读一遍展品故事，照片草稿已保留。'
      : '观察题答错了。请再试一次，照片草稿已保留。'
    else if (code === 'CLUE_LOCKED') status.value = '请先完成上一站的线索打卡。'
    else if (code === 'INVALID_IMAGE') status.value = '照片格式不支持，请重新选择 1 MB 以内的 JPG 或 PNG。'
    else if (code === 'OUTSIDE_RANGE') status.value = '服务端确认当前位置超出打卡范围。请到达点位后重试，草稿已保留。'
    else if (code === 'AUTH_REQUIRED' || code === 'LOGIN_FAILED') status.value = '登录已失效，请重新登录后重试，草稿已保留。'
    else status.value = (stage === 'photo' ? '照片上传失败' : '打卡提交失败') + '，请检查网络后重试，草稿已保留。'
  } finally { busy.value = false }
}
</script>
<style scoped>
@import '@/styles/page.css';
textarea, .clue-input { width: 100%; box-sizing: border-box; background: #f6f7f0; border-radius: 12px; }
textarea { padding: 12px; }
.clue-input { height: 46px; padding: 0 12px; font-size: 16px; color: #332b24; }
.clue-choices { display: flex; flex-direction: column; gap: 8px; }
.saved-photo { width: 100%; height: 220px; }
</style>
