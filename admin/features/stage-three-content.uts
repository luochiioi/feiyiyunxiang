export type DraftClue = { story: string, question: string, answer: string }
export type DraftNode = { id: string, title: string, description: string, latitude: number, longitude: number, radius: number, clue?: DraftClue | null, afterClue?: string | null }
type Choice = { label: string, nextSceneId: string }
type Scene = { id: string, kind: string, text: string, asset?: string, speaker?: string, nextSceneId?: string, choices?: Choice[] }
type Chapter = { act: number, title: string, after: string[], checkinMode?: string, start: string, scenes: Scene[], activity?: string | null }
type Activity = { title: string, after: string[] }
export type Quiz = { title: string, after: string[], prompt: string, hint?: string, explanation: string, options: QuizOption[], answer: string }
type QuizOption = { id: string, label: string, illustration: string }
type Learning = { title: string, after: string[], cards: LearningCard[] }
type LearningCard = { id: string, title: string, hotspot: string, body: string, illustration?: string }
export type CultureContent = { tile?: Activity, tileQuiz?: Quiz, quiz?: Quiz, learning?: Learning, chapters?: Chapter[] }
export type DraftPreview = { name: string, region: string, testOnly: boolean, releaseAllowed: boolean, nodes: DraftNode[], culture?: CultureContent }

export function combinedContent(nodeIds: string[]): CultureContent {
  const macau = macauContent(nodeIds)
  const hunan = hunanContent()
  return { ...macau, ...hunan, chapters: [...(macau.chapters ?? []), ...(hunan.chapters ?? [])] }
}

export function scriptedContent(nodeIds: string[]): CultureContent {
  const content = combinedContent(nodeIds)
  const chapters: Chapter[] = [
    // 分镜 7–13
    { act: 2, title: '海上风暴', after: nodeIds, checkinMode: 'any', start: 'wave', scenes: [
      { id: 'wave', kind: 'dialogue', speaker: '旁白', text: '你睁开眼，木船正在海风里摇晃。船头方向传来船长的呼喊。', nextSceneId: 'hold' },
      { id: 'hold', kind: 'dialogue', speaker: '船长', text: '扶住船舷，先让大家站稳！', nextSceneId: 'tile' },
      { id: 'tile', kind: 'dialogue', speaker: '旁白', text: '颜料罐滚到脚边。你抱起一块蓝白瓷砖，巨浪把你推向舱壁。', nextSceneId: 'sailor' },
      { id: 'sailor', kind: 'dialogue', speaker: '船员', text: '抓住我！舱门在这边！', nextSceneId: 'dawn' },
      { id: 'dawn', kind: 'ending', text: '怀里的瓷砖还完好。你想起和女儿描花纹的那天，一道浪遮住视野，黑暗里慢慢浮出作坊的暖光。' }
    ] },
    // 分镜 14–23
    { act: 3, title: '女儿与瓷砖', after: [], start: 'pattern', scenes: [
      { id: 'pattern', kind: 'dialogue', asset: 'tile-workshop', speaker: '旁白', text: '阳光落在作坊的木桌上，桌上摆着陶土、模具、颜料和画笔。女儿把试稿推到你面前。', nextSceneId: 'color' },
      { id: 'color', kind: 'dialogue', speaker: '女儿', text: '玫瑰、海浪帆船和几何纹样，你选的蓝白配色就在这张试稿上。', nextSceneId: 'kiln' },
      { id: 'kiln', kind: 'dialogue', speaker: '旁白', text: '你们在瓷坯上描下选定的纹样。窑门打开后，你们把烧好的瓷砖嵌在房间墙上。', nextSceneId: 'work' },
      { id: 'work', kind: 'ending', text: '女儿的身影渐渐淡去。你取下瓷砖抱在怀里，耳边的笑声变回了海浪。' }
    ] },
    // 分镜 24–26
    { act: 4, title: '澳门靠岸', after: [], start: 'shore', scenes: [
      { id: 'shore', kind: 'dialogue', speaker: '旁白', text: '商船停在沙滩边。你抱着瓷砖下船，脚印后面是渔船和一排陶罐。', nextSceneId: 'exchange' },
      { id: 'exchange', kind: 'dialogue', speaker: '旁白', text: '你穿过叫卖声和人影，走到摆着蓝白绣品的摊位前。', nextSceneId: 'stalls' },
      { id: 'stalls', kind: 'ending', text: '绣品的颜色让你想起怀里的瓷砖。摊主招手，让你走近一点看。' }
    ] },
    // 分镜 27–33
    { act: 5, title: '湘绣相遇', after: [], start: 'meet', scenes: [
      { id: 'meet', kind: 'dialogue', asset: 'embroidery-stall', speaker: '旁白', text: '摊中央摆着一幅蓝白玫瑰绣品。你把怀里的瓷砖放低，仔细观察花瓣的针脚。', nextSceneId: 'notice' },
      { id: 'notice', kind: 'dialogue', speaker: '商贩', text: '这是湖南湘绣，花瓣上的绣线要近看才分得清。后厅有绣娘做活，想去看看吗？', nextSceneId: 'invite' },
      { id: 'invite', kind: 'ending', text: '你点点头，跟着他走向布帘后的房间。' }
    ] },
    // 分镜 34–41与现代收尾
    { act: 6, title: '针法学习', after: [], start: 'cards', scenes: [
      { id: 'cards', kind: 'dialogue', asset: 'embroidery-room', speaker: '旁白', text: '四位绣娘围坐在窗边。你想起刚看过的四张卡，沿着针脚的走向辨认线条、长短、色阶和交叠。', nextSceneId: 'return' },
      { id: 'return', kind: 'dialogue', speaker: '旁白', text: '你把瓷砖和绣品并排放好。蓝白颜色相似，瓷面的光和绣线的层次却各有来处。', nextSceneId: 'today' },
      { id: 'today', kind: 'ending', asset: 'aomiao', text: '你回到展柜前，再看那条金色航线。你仍记得船帆的弧线，也记得绣线转折的地方。' }
    ] }
  ]
  content.chapters = chapters
  return content
}

export type MuseumVisit = { name: string, description: string, node: DraftNode, culture: CultureContent }

export function macauMuseumVisit(): MuseumVisit {
  const node: DraftNode = {
    id: 'macau-museum-entrance', title: '澳门博物馆 · 大炮台入口一带',
    description: '澳门博物馆前地112号。请在馆外允许停留和取景的位置拍摄到访照，避开他人正脸并遵守现场指示。完成线索打卡后可进入瓷砖任务。',
    latitude: 22.194192, longitude: 113.547292, radius: 100,
    clue: {
      story: '葡萄牙的釉面装饰砖常称 azulejo。在一些葡萄牙作品中，钴带来蓝色，蓝纹与白底形成对比。装饰砖也可以排列成一整面墙的画面。',
      question: '这种釉面装饰砖的葡语名称是什么？请用大写字母输入。',
      answer: 'AZULEJO'
    }
  }
  const script = scriptedContent([node.id])
  const culture: CultureContent = {
    tile: { title: '蓝白瓷砖配色', after: [node.id] },
    tileQuiz: {
      ...script.tileQuiz!, after: [node.id],
      prompt: '比较三幅原创瓷砖纹样。哪一幅同时画了三角形船帆和弧形海浪？',
      explanation: '图 B 同时有三角形船帆和弧形海浪。葡萄牙装饰砖常用于覆盖建筑表面；重复纹样能把多块砖连成整体。'
    },
    chapters: (script.chapters ?? []).filter(chapter => chapter.act <= 4)
  }
  return { name: '澳门博物馆', description: '在大炮台认识澳门的历史与中西文化交流，再从蓝白装饰砖的图案和配色进入海丝故事。', node, culture }
}

export function hunanMuseumVisit(): MuseumVisit {
  const node: DraftNode = {
    id: 'hunan-museum-entrance', title: '湖南湘绣博物馆 · 馆外入口一带',
    description: '长沙市芙蓉区车站北路39号。请在馆外允许停留和取景的位置拍摄到访照，避免拍到观众正脸。完成线索打卡后可进入湘绣任务。',
    latitude: 28.198609, longitude: 113.009827, radius: 80,
    clue: {
      story: '湘绣于2006年列入第一批国家级非物质文化遗产名录。湘绣常借助劈丝和掺针表现细节与深浅变化。仔细看，绣线也有走向和层次。',
      question: '湘绣在哪一年列入第一批国家级非物质文化遗产名录？请输入四位年份。',
      answer: '2006'
    }
  }
  const script = scriptedContent([node.id])
  const culture: CultureContent = {
    quiz: {
      ...script.quiz!, after: [node.id],
      explanation: '图 B 的上下两组针脚朝不同方向倾斜。观察走向能帮助我们理解线条怎样随物象转折。湘绣常以针线表现花瓣、毛发等细节。'
    },
    learning: { title: '湘绣观察卡', after: [node.id], cards: [
      { id: 'direction', title: '第一张 · 走向', hotspot: '沿着线条看', illustration: 'direction', body: '沿图中绣线走一遍，找出转向的位置。比较同向与转向的线条，看看花瓣的轮廓如何变化。' },
      { id: 'length', title: '第二张 · 长短与劈丝', hotspot: '比较长短和粗细', illustration: 'length', body: '长短是每一针的跨度；劈丝是把绣线分得更细。先辨认线段长短，再观察细线怎样表现较小的细节。' },
      { id: 'color', title: '第三张 · 色阶与掺针', hotspot: '找颜色过渡', illustration: 'color', body: '湘绣的掺针绣法可用来表现浓淡和色阶过渡。顺着示意图从浅色看到深色，找出过渡最明显的一段。' },
      { id: 'layers', title: '第四张 · 层次', hotspot: '观察交叠处', illustration: 'layers', body: '比较线条在交叠处的疏密和方向，试着指出哪一层看起来更靠前。这个图用于观察层次。' }
    ] },
    chapters: (script.chapters ?? []).filter(chapter => chapter.act >= 5)
  }
  return { name: '湖南湘绣博物馆', description: '从长沙的湘绣传统出发，观察针脚和色阶，完成辨认题及四张观察卡。', node, culture }
}

export function macauContent(nodeIds: string[]): CultureContent {
  return {
    tile: { title: '蓝白瓷砖配色', after: [] },
    tileQuiz: {
      title: '瓷砖纹样辨认', after: [], prompt: '观察码头插画里的瓷砖。哪张示意图同时画了船帆和波浪？',
      options: [
        { id: 'a', label: '选择图 A', illustration: 'tile-rose' },
        { id: 'b', label: '选择图 B', illustration: 'tile-sail' },
        { id: 'c', label: '选择图 C', illustration: 'tile' }
      ],
      answer: 'b', hint: '找找三角形的帆和弯曲的波浪线，它们出现在同一张图上。',
      explanation: '图 B 的三角形是船帆，弯曲的线是海浪。两种形状放在一起，就能联想到海上的帆船。'
    },
    chapters: [
      { act: 2, title: '海上风暴', after: nodeIds, checkinMode: 'any', start: 'wave', scenes: [
        { id: 'wave', kind: 'dialogue', speaker: '父亲', text: '浪把船身推得一斜。小心，先把脚边的瓷砖箱护好。', nextSceneId: 'hold' },
        { id: 'hold', kind: 'choice', text: '箱角从绳结里滑了出来。你伸手够到了两样东西。', choices: [
          { label: '拉紧固定箱子的绳子', nextSceneId: 'rope' },
          { label: '用布垫住箱角', nextSceneId: 'cloth' }
        ] },
        { id: 'rope', kind: 'dialogue', speaker: '旁白', text: '你重新打了个结，把箱子拉回木梁边。', nextSceneId: 'dawn' },
        { id: 'cloth', kind: 'dialogue', speaker: '旁白', text: '你把布塞进缝里，箱子终于不再撞击甲板。', nextSceneId: 'dawn' },
        { id: 'dawn', kind: 'ending', text: '浪声渐缓。父亲打开箱盖，一块蓝白瓷砖还完好地躺在里面。' }
      ] },
      { act: 3, title: '女儿与瓷砖', after: [], start: 'pattern', scenes: [
        { id: 'pattern', kind: 'dialogue', speaker: '女儿', text: '我先在纸上试着排一排纹样。帆、花瓣和几何边线，你刚才选的是哪一种？', nextSceneId: 'color' },
        { id: 'color', kind: 'dialogue', speaker: '旁白', text: '桌上排着试稿。她把深蓝留给边线，又给中间留出一块白。', nextSceneId: 'work' },
        { id: 'work', kind: 'ending', text: '你的配色已收进作品页。窗外传来脚步声，有人从码头送来靠岸的消息。' }
      ] },
      { act: 4, title: '澳门靠岸', after: [], start: 'shore', scenes: [
        { id: 'shore', kind: 'dialogue', speaker: '旁白', text: '船停在岸边。女儿拿出试稿，渔村里的人围过来，指着画上的小帆。', nextSceneId: 'exchange' },
        { id: 'exchange', kind: 'dialogue', speaker: '女儿', text: '你们认识这片海。下次我想照着你们见过的浪，再画一块瓷砖。', nextSceneId: 'today' },
        { id: 'today', kind: 'ending', asset: 'aomiao', text: '码头的声音慢慢退去。你回到今天的地图前，记住了瓷砖上的风帆和海浪。' }
      ] }
    ]
  }
}

export function hunanContent(): CultureContent {
  return {
    quiz: {
      title: '湘绣辨认', after: [], prompt: '比较两幅针脚示意图。哪一幅里，上下两组针脚朝不同方向倾斜？',
      options: [{ id: 'a', label: '选择图 A', illustration: 'threads' }, { id: 'b', label: '选择图 B', illustration: 'threads-direction' }],
      answer: 'b', hint: '先看上半部分的线，再看下半部分，比较它们分别朝哪边倾斜。',
      explanation: '图 B 的上下两组针脚朝不同方向倾斜。沿着线的走向看，可以发现它们是从哪里转向的。'
    },
    learning: {
      title: '针法学习卡', after: [],
      cards: [
        { id: 'direction', title: '第一张 · 走向', hotspot: '观察线条', illustration: 'direction', body: '沿着一段线条看过去，指出哪里改变了方向。正式针法名称和对照图待校订。' },
        { id: 'length', title: '第二张 · 长短', hotspot: '比较针脚', illustration: 'length', body: '找出图样中较长和较短的线段，比较它们留下的轮廓。馆藏局部示意待补。' },
        { id: 'color', title: '第三张 · 色阶', hotspot: '寻找深浅变化', illustration: 'color', body: '观察颜色从浅到深的过渡，试着指出你最先注意到的位置。正式例图待补。' },
        { id: 'layers', title: '第四张 · 层次', hotspot: '寻找交叠', illustration: 'layers', body: '看一看线条交会的地方，试着描述前后关系。对应针法与正式解说待校订。' }
      ]
    },
    chapters: [
      { act: 5, title: '湘绣相遇', after: [], start: 'meet', scenes: [
        { id: 'meet', kind: 'dialogue', speaker: '绣者', text: '你刚才找到了朝不同方向倾斜的针脚。现在再看看窗边的图样，你最先注意到哪里？', nextSceneId: 'notice' },
        { id: 'notice', kind: 'choice', text: '绣者把图样移到窗边。你先注意到什么？', choices: [
          { label: '线条的走向', nextSceneId: 'direction' },
          { label: '颜色的变化', nextSceneId: 'color' }
        ] },
        { id: 'direction', kind: 'dialogue', speaker: '绣者', text: '沿着你指的方向，我们再看一段。', nextSceneId: 'invite' },
        { id: 'color', kind: 'dialogue', speaker: '绣者', text: '靠近一点，看看浅色在哪里接上深色。', nextSceneId: 'invite' },
        { id: 'invite', kind: 'ending', text: '她把四张观察卡放到你面前，等你一张一张翻开。' }
      ] },
      { act: 6, title: '针法学习', after: [], start: 'cards', scenes: [
        { id: 'cards', kind: 'dialogue', speaker: '绣者', text: '走向、长短、色阶和层次，你都观察过了。下回见到绣品，也可以从这些地方看起。', nextSceneId: 'return' },
        { id: 'return', kind: 'dialogue', speaker: '旁白', text: '最后一张观察卡翻过去，窗边的光落在那缕红线上。', nextSceneId: 'today' },
        { id: 'today', kind: 'ending', asset: 'aomiao', text: '你回到今天的地图前。四张卡的学习记录已经保存，下次还可以回来翻看。' }
      ] }
    ]
  }
}
