<template>
  <view class="screen">
    <AppPageHeader title="路线详情" :show-back="true" />
    <view class="content">
      <DemoNotice />

      <template v-if="route != null">
        <view class="card">
          <image class="cover" src="/packages/routes/static/silk-cover.jpg" mode="aspectFill" />
          <text class="tag">{{ route.region }} · 海丝瓷绣</text>
          <text class="title">{{ route.name }}</text>
          <text class="body">{{ routeSections[0] }}</text>
          <text class="muted">探索进度 {{ route.done }} / {{ route.total }}</text>
          <ProgressBar :value="route.done / route.total * 100" color="#52704a" :height="12" :show-label="false" />
        </view>
        <view class="card">
          <text class="heading">探索任务</text>
          <view v-for="node in nodes" :key="node.id" class="row spread divider menu-row" @click="openPoint(node.id)">
            <text class="body">{{ node.title }}</text><text class="muted">{{ node.checked ? '查看我的打卡' : node.locked ? '待解锁' : '去打卡' }} ›</text>
          </view>
        </view>
        <view v-if="progress?.snapshot.exhibit != null" class="card">
          <text class="heading">展品彩蛋</text>
          <button class="secondary" @click="openExhibit">{{ progress?.exhibitCompleted === true ? '回看展品观察' : '开始展品观察' }}</button>
        </view>
        <view v-if="activities.length > 0" class="card">
          <text class="heading">文化任务</text>
          <view v-for="item in activities" :key="item.id" class="row spread divider menu-row" @click="openActivity(item.id)">
            <text class="body">{{ item.title }}</text>
            <text class="muted">{{ progress?.activities?.includes(item.id) === true ? '已完成' : '查看任务' }} ›</text>
          </view>
        </view>
        <button v-if="runId == null" class="secondary" @click="openStory">查看剧情章节</button>
        <button v-if="runId == null" class="secondary" @click="showOnMap">在地图查看路线</button>
        <view v-if="routeSections.length > 1" class="card">
          <text class="heading">实地参观</text>
          <text v-for="section in routeSections.slice(1)" :key="section" class="body">{{ section }}</text>
        </view>
      </template>
      <view v-else-if="runId != null" class="card">
        <text class="body">{{ loading ? '正在读取探索进度…' : '暂时无法读取这次探索。' }}</text>
        <button v-if="!loading" class="secondary" @click="load">重试</button>
      </view>
      <view v-else class="card"><text class="body">找不到这条路线。</text><button class="secondary" @click="openPage('/packages/routes/routes/routes')">查看路线列表</button></view>
    </view>
  </view>
</template>

<script setup lang="uts">
import AppPageHeader from '@/components/AppPageHeader.uvue'
import DemoNotice from '@/components/DemoNotice.uvue'

import { computed, ref } from 'vue'
import ProgressBar from '@/components/ProgressBar.uvue'
import { activeRun, findRoute, listNodes, loadRun, published, refreshCatalog, startRoute, summarizeRoute } from '@/features/exploration/catalog.uts'
import type { RunProgress } from '@/features/exploration/catalog.uts'
import { api, session, showError } from '@/features/api.uts'
import { dispatchMapEvent } from '@/features/exploration/map-store.uts'
import { decodePageId, openCheckin, openCultureActivity, openPage, returnToMap } from '@/features/navigation.uts'
const id = ref<string | null>(null)
const runId = ref<string | null>(null)
const progress = ref<RunProgress | null>(null)
const busy = ref(false)
const loading = ref(false)
onLoad(query => {
  id.value = decodePageId(query['routeId'] ?? null)
  runId.value = decodePageId(query['runId'] ?? null)
})
const content = computed(() => progress.value?.snapshot ?? (runId.value == null ? published.value.find(item => item.id === id.value) ?? null : null))
const route = computed(() => {
  if (content.value != null) return summarizeRoute(content.value!, progress.value)
  return runId.value == null ? findRoute(id.value) : null
})
const routeSections = computed(() => (route.value?.description ?? '').split('\n\n'))
const activities = computed(() => content.value?.activities ?? [])
const nodes = computed(() => {
  const snapshot = content.value
  if (snapshot == null) return listNodes(id.value).map(node => ({ id: node.id, title: node.title, checked: node.checked, locked: false }))
  const completed = progress.value?.completed ?? []
  return snapshot.nodes.map(node => ({
    id: snapshot.id + ':' + node.id, title: node.title, checked: completed.includes(node.id),
    locked: node.afterClue != null && !completed.includes(node.afterClue!)
  }))
})
onShow(() => { load() })
async function load(): Promise<void> {
  if (loading.value) return
  if (runId.value != null) {
    if (id.value == null) return
    loading.value = true
    try { progress.value = await loadRun(id.value!, runId.value!) }
    catch (_) { progress.value = null }
    finally { loading.value = false }
    return
  }
  await refreshCatalog()
  if (id.value == null || session.value == null) { progress.value = null; return }
  const uid = session.value!.uid
  try {
    const value = await api<RunProgress | null>('routeProgress', { routeId: id.value! })
    if (session.value?.uid === uid) progress.value = value
  } catch (_) { if (session.value?.uid !== uid) progress.value = null }
}
async function selectViewedRun(): Promise<boolean> {
  if (busy.value) return false
  const value = progress.value
  if (value == null || activeRun.value?.runId === value.runId) return true
  busy.value = true
  try { await startRoute(value.routeId); return true }
  catch (_) { showError(); return false }
  finally { busy.value = false }
}
async function openPoint(nodeId: string): Promise<void> {
  if (runId.value != null) {
    openCheckin(nodeId, runId.value)
    return
  }
  if (await selectViewedRun()) openCheckin(nodeId)
}
function openExhibit(): void {
  const run = progress.value
  const exhibit = run?.snapshot.exhibit
  if (run != null && exhibit != null) openCheckin(run.routeId + ':' + exhibit.id, run.runId)
}
function openActivity(activityId: string): void {
  if (id.value == null) return
  openCultureActivity(id.value!, activityId, runId.value)
}
function openStory(): void {
  if (id.value != null) openPage('/packages/story/story/story?routeId=' + encodeURIComponent(id.value!))
}
async function showOnMap(): Promise<void> {
  const item = route.value
  if (item == null || !await selectViewedRun()) return
  dispatchMapEvent({ type: 'select-route', routeId: item.id, viewport: item.viewport })
  returnToMap()
}
</script>

<style scoped>
@import '@/styles/page.css';

</style>
