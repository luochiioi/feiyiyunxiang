<template>
  <view class="screen">
    <AppPageHeader title="旅伴" :show-back="true" />
    <view class="content">
      <view class="card green">
        <text class="title">两地同行</text>
        <text class="body">澳门与湖南的探索者先添加好友，再组队完成各自的本地任务，共同解锁成果。</text>
      </view>

      <view v-if="session == null" class="card"><text class="body">微信登录后查看好友申请和旅伴记录。</text><button class="primary" :disabled="busy" @click="signIn">微信登录</button></view>
      <template v-else>
      <view class="card">
        <text class="heading">我的好友</text>
        <view class="row">
          <text class="muted">我的邀请码 {{ myCode.length > 0 ? myCode : '获取中…' }}</text>
          <button v-if="myCode.length > 0" class="secondary inline" @click="copyCode">复制</button>
        </view>
        <text v-if="actionMessage.length > 0" class="body">{{ actionMessage }}</text>
        <text v-if="loadError.length > 0" class="muted">{{ loadError }}</text>
        <button v-if="loadError.length > 0" class="secondary" :disabled="loading" @click="loadPartner">重试读取旅伴</button>
        <view class="row">
          <input class="code-input" v-model="code" maxlength="8" placeholder="输入对方邀请码" />
          <button class="primary inline" :disabled="busy" @click="addFriend">添加</button>
        </view>
        <view v-for="item in incoming" :key="item.id" class="row spread divider">
          <text class="body">{{ item.nickname }} 请求加为好友</text>
          <view class="row">
            <button class="secondary inline" :disabled="busy" @click="answer(item.id, true)">接受</button>
            <button class="secondary inline" :disabled="busy" @click="answer(item.id, false)">拒绝</button>
          </view>
        </view>
        <view v-for="item in friends" :key="item.code" class="row spread divider">
          <text class="body">{{ item.nickname }}</text><text class="muted">邀请码 {{ item.code }}</text>
        </view>
        <text v-if="friends.length === 0 && incoming.length === 0" class="muted">还没有好友。用邀请码互相添加后，才能发起合作或 PK。</text>
      </view>

      <view class="card">
        <text class="heading">合作</text>
        <text class="body">与好友组队，各自完成所在地的节点与文化任务，成果只对外展示席位标签。</text>
        <button class="secondary" @click="openPage('/packages/partner/coop/coop')">查看合作</button>
      </view>

      <view class="card">
        <text class="heading">好友 PK</text>
        <text class="body">完成路线全部打卡后，率先提交结算的一方获胜。胜者从路线彩蛋中挑一项交给败者。</text>
        <text v-if="!pkEnabled" class="muted">有未处理的失败任务，完成或拒绝后才能参加下一场。</text>
        <button class="secondary" :disabled="!pkEnabled" @click="openPage('/packages/partner/pk/pk')">进入 PK</button>
      </view>

      <view class="card">
        <text class="heading">AI 非遗猜图</text>
        <text class="body">出题给好友，或打开收件箱回答好友发来的题。</text>
        <button class="secondary" @click="openPage('/packages/story/guess/guess')">进入猜图</button>
      </view>

      <view class="card">
        <text class="heading">漂流瓶</text>
        <text class="body">找同地区或跨地区的旅伴，一起完成馆路探索。</text>
        <button class="primary" @click="openPage('/packages/partner/bottle/bottle')">找旅伴</button>
        <button v-if="showBottleTrial" class="secondary" @click="openPage('/packages/partner/bottle-trial/bottle-trial')">开始单人试用</button>
      </view>

      <view v-if="assignment != null" class="card">
        <text class="heading">失败任务</text>
        <text class="body">{{ assignmentTitle }}</text>
        <text class="muted">实地打卡或答对一道海丝非遗题都能解除下一场限制。</text>
        <text class="muted">{{ rejectHint }}</text>
        <button class="secondary" @click="openPage('/packages/partner/assignment/assignment?assignmentId=' + assignmentId)">查看任务</button>
      </view>
      </template>
    </view>
  </view>
</template>

<script setup lang="uts">
import AppPageHeader from '@/components/AppPageHeader.uvue'

import { computed, ref, watch } from 'vue'
import { openPage } from '@/features/navigation.uts'
import { showError, requestId, secured, session, login } from '@/features/api.uts'
import { refreshNotificationsSummary } from '@/features/notifications.uts'
import { loadFriends, loadAssignment, sendFriendRequest, answerFriendRequest, partnerView } from '@/features/partner/partner.uts'

type FriendCard = { code: string, nickname: string }
type IncomingRequest = { id: string, code: string, nickname: string }
type AssignmentCard = { id: string, status: string, rejectAvailableAt: number, nodeTitle: string, title?: string }

const showBottleTrial = process.env.NODE_ENV === 'development'
const friends = ref<FriendCard[]>([])
const incoming = ref<IncomingRequest[]>([])
const myCode = ref('')
const code = ref('')
const busy = ref(false)
const loadError = ref(''), actionMessage = ref(''), loading = ref(false)
const pendingCode = ref(''), pendingRequest = ref('')
let sequence = 0, actionSequence = 0
const assignment = ref<AssignmentCard | null>(null)

const view = computed(() => partnerView({ assignment: assignment.value, now: Date.now() }))
const pkEnabled = computed(() => view.value.pkEnabled)
const assignmentId = computed(() => assignment.value?.id ?? '')
const assignmentTitle = computed(() => assignment.value?.title ?? assignment.value?.nodeTitle ?? '失败任务')
const rejectHint = computed(() => view.value.rejectEnabled ? '已满 72 小时，可以主动拒绝。' : '分配满 72 小时后可主动拒绝，此前只能完成。')

function resetPartner(): void {
  sequence++; actionSequence++; friends.value = []; incoming.value = []; myCode.value = ''; assignment.value = null
  code.value = ''; pendingCode.value = ''; pendingRequest.value = ''; loadError.value = ''; actionMessage.value = ''; busy.value = false; loading.value = false
}
watch(() => session.value?.uid, () => { resetPartner(); if (session.value != null) loadPartner() }, { flush: 'sync' })
onShow(() => { loadPartner() })
async function loadPartner(): Promise<void> {
  const uid = session.value?.uid
  if (uid == null) { resetPartner(); return }
  const request = ++sequence
  loading.value = true; loadError.value = ''
  try {
    const [profile, rows, task] = await Promise.all([secured<UTSJSONObject>('ensureProfile', {}), loadFriends(), loadAssignment()])
    if (request !== sequence || uid !== session.value?.uid) return
    myCode.value = profile['code'] as string
    friends.value = rows.filter(row => row['kind'] !== 'incoming').map(row => ({ code: row['code'] as string, nickname: row['nickname'] as string }))
    incoming.value = rows.filter(row => row['kind'] === 'incoming').map(row => ({ id: row['id'] as string, code: row['code'] as string, nickname: row['nickname'] as string }))
    assignment.value = task as AssignmentCard | null
  } catch (_) { if (request === sequence && uid === session.value?.uid) loadError.value = '旅伴信息暂时无法读取，请重试。' }
  finally { if (request === sequence && uid === session.value?.uid) loading.value = false }
}
async function signIn(): Promise<void> {
  if (busy.value) return
  busy.value = true
  try { await login(); await loadPartner() } catch (_) { showError() } finally { busy.value = false }
}

function copyCode(): void {
  if (myCode.value.length > 0) uni.setClipboardData({ data: myCode.value, fail: () => showError() })
}

async function addFriend(): Promise<void> {
  const uid = session.value?.uid, normalized = code.value.trim().toUpperCase()
  if (busy.value || uid == null || normalized.length === 0) return
  if (pendingCode.value !== normalized || pendingRequest.value.length === 0) { pendingCode.value = normalized; pendingRequest.value = requestId() }
  const operation = ++actionSequence, id = pendingRequest.value
  busy.value = true; actionMessage.value = ''
  try {
    await sendFriendRequest(normalized, id)
    if (operation !== actionSequence || uid !== session.value?.uid) return
    code.value = ''; pendingCode.value = ''; pendingRequest.value = ''
    actionMessage.value = '好友请求已发送。'
    await loadPartner(); await refreshNotificationsSummary()
  } catch (_) { if (operation === actionSequence && uid === session.value?.uid) showError() }
  finally { if (operation === actionSequence && uid === session.value?.uid) busy.value = false }
}

async function answer(requestId: string, accept: boolean): Promise<void> {
  const uid = session.value?.uid
  if (busy.value || uid == null) return
  const operation = ++actionSequence
  busy.value = true; actionMessage.value = ''
  try {
    await answerFriendRequest(requestId, accept)
    if (operation !== actionSequence || uid !== session.value?.uid) return
    const accepted = incoming.value.find(item => item.id === requestId)
    incoming.value = incoming.value.filter(item => item.id !== requestId)
    if (accept && accepted != null && !friends.value.some(item => item.code === accepted.code)) friends.value = friends.value.concat([{ code: accepted.code, nickname: accepted.nickname }])
    actionMessage.value = accept ? '已接受好友申请。' : '已拒绝好友申请。'
    await loadPartner(); await refreshNotificationsSummary()
  } catch (_) { if (operation === actionSequence && uid === session.value?.uid) showError() }
  finally { if (operation === actionSequence && uid === session.value?.uid) busy.value = false }
}
</script>

<style scoped>
@import '@/styles/page.css';
.code-input { flex: 1; min-width: 0; height: 40px; padding: 0 12px; border-radius: 13px; background: #f4ead8; font-size: 14px; }
.inline { width: auto; padding: 6px 14px; }
</style>
