    { id: 'cloth', kind: 'dialogue', speaker: '旁白', text: '你把布塞进缝里，箱子终于不再撞击甲板。', nextSceneId: 'dawn' },
    { id: 'dawn', kind: 'ending', text: '浪声渐缓。父亲打开箱盖，一块蓝白瓷砖还完好地躺在里面。' }
  ]
}

export function localStoryPath(key: string, chapter: Chapter): string[] {
  const raw = uni.getStorageSync(key) as string
  if (raw != null && raw.length > 0) {
    try {
      const path = JSON.parse<string[]>(raw)
      if (path != null && path.length > 0 && path[0] === chapter.start && path.every(id => chapter.scenes.some(scene => scene.id === id))) return path
    } catch (_) { uni.removeStorageSync(key) }
  }
  return [chapter.start]
}

export function savedOpeningPath(): string[] { return localStoryPath(openingStorageKey, opening) }
