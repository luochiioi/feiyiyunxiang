<template>
  <view class="card">
    <text class="heading">分享给好友</text>
    <text v-if="loading" class="muted" role="status">正在读取好友…</text>
    <text v-else-if="!loadFailed && friends.length === 0" class="body">还没有可以分享的好友。</text>
    <view v-else class="choices">
      <button v-for="friend in friends" :key="friend.code" class="choice" :class="{ chosen: selected === friend.code }"
        :aria-pressed="selected === friend.code" :disabled="sending" @click="selected = friend.code">
        <ProfileAvatar :code="friend.code" :version="friend.avatarVersion ?? ''" :legacy="friend.avatar ?? ''" :diameter="32" />
        <text class="body">{{ friend.nickname }}</text>
      </button>
    </view>
    <text v-if="message" class="body" role="status">{{ message }}</text>
    <view class="row actions">
      <button class="secondary" :disabled="sending" @click="emit('close')">取消</button>
      <button v-if="loadFailed" class="primary" @click="load">重试读取好友</button>
      <button v-else-if="friends.length > 0" class="primary" :disabled="sending || !selected" @click="send">{{ sending ? '正在发送…' : '发送给好友' }}</button>
    </view>
  </view>
</template>

<script setup lang="uts">
import { onBeforeUnmount, onMounted, ref, watch } from 'vue'
import ProfileAvatar from '@/components/ProfileAvatar.uvue'
import { api, secured, session } from '@/features/api.uts'
import { communityError } from '@/features/community/community.uts'

type Friend = { code: string, nickname: string, avatarVersion?: string, avatar?: string, kind?: string }
const props = defineProps<{ target: string }>()
const emit = defineEmits<{ (event: 'close'): void }>()
const friends = ref<Friend[]>([]), selected = ref(''), owner = ref('')
const loading = ref(false), loadFailed = ref(false), sending = ref(false), message = ref('')
let generation = 0

onMounted(load)
onBeforeUnmount(() => { generation++ })
watch(() => session.value?.uid, (uid, previous) => {
  if (previous == null && loading.value) return
  if (uid !== previous) emit('close')
}, { flush: 'sync' })

async function load(): Promise<void> {
  if (loading.value) return
  const ticket = ++generation
  const uid = session.value?.uid
  loading.value = true; loadFailed.value = false; message.value = ''
  try {
    const rows = await secured<Friend[]>('friends')
    const current = session.value?.uid
    if (ticket !== generation || current == null || (uid != null && current !== uid)) return
    owner.value = current
    friends.value = rows.filter(row => row.kind !== 'incoming' && row.code.length > 0)
  } catch (_) {
    if (ticket === generation) { loadFailed.value = true; message.value = '好友列表暂时无法读取。' }
  } finally { if (ticket === generation) loading.value = false }
}

async function send(): Promise<void> {
  if (sending.value || !selected.value || owner.value !== session.value?.uid) return
  const postId = props.target
  if (!postId) { message.value = '未能识别这条帖子，请返回后重新打开。'; return }
  const ticket = generation
  sending.value = true; message.value = ''
  try {
    const result = await api<{ alreadyShared: boolean }>('communityShareToFriend', { postId, code: selected.value })
    if (ticket !== generation) return
    uni.showToast({ title: result.alreadyShared ? '已分享过这个版本' : '已发送给好友', icon: 'none' })
    emit('close')
  } catch (error) {
    if (ticket !== generation) return
    const code = (error as Error | null)?.message
    if (code === 'NOT_FRIENDS') message.value = '对方当前无法接收好友分享。'
    else if (code === 'SHARE_POST_UNAVAILABLE') message.value = '这条帖子当前未公开，无法分享。'
    else if (code === 'NOT_FOUND') message.value = '分享服务未能确认发送，请刷新帖子后重试。'
    else message.value = communityError(error)
  } finally { if (ticket === generation) sending.value = false }
}
</script>

<style scoped>
@import '@/styles/page.css';
.choices { display: flex; flex-direction: column; gap: 6px; max-height: 270px; overflow-y: auto; }
.choice { width: 100%; margin: 0; padding: 7px 10px; display: flex; flex-direction: row; align-items: center; gap: 10px; min-height: 46px; text-align: left; background: #fbf7ef; border-radius: 10px; }
.choice::after { border: 0; }
.chosen { background: #e6eedc; box-shadow: inset 0 0 0 1px #56724f; }
.actions > button { flex: 1; width: auto; }
</style>
