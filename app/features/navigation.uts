export function openPage(path: string): void {
  uni.navigateTo({
    url: path,
    fail: () => uni.showToast({ title: '页面暂时无法打开，请重试', icon: 'none' })
  })
}

export function decodePageId(value: string | null): string | null {
  if (value == null) return null
  try { return decodeURIComponent(value) } catch (_) { return null }
}

function runQuery(runId: string | null): string {
  return runId == null ? '' : '&runId=' + encodeURIComponent(runId)
}

export function openCheckin(nodeId: string, runId: string | null = null): void {
  openPage('/packages/routes/checkin/checkin?nodeId=' + encodeURIComponent(nodeId) + runQuery(runId))
}

export function openRouteDetail(routeId: string, runId: string | null = null): void {
  openPage('/packages/routes/route-detail/route-detail?routeId=' + encodeURIComponent(routeId) + runQuery(runId))
}

export function openCultureActivity(routeId: string, activityId: string, runId: string | null = null): void {
  openPage('/packages/story/activity/activity?routeId=' + encodeURIComponent(routeId) + '&activityId=' + encodeURIComponent(activityId) + runQuery(runId))
}

export function returnToMap(): void {
  const pages = getCurrentPages()
  const home = pages.findIndex(page => page.route === 'pages/index/index')
  if (home >= 0) {
    const delta = pages.length - 1 - home
    if (delta > 0) uni.navigateBack({ delta })
    return
  }
  uni.reLaunch({ url: '/pages/index/index' })
}
