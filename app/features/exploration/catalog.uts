import { shallowRef } from 'vue'
import { api, secured, session, requestId, login } from '../api.uts'
import { demoEnabled } from '../demo-mode.uts'
import { demoNodes, demoRoutes } from './demo-fixtures.uts'
import { visibleMapNodes } from './map-markers.uts'
import type { ExhibitClue, RouteNode, RouteSummary, MapViewport } from './types.uts'
export type PublishedNode = { id: string, title: string, description: string, latitude: number, longitude: number, radius: number, clue?: ExhibitClue, afterClue?: string, alternate?: string, reward?: string }
export type ActivitySummary = { id: string, title: string, after?: string[] }
export type ChapterGuide = { act: number, title: string, activityId?: string | null, gateText: string }
export type PublishedRoute = { id: string, version: string, name: string, region: string, description: string, testOnly: boolean, viewport: MapViewport, nodes: PublishedNode[], exhibit?: PublishedNode, activities?: ActivitySummary[], chapters?: ChapterGuide[], cultureUpgrade?: boolean, cultureSourceRoutes?: string[] }
export type RunProgress = { runId: string, routeId: string, version: string, purpose?: string, done: number, total: number, completed: string[], snapshot: PublishedRoute, exhibitCompleted?: boolean, activities?: string[] }
export const published = shallowRef<PublishedRoute[]>([])
export const activeRun = shallowRef<RunProgress | null>(null)
export const catalogError = shallowRef(false)
export async function refreshCatalog(): Promise<void> {
  if (demoEnabled) return
  try {
    const routes = await api<PublishedRoute[]>('catalog')
    const official = routes.filter(route => !route.testOnly)
    published.value = process.env.NODE_ENV === 'development' && official.length === 0 ? routes : official
    catalogError.value = false
  } catch (_) { catalogError.value = true }
  if (session.value != null) {
    const uid = session.value!.uid
    const key = 'fy-run-' + uid
    const runId = uni.getStorageSync(key) as string
    if (runId != null && runId.length > 0) {
      try {
        const progress = await secured<RunProgress>('progress', { runId })
        const combined = published.value.find(route => route.cultureSourceRoutes?.includes(progress.routeId) === true)
        const partnerRun = (progress.purpose ?? 'solo') !== 'solo'
        const selected = partnerRun ? null : (combined == null ? progress : await secured<RunProgress | null>('routeProgress', { routeId: combined.id }))
        if (session.value?.uid === uid && uni.getStorageSync(key) === runId) {
          activeRun.value = selected
          if (partnerRun || combined != null) {
            if (selected == null) uni.removeStorageSync(key)
            else uni.setStorageSync(key, selected.runId)
          }
        }
      } catch (_) { if (session.value == null) activeRun.value = null }
    }
  } else { activeRun.value = null }
}
export async function loadRun(routeId: string, runId: string): Promise<RunProgress> {
  const progress = await secured<RunProgress>('progress', { runId })
  if (progress.routeId !== routeId) throw new Error('NOT_FOUND')
  return progress
}

export async function startRoute(routeId: string): Promise<RunProgress> {
  if (session.value == null || session.value!.expiresAt <= Date.now()) await login()
  const uid = session.value!.uid
  const runKey = 'fy-run-' + uid
  const pendingKey = 'fy-start-' + uid + '-' + routeId
  const selected = activeRun.value
  if (selected != null && (selected.purpose ?? 'solo') === 'solo' && selected.routeId === routeId && uni.getStorageSync(runKey) === selected.runId) return selected
  let progress = await secured<RunProgress | null>('routeProgress', { routeId })
  if (progress == null) {
    let rid = uni.getStorageSync(pendingKey) as string
    if (rid == null || rid.length === 0) { rid = requestId(); uni.setStorageSync(pendingKey, rid) }
    const run = await secured<{ id: string }>('start', { routeId, requestId: rid })
    progress = await secured<RunProgress>('progress', { runId: run.id })
  }
  if (session.value?.uid !== uid) throw new Error('AUTH_REQUIRED')
  uni.setStorageSync(runKey, progress.runId)
  activeRun.value = progress
  uni.removeStorageSync(pendingKey)
  return progress
}

export function summarizeRoute(r: PublishedRoute, run: RunProgress | null): RouteSummary {
  const completed = run?.completed ?? []
  const next = r.nodes.find(n => !completed.includes(n.id) && (n.afterClue == null || completed.includes(n.afterClue!)))
  const activities = r.activities ?? []
  const name = published.value.find(route => route.id === r.id)?.name ?? r.name
  return { id: r.id, name: (r.testOnly ? '开发测试 · ' : '') + name, region: r.region, description: r.description,
    total: r.nodes.length + activities.length, done: completed.length + (run?.activities?.length ?? 0),
    nextNodeId: next == null ? null : r.id + ':' + next.id, viewport: r.viewport }
}
export function listRoutes(): RouteSummary[] {
  if (demoEnabled) return demoRoutes
  const routes = published.value.slice()
  const run = activeRun.value
  if (run != null) {
    const i = routes.findIndex(r => r.id === run.routeId)
    if (i >= 0) routes[i] = run.snapshot
    else if (!published.value.some(route => route.cultureSourceRoutes?.includes(run.routeId) === true)) routes.push(run.snapshot)
  }
  return routes.map(r => summarizeRoute(r, run?.routeId === r.id ? run : null))
}
export function findRoute(id: string | null): RouteSummary | null {
  return listRoutes().find(route => route.id === id) ?? null
}
export function listNodes(routeId: string | null): RouteNode[] {
  if (demoEnabled) return visibleMapNodes(demoNodes, routeId)
  const result: RouteNode[] = []
  listRoutes().filter(r => routeId == null || r.id === routeId).forEach((r, i) => {
    const run = activeRun.value
    const route = run?.routeId === r.id ? run!.snapshot : published.value.find(v => v.id === r.id)
    route?.nodes.forEach((n, j) => { result.push({ ...n, id: r.id + ':' + n.id, routeId: r.id, markerId: i * 100 + j + 1, checked: run?.routeId === r.id && run!.completed.includes(n.id) }) })
  })
  return result
}
export function findNode(id: string | null): RouteNode | null {
  return listNodes(null).find(node => node.id === id) ?? null
}
