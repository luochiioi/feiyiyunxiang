<template>
  <view class="screen">
    <AppPageHeader title="合作剧情" :show-back="true" />
    <view class="content">
      <template v-if="story != null">
        <view class="card green">
          <text class="title">{{ story.full ? "海丝瓷绣 · 一念归期" : story.routeName }}</text>
          <text v-if="story.full" class="body">已解锁湘澳六幕和双城终章。两位旅伴可分别续读。</text>
          <text v-else-if="story.pending" class="body">湘澳旅伴完成各自的点位和文化任务并结算后，解锁六幕与双城终章。</text>
        </view>
        <view class="card">
          <button class="secondary" @click="read(1)">第 1 幕 · 触碰海丝地图</button>
          <view v-for="chapter in story.chapters" :key="chapter.act" class="chapter">
            <button v-if="chapter.unlocked" class="secondary" @click="read(chapter.act)">{{ label(chapter) }}{{ chapter.started ? " · 续读" : "" }}</button>
            <template v-else>
              <text class="body">{{ label(chapter) }} · 未解锁</text>
              <text class="muted">{{ chapter.gateText }}</text>
            </template>
          </view>
        </view>
      </template>
      <view v-else class="card">
        <text class="body">{{ loading ? "正在读取合作剧情…" : "暂时无法读取合作剧情。" }}</text>
        <button v-if="!loading" class="secondary" @click="load">重试</button>
      </view>
    </view>
  </view>
</template>

<script setup lang="uts">
import { ref } from 'vue'
import AppPageHeader from '@/components/AppPageHeader.uvue'
import { secured, session } from '@/features/api.uts'
import { decodePageId, openPage } from '@/features/navigation.uts'

type CoopChapter = { act: number, title: string, gateText: string, unlocked: boolean, started: boolean }
type CoopStory = { full: boolean, pending: boolean, routeName: string, chapters: CoopChapter[] }
const runId = ref<string | null>(null)
const story = ref<CoopStory | null>(null)
const loading = ref(false)

onLoad(query => { runId.value = decodePageId(query['runId'] ?? null) })
onShow(() => { load() })

async function load(): Promise<void> {
  if (loading.value || runId.value == null) return
  loading.value = true
  story.value = null
  const uid = session.value?.uid
  try {
    const value = await secured<CoopStory>('coopStory', { runId: runId.value! })
    if (uid == null || session.value?.uid === uid) story.value = value
  } catch (_) { story.value = null }
  finally { loading.value = false }
}

function label(chapter: CoopChapter): string {
  return chapter.act === 7 ? chapter.title : '第 ' + chapter.act + ' 幕 · ' + chapter.title
}

function read(act: number): void {
  openPage('/packages/story/reader/reader?act=' + act + (act === 1 ? '' : '&runId=' + encodeURIComponent(runId.value ?? '')))
}
</script>

<style scoped>
@import '@/styles/page.css';
.chapter { display: flex; flex-direction: column; gap: 6px; }
</style>
