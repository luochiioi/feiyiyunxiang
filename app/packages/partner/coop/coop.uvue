<template>
  <view class="screen">
    <AppPageHeader title="合作详情" :show-back="true" />
    <view class="content">
      <view v-if="loading" class="card"><text class="body">正在读取合作…</text></view>
      <view v-else-if="loadFailed" class="card">
        <text class="body">暂时无法读取合作信息。</text>
        <button class="secondary" @click="load">重试</button>
      </view>
      <template v-else-if="team != null">
        <view class="card green">
          <text class="title">两地合作</text>
          <text class="body">各自完成所在地的节点与文化任务，双方完成后共同解锁成果。</text>
          <text class="muted">状态 {{ statusText }}</text>
        </view>
        <view class="card">
          <text class="heading">旅伴</text>
          <text class="body">{{ partnerText }}</text>
          <text class="muted">对外成果只展示席位标签，不展示对方昵称。</text>
        </view>
        <view class="card">
          <text class="heading">文化任务</text>
          <text class="body">我 · {{ taskText(team.myTasks) }}</text>
          <text class="body">旅伴 · {{ taskText(team.partnerTasks) }}</text>
        </view>
        <view v-if="canAnswer" class="card">
          <text class="heading">选择我的文化任务</text>
          <text class="muted">不选则默认完成本席位全部文化任务。点位打卡始终按席位全部完成。</text>
          <button v-for="task in team.myTaskOptions" :key="task.id" class="secondary" :class="{ selected: isTaskChosen(task.id) }" :disabled="busy" @click="toggleTask(task.id)">{{ task.title }}</button>
        </view>
        <view v-if="status === 'active'" class="card">
          <text class="heading">双方进度</text>
          <text class="body">我的{{ team.mySeat === 'macau' ? '澳门' : '湖南' }}席位 {{ team.myProgress?.done ?? 0 }} / {{ team.myProgress?.total ?? 0 }}</text>
          <text class="body">旅伴的{{ team.mySeat === 'macau' ? '湖南' : '澳门' }}席位 {{ team.partnerProgress?.done ?? 0 }} / {{ team.partnerProgress?.total ?? 0 }}</text>
        </view>
        <button v-if="status === 'active' && team.myRunId != null" class="primary" :disabled="busy" @click="explore">开始探索</button>
        <button v-if="canSettle" class="primary" :disabled="busy" @click="settle">结算成果</button>
        <button v-if="canAnswer" class="primary" :disabled="busy" @click="answer(true)">接受邀请</button>
        <button v-if="canAnswer" class="secondary" :disabled="busy" @click="answer(false)">拒绝邀请</button>
        <button v-if="status === 'active' || status === 'invited'" class="secondary" :disabled="busy" @click="load">刷新合作</button>
        <button v-else class="secondary" :disabled="busy" @click="load">发起新合作</button>
      </template>
      <PartnerInviteForm v-else :coop="true" :friends="friends" :busy="busy" :enabled="true" @invite="invite" />
    </view>
  </view>
</template>

<script setup lang="uts">
import AppPageHeader from '@/components/AppPageHeader.uvue'
import PartnerInviteForm from '../components/PartnerInviteForm.uvue'
import { computed, ref } from 'vue'
import { openRouteDetail } from '@/features/navigation.uts'
import { showError, secured } from '@/features/api.uts'
import { answerCoop, loadCoop, loadInviteFriends, loadMyCoop, startCoop } from '@/features/partner/partner.uts'
import type { CoopTask, CoopView, PartnerFriend } from '@/features/partner/partner.uts'

const team = ref<CoopView | null>(null)
const friends = ref<PartnerFriend[]>([])
const busy = ref(false)
const loading = ref(false)
const loadFailed = ref(false)
const chosen = ref<string[]>([])
const status = computed(() => team.value?.status ?? '')
const statusText = computed(() => status.value === 'active' ? '进行中' : status.value === 'done' ? '已完成' : status.value === 'invited' ? '待接受' : '已结束')
const canSettle = computed(() => status.value === 'active')
const canAnswer = computed(() => status.value === 'invited' && team.value?.invitedByMe === false)
const partnerText = computed(() => team.value?.partner?.nickname ?? '旅伴')

function taskText(tasks: CoopTask[]): string {
  return tasks.length === 0 ? '全部文化任务' : tasks.map(task => task.title).join('、')
}
function isTaskChosen(id: string): boolean {
  return chosen.value.length === 0 || chosen.value.includes(id)
}
function toggleTask(id: string): void {
  const options = team.value?.myTaskOptions ?? []
  const base = chosen.value.length === 0 ? options.map(task => task.id) : chosen.value
  chosen.value = base.includes(id) ? base.filter(item => item !== id) : [...base, id]
}

onShow(() => { if (!busy.value) load() })

async function load(): Promise<void> {
  if (loading.value) return
  loading.value = true
  loadFailed.value = false
  try {
    team.value = await loadMyCoop()
    chosen.value = []
    if (team.value == null) friends.value = await loadInviteFriends()
  } catch (_) { loadFailed.value = true }
  finally { loading.value = false }
}

async function invite(code: string, routeId: string, seat: string, activities: string[]): Promise<void> {
  if (busy.value) return
  busy.value = true
  try {
    const result = await startCoop(code, routeId, seat, activities)
    team.value = await loadCoop(result.id)
  } catch (_) {
    team.value = await loadMyCoop().catch(() => null)
    if (team.value == null) showError()
  }
  finally { busy.value = false }
}

function explore(): void {
  const value = team.value
  if (value != null && value.myRunId != null) openRouteDetail(value.routeId, value.myRunId)
}

async function settle(): Promise<void> {
  const id = team.value?.id
  if (busy.value || id == null) return
  busy.value = true
  try {
    await secured<UTSJSONObject>('settleCoop', { teamId: id })
    team.value = await loadCoop(id)
  } catch (error) {
    if ((error as Error).message === 'NOT_READY') uni.showToast({ title: '双方完成席位任务后可结算', icon: 'none' })
    else showError()
  } finally { busy.value = false }
}
async function answer(accept: boolean): Promise<void> {
  const id = team.value?.id
  if (busy.value || id == null || !canAnswer.value) return
  busy.value = true
  try {
    const options = team.value?.myTaskOptions ?? []
    const tasks = !accept ? [] : (chosen.value.length === 0 ? options.map(task => task.id) : chosen.value)
    await answerCoop(id, accept, tasks)
    await load()
  } catch (_) { showError() }
  finally { busy.value = false }
}
</script>

<style scoped>
@import '@/styles/page.css';
.selected { background: #e2eddb; color: #304d2d; box-shadow: inset 0 0 0 2px #52704a; }
</style>
