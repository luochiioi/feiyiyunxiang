<template>
  <view class="screen">
    <AppPageHeader title="路线查看" :show-back="true" />
    <view class="content">
      <DemoNotice />

      <text class="title">海丝瓷绣</text>
      <text class="body">选择一条本地路线，探索澳门或湖南的故事。</text>
      <view v-for="item in routes" :key="item.id" class="card" @click="showRoute(item.id)">
        <image class="cover" src="/packages/routes/static/silk-cover.jpg" mode="aspectFill" />
        <view class="row spread"><text class="heading">{{ item.name }}</text><text class="tag">{{ item.region }}</text></view>
        <text class="body">{{ item.description.split('\n\n')[0] }}</text>
        <text class="muted">{{ item.id === mapState.routeId ? '当前路线 · ' : '' }}{{ item.total }} 项探索任务</text>
        <view class="row route-actions">
          <button class="secondary" @click.stop="showRoute(item.id)">路线详情</button>
          <button :id="'route-map-' + item.id" class="primary" @click.stop="showOnMap(item.id)">在地图查看</button>
        </view>
      </view>
      <view v-if="routes.length === 0" class="card"><text class="body">{{ catalogError ? '路线暂未加载成功，请重试。云端部署及内容发布仍待联调。' : '暂无已发布路线。' }}</text><button class="secondary" @click="refreshCatalog">重新加载</button></view>
      <button v-if="mapState.routeId != null" class="secondary" @click="clearRoute">清除当前路线</button>
    </view>
  </view>
</template>

<script setup lang="uts">
import AppPageHeader from '@/components/AppPageHeader.uvue'
import DemoNotice from '@/components/DemoNotice.uvue'

import { findRoute, listRoutes, refreshCatalog, catalogError } from '@/features/exploration/catalog.uts'
import { computed } from 'vue'
import { dispatchMapEvent, mapState } from '@/features/exploration/map-store.uts'
import { openPage, returnToMap } from '@/features/navigation.uts'
const routes = computed(() => listRoutes())
onShow(() => { refreshCatalog() })
function showRoute(id: string): void {
  openPage('/packages/routes/route-detail/route-detail?routeId=' + encodeURIComponent(id))
}
function showOnMap(id: string): void {
  const item = findRoute(id)
  if (item == null) return
  dispatchMapEvent({ type: 'select-route', routeId: item.id, viewport: item.viewport })
  returnToMap()
}
function clearRoute(): void {
  dispatchMapEvent({ type: 'clear-route' })
  returnToMap()
}
</script>

<style scoped>
@import '@/styles/page.css';
.route-actions { gap: 8px; }
.route-actions button { flex: 1; }

</style>
