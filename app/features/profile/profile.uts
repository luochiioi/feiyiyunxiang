import { computed, ref, watch } from 'vue'
import { api, login, requestId, session } from '@/features/api.uts'

export type ProfileRevision = {
  revisionId: string, status: string, nickname: string, bio: string, displayCity: string, interests: string[],
  hasAvatar: boolean, avatar?: string, reason: string, createdAt: number, baseRevision: number
}
export type MyProfile = {
  code: string, nickname: string, avatarVersion: string, avatar?: string, bio: string, displayCity: string,
  interests: string[], revision: number, pending: ProfileRevision | null, latest?: ProfileRevision | null
}
export type ProfileReceipt = { revisionId: string, status: string }
export const profileEditPath = '/packages/profile/profile-edit/profile-edit'
export const profileInterests = ['湘绣', '瓷器', '传统建筑', '非遗美食', '博物馆', '摄影']
const loaded = ref<MyProfile | null>(null)
const confirmedPending = ref<ProfileRevision | null>(null)
const owner = ref('')
let sequence = 0, accountEpoch = 0
let uncertain = '', uncertainPayload = ''
export const myProfile = computed(() => owner.value === session.value?.uid ? loaded.value : null)
export const myPendingProfile = computed(() => owner.value === session.value?.uid
  ? confirmedPending.value ?? loaded.value?.pending ?? null : null)

export function rememberPendingProfile(uid: string, revision: ProfileRevision): void {
  if (owner.value !== uid || session.value?.uid !== uid) return
  sequence++
  confirmedPending.value = revision
}

export function forgetMyProfile(): void {
  owner.value = ''
  loaded.value = null
  confirmedPending.value = null
  uncertain = ''; uncertainPayload = ''
  sequence++; accountEpoch++
}

function bindAccount(): void {
  const uid = session.value?.uid
  if (uid == null) { sequence++; return }
  if (owner.value !== uid) { forgetMyProfile(); owner.value = uid }
}
watch(() => session.value?.uid, bindAccount, { flush: 'sync' })
bindAccount()

export async function profileRequest<T>(uid: string, action: string, payload: UTSJSONObject = {}): Promise<T> {
  if (session.value?.uid !== uid) throw new Error('ACCOUNT_CHANGED')
  const epoch = accountEpoch
  if ((session.value?.expiresAt ?? 0) <= Date.now()) await login()
  if (session.value?.uid !== uid || epoch !== accountEpoch) throw new Error('ACCOUNT_CHANGED')
  try { return await api<T>(action, payload) }
  catch (error) {
    if ((error as Error).message !== 'AUTH_REQUIRED') throw error
    await login()
    if (session.value?.uid !== uid || epoch !== accountEpoch) throw new Error('ACCOUNT_CHANGED')
    return await api<T>(action, payload)
  }
}

export async function refreshMyProfile(): Promise<void> {
  const uid = session.value?.uid
  if (uid == null) return
  const ticket = ++sequence, epoch = accountEpoch
  const value = await profileRequest<MyProfile>(uid, 'getMyProfile')
  if (ticket === sequence && epoch === accountEpoch && uid === session.value?.uid) {
    loaded.value = value
    confirmedPending.value = null
  }
}

export async function submitMyProfile(input: UTSJSONObject): Promise<ProfileReceipt> {
  const uid = session.value?.uid
  if (uid == null) throw new Error('AUTH_REQUIRED')
  const epoch = accountEpoch
  const signature = JSON.stringify(input)
  if (uncertain.length === 0 || uncertainPayload !== signature) {
    uncertain = requestId()
    uncertainPayload = signature
  }
  const id = uncertain
  const receipt = await profileRequest<ProfileReceipt>(uid, 'profileSubmit', { ...input, requestId: id })
  if (epoch === accountEpoch && uncertain === id) { uncertain = ''; uncertainPayload = '' }
  return receipt
}

export function profileError(error: any, phase: string = 'read'): string {
  switch ((error as Error).message) {
    case 'INVALID_NICKNAME': return '昵称须为 2–20 字，且不能包含控制字符。'
    case 'INVALID_BIO': return '简介最多 80 字，且不能包含控制字符。'
    case 'INVALID_CITY': return '城市标签最多 20 字，且不能包含控制字符。'
    case 'INVALID_INTERESTS': return '最多选择 3 项文化兴趣。'
    case 'INVALID_IMAGE': return '请选择 JPG 或 PNG，压缩后须在 1 MiB 以内。'
    case 'UPLOAD_NOT_AVAILABLE': return '头像暂存已过期，请重新上传。'
    case 'MEDIA_UPLOAD_FAILED': return '头像上传失败，草稿已保留，可重试。'
    case 'PROFILE_STORAGE_UNAVAILABLE': return '资料存储暂未配置完成，草稿已保留。请联系维护人员。'
    case 'CONFIG_REQUIRED': return phase === 'avatar'
      ? '头像服务配置异常，草稿已保留。请联系维护人员。'
      : '资料服务配置异常，请联系维护人员。'
    case 'INVALID_REQUEST': return '提交内容无法识别，草稿已保留。请重新读取资料后重试。'
    case 'REQUEST_CONFLICT': return '本次修改与之前的请求不一致，草稿已保留。请重新读取资料。'
    case 'STALE_VERSION': return '公开资料已更新。请重新读取，再确认草稿。'
    case 'RATE_LIMITED': return '提交太频繁，请稍后重试。'
    case 'ACCOUNT_CHANGED': return '微信账号已切换，请重新打开资料。'
    case 'ACCOUNT_DISABLED': return '账号已停用，请联系运营人员。'
    case 'AUTH_REQUIRED': return '请先微信登录。'
    case 'NOT_FOUND': return '这份资料暂时无法查看。'
    default:
      if (phase === 'avatar') return '头像上传未收到确认，草稿已保留。可重试，或使用默认澳喵后提交。'
      if (phase === 'submit') return '提交审核未收到确认，草稿已保留。可重试同一次提交。'
      return '暂时无法读取资料，请重试。'
  }
}
