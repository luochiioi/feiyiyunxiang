<template>
  <view class="screen">
    <AppPageHeader title="剧情" :show-back="true" />
    <view class="content">
      <view class="card green">
        <text class="title">海丝瓷绣·一念归期</text>
        <text class="body">从海丝地图出发，沿澳门的蓝白瓷砖或湖南的湘绣继续故事。</text>
        <button class="primary" @click="openOpening">{{ openingStarted ? '继续开场预览' : '阅读开场预览' }}</button>
      </view>
      <view class="card">
        <text class="heading">章节目录</text>
        <view v-for="(chapter, index) in chapters" :key="chapter.title" class="row spread divider menu-row" @click="openChapter(index + 1)">
          <view class="stack">
            <text class="body">{{ '第 ' + (index + 1) + ' 幕 · ' + (chapterFor(index + 1)?.title ?? chapter.title) }}</text>
            <text v-if="index > 0 && chapterFor(index + 1)?.unlocked !== true" class="muted">{{ chapterFor(index + 1)?.gateText ?? chapter.gate }}</text>
          </view>
          <text class="muted">{{ chapterLabel(index + 1) }}</text>
        </view>
        <text v-if="message.length > 0" class="muted">{{ message }}</text>
        <button v-if="loadFailed" class="secondary" @click="load">重新读取解锁进度</button>
      </view>
      <button class="primary" @click="openPage('/packages/routes/routes/routes')">查看两地路线</button>
    </view>
  </view>
</template>

<script setup lang="uts">
import AppPageHeader from '@/components/AppPageHeader.uvue'
import { ref } from 'vue'
import { secured, session } from '@/features/api.uts'
import { decodePageId, openPage } from '@/features/navigation.uts'
import { legacyStorm, localStoryPath, savedOpeningPath } from '../story-content.uts'
import { readLegacyStorm } from '../legacy-story.uts'
type Entry = { act: number, title: string, runId: string, routeId: string, unlocked: boolean, started: boolean, gateText?: string, local?: boolean }
const entries = ref<Entry[]>([])
const openingStarted = ref(false)
const loadFailed = ref(false)
const olderService = ref(false)
const message = ref('')
let loading = false
let preferredRoute = ''
const chapters = [
  { title: '触碰海丝地图', gate: '' },
  { title: '海上风暴', gate: '澳门 · 完成路线内任一地点打卡' },
  { title: '女儿与瓷砖', gate: '澳门 · 保存瓷砖配色作品' },
  { title: '澳门靠岸', gate: '澳门 · 答对瓷砖纹样辨认题' },
  { title: '湘绣相遇', gate: '湖南 · 完成湘绣辨认' },
  { title: '针法学习', gate: '湖南 · 学完四张知识卡' }
]
onLoad(query => { preferredRoute = decodePageId(query['routeId'] ?? null) ?? '' })
onShow(() => {
  openingStarted.value = savedOpeningPath().length > 1
  load()
})
async function load(): Promise<void> {
  if (loading) return
  loadFailed.value = false
  olderService.value = false
  message.value = ''
  if (session.value == null) { entries.value = []; return }
  loading = true
  const uid = session.value!.uid
  try {
    let library: Entry[] = []
    let missing = false
    try {
      library = await secured<Entry[]>('storyLibrary')
    } catch (error) {
      if ((error as Error).message !== 'NOT_FOUND') throw error
      missing = true
    }
    if (session.value?.uid !== uid) throw new Error('AUTH_REQUIRED')
    if (missing || !library.some(item => item.act === 2 && (preferredRoute.length === 0 || item.routeId === preferredRoute))) {
      try {
        const local = await readLegacyStorm(preferredRoute, '')
        if (local != null && !library.some(item => item.routeId === local.routeId)) {
          library.push({ act: 2, title: legacyStorm.title, routeId: local.routeId, runId: local.runId,
            unlocked: local.unlocked, started: localStoryPath(local.storageKey, legacyStorm).length > 1,
            gateText: '澳门 · 完成本路线任一地点打卡', local: true })
        }
      } catch (error) {
        if (missing) throw error
      }
    }
    if (session.value?.uid !== uid) throw new Error('AUTH_REQUIRED')
    entries.value = library
    olderService.value = missing
    if (missing) {
      message.value = library.length > 0
        ? '当前测试路线的第二幕可按已有打卡进度阅读，其余章节待剧情服务接入。'
        : '当前开发环境尚未接入剧情服务。可从已打卡的澳门测试路线查看第二幕。'
    } else if (library.every(item => item.local === true)) {
      message.value = library.length > 0
        ? '当前探索版本只包含第二幕。其他章节需从已发布文化任务的路线开始。'
        : '当前账号暂无已接入剧情的探索。可在路线详情查看文化任务。'
    }
  } catch (error) {
    entries.value = []
    loadFailed.value = true
    message.value = (error as Error).message === 'AUTH_REQUIRED' || session.value == null
      ? '请在「我的」重新登录后读取解锁进度。' : '暂时无法读取路线打卡进度，请重试。'
  } finally { loading = false }
}
function chapterFor(act: number): Entry | null {
  const candidates = entries.value.filter(entry => entry.act === act)
  return candidates.find(entry => entry.routeId === preferredRoute) ??
    candidates.find(entry => entry.unlocked) ?? candidates[0] ?? null
}
function chapterLabel(act: number): string {
  if (act === 1) return '游客可读 ›'
  const entry = chapterFor(act)
  if (entry?.unlocked === true) return entry.started ? '继续阅读 ›' : '阅读 ›'
  if (loadFailed.value) return '待重试'
  if (entry != null) return '随路线解锁'
  if (session.value == null) return '登录后查看'
  return olderService.value ? '待接入' : '当前探索暂无'
}
function openOpening(): void { openPage('/packages/story/reader/reader?act=1') }
function openChapter(act: number): void {
  if (act === 1) { openOpening(); return }
  const entry = chapterFor(act)
  if (entry?.unlocked === true) {
    openPage('/packages/story/reader/reader?act=' + act + '&runId=' + encodeURIComponent(entry.runId) + (entry.local === true ? '&legacy=1' : ''))
  }
}
</script>

<style scoped>
@import '@/styles/page.css';

</style>
